@section Scripts {

    <script>

        // =====================================================
        // DATATABLE
        // =====================================================

        let purchaseTable;


        $(document).ready(function () {

            purchaseTable =
                $('#purchaseReportTable').DataTable({

                    pageLength: 25,

                    lengthMenu: [
                        [10, 25, 50, 100, -1],
                        [10, 25, 50, 100, "All"]
                    ],

                    order: [
                        [2, 'desc']
                    ],

                    columnDefs: [

                        {
                            orderable: false,
                            targets: [10]
                        }

                    ],

                    language: {

                        search: "Search:",

                        lengthMenu:
                            "Show _MENU_ records",

                        info:
                            "Showing _START_ to _END_ of _TOTAL_ purchase orders",

                        emptyTable:
                            "No purchase orders found."

                    }

                });

        });


        // =====================================================
        // BEFORE PRINT
        // SHOW ALL DATATABLE RECORDS
        // =====================================================

        window.addEventListener("beforeprint", function () {

            if (purchaseTable) {

                purchaseTable
                    .page
                    .len(-1)
                    .draw(false);

            }

        });


        // =====================================================
        // AFTER PRINT
        // RETURN TO NORMAL PAGINATION
        // =====================================================

        window.addEventListener("afterprint", function () {

            if (purchaseTable) {

                purchaseTable
                    .page
                    .len(25)
                    .draw(false);

            }

        });


        // =====================================================
        // EXCEL EXPORT
        // =====================================================

        function exportExcel() {

            const table =
                document.getElementById(
                    "purchaseReportTable"
                );


            let csv = [];


            const rows =
                table.querySelectorAll("tr");


            rows.forEach(function (row) {

                const columns =
                    row.querySelectorAll(
                        "th, td"
                    );


                const rowData = [];


                columns.forEach(function (column) {

                    let text =
                        column.innerText
                            .replace(/,/g, "")
                            .replace(/\n/g, " ")
                            .trim();


                    rowData.push(
                        '"' + text + '"'
                    );

                });


                csv.push(
                    rowData.join(",")
                );

            });


            const csvFile =
                new Blob(
                    [csv.join("\n")],
                    {
                        type:
                            "text/csv;charset=utf-8;"
                    }
                );


            const downloadLink =
                document.createElement("a");


            downloadLink.href =
                URL.createObjectURL(csvFile);


            downloadLink.download =
                "Purchase_Report.csv";


            document.body.appendChild(
                downloadLink
            );


            downloadLink.click();


            document.body.removeChild(
                downloadLink
            );

        }

    </script>

}

