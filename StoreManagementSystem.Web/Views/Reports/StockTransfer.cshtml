
@model StoreManagementSystem.Web.ViewModels.Reports.StockTransferReportViewModel

@{
    ViewData["Title"] = "Stock Transfer Report";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4 stock-transfer-report">

    <!-- PRINT REPORT HEADER -->
    <div class="print-report-header">

        @if (!string.IsNullOrWhiteSpace(Model.OrganisationName))
        {
            <h2 class="print-organisation-name">@Model.OrganisationName</h2>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Branch))
        {
            <div class="print-branch">@Model.Branch</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div class="print-address">@Model.Address</div>
        }

        <div class="print-contact">
            @if (!string.IsNullOrWhiteSpace(Model.Phone))
            {
                <span>Phone: @Model.Phone</span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <span>Email: @Model.Email</span>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
        {
            <div class="print-gstin">GSTIN: @Model.GSTIN</div>
        }

        <hr />

        <h3 class="print-report-heading">
            @(string.IsNullOrWhiteSpace(Model.ReportHeading)
                ? "Stock Transfer Report"
                : Model.ReportHeading)
        </h3>

        <div class="print-date-range">
            <strong>
                @(string.IsNullOrWhiteSpace(Model.FromDateLabel)
                    ? "From Date"
                    : Model.FromDateLabel):
            </strong>
            @Model.FromDate.ToString("dd-MMM-yyyy")

            &nbsp;&nbsp;&nbsp;

            <strong>
                @(string.IsNullOrWhiteSpace(Model.ToDateLabel)
                    ? "To Date"
                    : Model.ToDateLabel):
            </strong>
            @Model.ToDate.ToString("dd-MMM-yyyy")
        </div>
    </div>

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4 no-print">
        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-arrow-left-right me-2"></i>
                Stock Transfer Report
            </h3>
            <p class="text-muted mb-0">
                View inward and outward stock transfers
            </p>
        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4 no-print">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Total Transfers</div>
                            <h4 class="fw-bold mb-0">@Model.TotalTransfers</h4>
                        </div>
                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-arrow-left-right text-primary fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Outward Quantity</div>
                            <h4 class="fw-bold mb-0">
                                @Model.TotalOutwardQuantity.ToString("N2")
                            </h4>
                        </div>
                        <div class="bg-danger bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-box-arrow-right text-danger fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Inward Quantity</div>
                            <h4 class="fw-bold mb-0">
                                @Model.TotalInwardQuantity.ToString("N2")
                            </h4>
                        </div>
                        <div class="bg-success bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-box-arrow-in-left text-success fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Transfer Value</div>
                            <h4 class="fw-bold mb-0">
                                ₹@Model.TotalTransferValue.ToString("N2")
                            </h4>
                        </div>
                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                            <i class="bi bi-currency-rupee text-warning fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- FILTER -->
    <div class="card border-0 shadow-sm mb-4 no-print">
        <div class="card-header bg-white border-0 py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-funnel me-2"></i>
                Filter
            </h5>
        </div>

        <div class="card-body">
            <form method="get"
                  asp-controller="Reports"
                  asp-action="StockTransfer">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.FromDateLabel)
                                ? "From Date"
                                : Model.FromDateLabel)
                        </label>

                        <input type="date"
                               name="fromDate"
                               class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            @(string.IsNullOrWhiteSpace(Model.ToDateLabel)
                                ? "To Date"
                                : Model.ToDateLabel)
                        </label>

                        <input type="date"
                               name="toDate"
                               class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="col-md-4">
                        <div class="d-flex gap-2 flex-wrap">

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-search me-1"></i>
                                Apply Filter
                            </button>

                            <a asp-controller="Reports"
                               asp-action="StockTransfer"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-clockwise me-1"></i>
                                Reset
                            </a>

                            <button type="button"
                                    id="printStockTransferButton"
                                    class="btn btn-dark">
                                <i class="bi bi-printer me-1"></i>
                                Print / PDF
                            </button>

                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- DATE RANGE -->
    <div class="alert alert-light border shadow-sm mb-4 py-2 no-print">
        <div class="d-flex align-items-center">
            <i class="bi bi-calendar3 me-2 text-primary"></i>
            <span>
                Showing stock transfers from
                <strong>@Model.FromDate.ToString("dd-MMM-yyyy")</strong>
                to
                <strong>@Model.ToDate.ToString("dd-MMM-yyyy")</strong>
            </span>
        </div>
    </div>

    <!-- TRANSFER TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3 no-print">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-semibold">
                    <i class="bi bi-list-ul me-2"></i>
                    Transfer Details
                </h5>

                <span class="badge bg-secondary">
                    @(Model.Transfers?.Count ?? 0) Records
                </span>
            </div>
        </div>

        <div class="card-body p-0">

            @if (Model.Transfers != null && Model.Transfers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="text-center">#</th>
                                <th>Transfer No.</th>
                                <th>Type</th>
                                <th>Date &amp; Time</th>
                                <th>Product</th>
                                <th>Main Category</th>
                                <th>Category</th>
                                <th>Subcategory</th>
                                <th>From Warehouse</th>
                                <th>To Warehouse</th>
                                <th class="text-end">Quantity</th>
                                <th class="text-end">Unit Cost</th>
                                <th class="text-end">Total Value</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var index = 1;
                            }

                            @foreach (var item in Model.Transfers)
                            {
                                <tr>
                                    <td class="text-center">@index</td>

                                    <td>
                                        <span class="fw-semibold">@item.TransferNo</span>
                                    </td>

                                    <td>
                                        @if (item.TransferType == "Outward")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">
                                                <i class="bi bi-box-arrow-right me-1"></i>
                                                Outward
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">
                                                <i class="bi bi-box-arrow-in-left me-1"></i>
                                                Inward
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @item.TransferDate.ToString("dd-MMM-yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @item.TransferDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">@item.ProductName</span>
                                    </td>

                                    <td>@item.MainCategoryName</td>
                                    <td>@item.CategoryName</td>
                                    <td>@item.SubcategoryName</td>

                                    <td>
                                        <span class="text-danger">
                                            <i class="bi bi-box-arrow-right me-1"></i>
                                            @item.FromWarehouseName
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-success">
                                            <i class="bi bi-box-arrow-in-left me-1"></i>
                                            @item.ToWarehouseName
                                        </span>
                                    </td>

                                    <td class="text-end fw-semibold">
                                        @item.Quantity.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        ₹@item.UnitCost.ToString("N2")
                                    </td>

                                    <td class="text-end fw-semibold">
                                        ₹@item.TotalValue.ToString("N2")
                                    </td>
                                </tr>

                                index++;
                            }
                        </tbody>

                        <!-- TOTAL ROW: RAZOR EXPRESSION FIXED -->
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="10" class="text-end">Total</th>

                                <th class="text-end">
                                    @Model.Transfers.Sum(x => x.Quantity).ToString("N2")
                                </th>

                                <th></th>

                                <th class="text-end">
                                    ₹@Model.TotalTransferValue.ToString("N2")
                                </th>
                            </tr>
                        </tfoot>

                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 no-print">
                    <div class="mb-3">
                        <i class="bi bi-arrow-left-right display-4 text-muted"></i>
                    </div>

                    <h5 class="fw-semibold">No Stock Transfers Found</h5>

                    <p class="text-muted mb-0">
                        There are no inward or outward stock transfers
                        for the selected date range.
                    </p>
                </div>
            }

        </div>
    </div>

    <!-- AUTHORISED SIGNATORY -->
    @if (!string.IsNullOrWhiteSpace(Model.AuthorisedSignatory))
    {
        <div class="print-signatory">
            <div class="signatory-line">______________________________</div>
            <div class="signatory-name">@Model.AuthorisedSignatory</div>

            @if (!string.IsNullOrWhiteSpace(Model.AuthorisedDesignation))
            {
                <div class="signatory-designation">
                    @Model.AuthorisedDesignation
                </div>
            }
        </div>
    }

</div>

<!-- CSP-FRIENDLY PRINT SCRIPT: NO INLINE JAVASCRIPT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const printButton = document.getElementById("printStockTransferButton");

        if (printButton) {
            printButton.addEventListener("click", function () {
                window.print();
            });
        }
    });
</script>

<!-- PRINT CSS -->
<style>
    .stock-transfer-report .print-report-header {
        display: none;
        text-align: center;
        margin-bottom: 20px;
    }

    .stock-transfer-report .print-organisation-name {
        margin: 0;
        font-weight: 700;
        font-size: 24px;
    }

    .stock-transfer-report .print-branch {
        font-size: 15px;
        font-weight: 600;
        margin-top: 3px;
    }

    .stock-transfer-report .print-address {
        font-size: 13px;
        margin-top: 3px;
    }

    .stock-transfer-report .print-contact {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px;
        font-size: 12px;
        margin-top: 4px;
    }

    .stock-transfer-report .print-gstin {
        font-size: 12px;
        margin-top: 3px;
    }

    .stock-transfer-report .print-report-heading {
        margin: 10px 0 5px;
        font-size: 19px;
        font-weight: 700;
    }

    .stock-transfer-report .print-date-range {
        font-size: 12px;
        margin-top: 5px;
    }

    .stock-transfer-report .print-signatory {
        display: none;
        width: 220px;
        margin-left: auto;
        margin-top: 50px;
        text-align: center;
    }

    .stock-transfer-report .signatory-line {
        margin-bottom: 5px;
    }

    .stock-transfer-report .signatory-name {
        font-weight: 700;
    }

    .stock-transfer-report .signatory-designation {
        font-size: 12px;
        margin-top: 2px;
    }

    @@media print {
        @@page {
            size: landscape;
            margin: 10mm;
        }

        body {
            background: #fff !important;
        }

        .no-print {
            display: none !important;
        }

        .print-report-header {
            display: block !important;
        }

        .print-signatory {
            display: block !important;
        }

        .container-fluid.stock-transfer-report {
            width: 100% !important;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .stock-transfer-report .card {
            border: none !important;
            box-shadow: none !important;
        }

        .stock-transfer-report .card-body {
            padding: 0 !important;
        }

        .stock-transfer-report .table-responsive {
            overflow: visible !important;
        }

        .stock-transfer-report table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 9px !important;
        }

        .stock-transfer-report table th,
        .stock-transfer-report table td {
            border: 1px solid #000 !important;
            padding: 4px !important;
            color: #000 !important;
            background: #fff !important;
        }

        .stock-transfer-report thead {
            display: table-header-group;
        }

        .stock-transfer-report tfoot {
            display: table-row-group;
        }

        .stock-transfer-report tr {
            break-inside: avoid;
            page-break-inside: avoid;
        }

        .stock-transfer-report .badge {
            border: none !important;
            background: transparent !important;
            color: #000 !important;
            padding: 0 !important;
        }

        .stock-transfer-report .text-danger,
        .stock-transfer-report .text-success,
        .stock-transfer-report .text-primary,
        .stock-transfer-report .text-warning,
        .stock-transfer-report .text-muted {
            color: #000 !important;
        }

        .stock-transfer-report .bi {
            display: none !important;
        }
    }
</style>
