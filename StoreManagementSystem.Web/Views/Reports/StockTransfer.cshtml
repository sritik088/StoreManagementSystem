@model StoreManagementSystem.Web.ViewModels.Reports.StockTransferReportViewModel

@{
    ViewData["Title"] = "Stock Transfer Report";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- ===================================================== -->
    <!-- PRINT REPORT HEADER -->
    <!-- ===================================================== -->

    <div class="print-report-header">

        @if (!string.IsNullOrWhiteSpace(Model.OrganisationName))
        {
            <h2 class="print-organisation-name">
                @Model.OrganisationName
            </h2>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Branch))
        {
            <div class="print-branch">
                @Model.Branch
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div class="print-address">
                @Model.Address
            </div>
        }

        <div class="print-contact">

            @if (!string.IsNullOrWhiteSpace(Model.Phone))
            {
                <span>
                    Phone: @Model.Phone
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <span>
                    Email: @Model.Email
                </span>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
        {
            <div class="print-gstin">
                GSTIN: @Model.GSTIN
            </div>
        }

        <hr />

        <h3 class="print-report-heading">
            @(string.IsNullOrWhiteSpace(Model.ReportHeading)
                        ? "Stock Transfer Report"
                        : Model.ReportHeading)
        </h3>

        <div class="print-date-range">

            <strong>
                @(string.IsNullOrWhiteSpace(Model.FromDateLabel)
                                ? "From Date"
                                : Model.FromDateLabel):
            </strong>

            @Model.FromDate.ToString("dd-MMM-yyyy")

            &nbsp;&nbsp;&nbsp;

            <strong>
                @(string.IsNullOrWhiteSpace(Model.ToDateLabel)
                                ? "To Date"
                                : Model.ToDateLabel):
            </strong>

            @Model.ToDate.ToString("dd-MMM-yyyy")

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- PAGE HEADER -->
    <!-- ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>

            <h3 class="fw-bold mb-1">

                <i class="bi bi-arrow-left-right me-2"></i>

                Stock Transfer Report

            </h3>

            <p class="text-muted mb-0">
                View inward and outward stock transfers
            </p>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ===================================================== -->

    <div class="row g-3 mb-4 no-print">

        <!-- Total Transfers -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Total Transfers
                            </div>

                            <h4 class="fw-bold mb-0">
                                @Model.TotalTransfers
                            </h4>

                        </div>

                        <div class="bg-primary bg-opacity-10 rounded-circle p-3">

                            <i class="bi bi-arrow-left-right text-primary fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Outward -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Outward Quantity
                            </div>

                            <h4 class="fw-bold mb-0">
                                @Model.TotalOutwardQuantity.ToString("N2")
                            </h4>

                        </div>

                        <div class="bg-danger bg-opacity-10 rounded-circle p-3">

                            <i class="bi bi-box-arrow-right text-danger fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Inward -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Inward Quantity
                            </div>

                            <h4 class="fw-bold mb-0">
                                @Model.TotalInwardQuantity.ToString("N2")
                            </h4>

                        </div>

                        <div class="bg-success bg-opacity-10 rounded-circle p-3">

                            <i class="bi bi-box-arrow-in-left text-success fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Transfer Value -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <div class="text-muted small">
                                Transfer Value
                            </div>

                            <h4 class="fw-bold mb-0">
                                ₹@Model.TotalTransferValue.ToString("N2")
                            </h4>

                        </div>

                        <div class="bg-warning bg-opacity-10 rounded-circle p-3">

                            <i class="bi bi-currency-rupee text-warning fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- FILTER -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm mb-4 no-print">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="mb-0 fw-semibold">

                <i class="bi bi-funnel me-2"></i>

                Filter

            </h5>

        </div>


        <div class="card-body">

            <form method="get"
                  asp-controller="Reports"
                  asp-action="StockTransfer">

                <div class="row g-3 align-items-end">

                    <!-- From Date -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            @(string.IsNullOrWhiteSpace(Model.FromDateLabel)
                                                        ? "From Date"
                                                        : Model.FromDateLabel)

                        </label>

                        <input type="date"
                               name="fromDate"
                               class="form-control"
                               value="@Model.FromDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- To Date -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">

                            @(string.IsNullOrWhiteSpace(Model.ToDateLabel)
                                                        ? "To Date"
                                                        : Model.ToDateLabel)

                        </label>

                        <input type="date"
                               name="toDate"
                               class="form-control"
                               value="@Model.ToDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <!-- Buttons -->
                    <div class="col-md-4">

                        <div class="d-flex gap-2 flex-wrap">

                            <!-- Apply Filter -->
                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-search me-1"></i>

                                Apply Filter

                            </button>


                            <!-- Reset -->
                            <a asp-controller="Reports"
                               asp-action="StockTransfer"
                               class="btn btn-outline-secondary">

                                <i class="bi bi-arrow-clockwise me-1"></i>

                                Reset

                            </a>


                            <!-- Print / PDF -->
                            <button type="button"
                                    class="btn btn-dark"
                                    onclick="window.print()">

                                <i class="bi bi-printer me-1"></i>

                                Print / PDF

                            </button>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- DATE RANGE -->
    <!-- ===================================================== -->

    <div class="alert alert-light border shadow-sm mb-4 py-2 no-print">

        <div class="d-flex align-items-center">

            <i class="bi bi-calendar3 me-2 text-primary"></i>

            <span>

                Showing stock transfers from

                <strong>
                    @Model.FromDate.ToString("dd-MMM-yyyy")
                </strong>

                to

                <strong>
                    @Model.ToDate.ToString("dd-MMM-yyyy")
                </strong>

            </span>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- TRANSFER TABLE -->
    <!-- ===================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3 no-print">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-semibold">

                    <i class="bi bi-list-ul me-2"></i>

                    Transfer Details

                </h5>

                <span class="badge bg-secondary">

                    @Model.Transfers.Count Records

                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Transfers != null && Model.Transfers.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">

                            <tr>

                                <th class="text-center">
                                    #
                                </th>

                                <th>
                                    Transfer No.
                                </th>

                                <th>
                                    Type
                                </th>

                                <th>
                                    Date & Time
                                </th>

                                <th>
                                    Product
                                </th>

                                <th>
                                    Main Category
                                </th>

                                <th>
                                    Category
                                </th>

                                <th>
                                    Subcategory
                                </th>

                                <th>
                                    From Warehouse
                                </th>

                                <th>
                                    To Warehouse
                                </th>

                                <th class="text-end">
                                    Quantity
                                </th>

                                <th class="text-end">
                                    Unit Cost
                                </th>

                                <th class="text-end">
                                    Total Value
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var index = 1;
                            }

                            @foreach (var item in Model.Transfers)
                            {
                                <tr>

                                    <!-- # -->
                                    <td class="text-center">
                                        @index
                                    </td>


                                    <!-- Transfer No -->
                                    <td>

                                        <span class="fw-semibold">
                                            @item.TransferNo
                                        </span>

                                    </td>


                                    <!-- Type -->
                                    <td>

                                        @if (item.TransferType == "Outward")
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-2">

                                                <i class="bi bi-box-arrow-right me-1"></i>

                                                Outward

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">

                                                <i class="bi bi-box-arrow-in-left me-1"></i>

                                                Inward

                                            </span>
                                        }

                                    </td>


                                    <!-- Date & Time -->
                                    <td>

                                        <div class="fw-semibold">
                                            @item.TransferDate.ToString("dd-MMM-yyyy")
                                        </div>

                                        <small class="text-muted">
                                            @item.TransferDate.ToString("hh:mm tt")
                                        </small>

                                    </td>


                                    <!-- Product -->
                                    <td>

                                        <span class="fw-semibold">
                                            @item.ProductName
                                        </span>

                                    </td>


                                    <!-- Main Category -->
                                    <td>
                                        @item.MainCategoryName
                                    </td>


                                    <!-- Category -->
                                    <td>
                                        @item.CategoryName
                                    </td>


                                    <!-- Subcategory -->
                                    <td>
                                        @item.SubcategoryName
                                    </td>


                                    <!-- From Warehouse -->
                                    <td>

                                        <span class="text-danger">

                                            <i class="bi bi-box-arrow-right me-1"></i>

                                            @item.FromWarehouseName

                                        </span>

                                    </td>


                                    <!-- To Warehouse -->
                                    <td>

                                        <span class="text-success">

                                            <i class="bi bi-box-arrow-in-left me-1"></i>

                                            @item.ToWarehouseName

                                        </span>

                                    </td>


                                    <!-- Quantity -->
                                    <td class="text-end fw-semibold">

                                        @item.Quantity.ToString("N2")

                                    </td>


                                    <!-- Unit Cost -->
                                    <td class="text-end">

                                        ₹@item.UnitCost.ToString("N2")

                                    </td>


                                    <!-- Total Value -->
                                    <td class="text-end fw-semibold">

                                        ₹@item.TotalValue.ToString("N2")

                                    </td>

                                </tr>

                                index++;
                            }

                        </tbody>


                        <!-- ================================================= -->
                        <!-- TOTAL -->
                        <!-- ================================================= -->

                        <tfoot class="table-light">

                            <tr>

                                <th colspan="10" class="text-end">
                                    Total
                                </th>

                                <th class="text-end">

                                    @Model.Transfers
                                    .Sum(x => x.Quantity)
                                    .ToString("N2")

                                </th>

                                <th></th>

                                <th class="text-end">

                                    ₹@Model.TotalTransferValue.ToString("N2")

                                </th>

                            </tr>

                        </tfoot>

                    </table>

                </div>
            }
            else
            {
                <!-- EMPTY STATE -->

                <div class="text-center py-5 no-print">

                    <div class="mb-3">

                        <i class="bi bi-arrow-left-right display-4 text-muted"></i>

                    </div>

                    <h5 class="fw-semibold">
                        No Stock Transfers Found
                    </h5>

                    <p class="text-muted mb-0">

                        There are no inward or outward stock transfers
                        for the selected date range.

                    </p>

                </div>
            }

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- AUTHORISED SIGNATORY -->
    <!-- ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.AuthorisedSignatory))
    {
        <div class="print-signatory">

            <div class="signatory-line">
                ______________________________
            </div>

            <div class="signatory-name">
                @Model.AuthorisedSignatory
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.AuthorisedDesignation))
            {
                <div class="signatory-designation">
                    @Model.AuthorisedDesignation
                </div>
            }

        </div>
    }

</div>


<!-- ========================================================= -->
<!-- PRINT CSS -->
<!-- ========================================================= -->

<style>

    .print-report-header {
        display: none;
        text-align: center;
        margin-bottom: 20px;
    }

    .print-organisation-name {
        margin: 0;
        font-weight: 700;
        font-size: 24px;
    }

    .print-branch {
        font-size: 15px;
        font-weight: 600;
        margin-top: 3px;
    }

    .print-address {
        font-size: 13px;
        margin-top: 3px;
    }

    .print-contact {
        display: flex;
        justify-content: center;
        gap: 20px;
        font-size: 12px;
        margin-top: 4px;
    }

    .print-gstin {
        font-size: 12px;
        margin-top: 3px;
    }

    .print-report-heading {
        margin: 10px 0 5px;
        font-size: 19px;
        font-weight: 700;
    }

    .print-date-range {
        font-size: 12px;
        margin-top: 5px;
    }

    .print-signatory {
        display: none;
        width: 220px;
        margin-left: auto;
        margin-top: 50px;
        text-align: center;
    }

    .signatory-line {
        margin-bottom: 5px;
    }

    .signatory-name {
        font-weight: 700;
    }

    .signatory-designation {
        font-size: 12px;
        margin-top: 2px;
    }


    /* ========================================================= */
    /* PRINT */
    /* ========================================================= */

    @@media print {

        @@page {
            size: landscape;
            margin: 10mm;
        }

        body {
            background: white !important;
        }

        .no-print {
            display: none !important;
        }

        .print-report-header {
            display: block !important;
        }

        .print-signatory {
            display: block !important;
        }

        .container-fluid {
            width: 100% !important;
            max-width: none !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .card {
            border: none !important;
            box-shadow: none !important;
        }

        .card-body {
            padding: 0 !important;
        }

        .table-responsive {
            overflow: visible !important;
        }

        table {
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 9px !important;
        }

            table th,
            table td {
                border: 1px solid #000 !important;
                padding: 4px !important;
            }

        thead {
            display: table-header-group;
        }

        tfoot {
            display: table-row-group;
        }

        tr {
            page-break-inside: avoid;
        }

        .badge {
            border: none !important;
            background: transparent !important;
            color: #000 !important;
            padding: 0 !important;
        }

        .text-danger,
        .text-success,
        .text-primary,
        .text-warning {
            color: #000 !important;
        }

        .bi {
            display: none !important;
        }
    }

</style>