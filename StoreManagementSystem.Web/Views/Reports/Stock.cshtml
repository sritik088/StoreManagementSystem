
@model StoreManagementSystem.Web.ViewModels.Reports.StockReportViewModel

@{
    ViewData["Title"] = "Stock Reports";
    Layout = "_AdminLayout";
}

<div class="container-fluid">


    <!-- =====================================================
         PRINT REPORT HEADER
         ===================================================== -->

    <div class="print-report-header">

        @if (!string.IsNullOrWhiteSpace(Model.OrganisationName))
        {
            <h2 class="print-organisation-name">
                @Model.OrganisationName
            </h2>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Branch))
        {
            <div class="print-branch">
                @Model.Branch
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div class="print-address">
                @Model.Address
            </div>
        }

        <div class="print-contact">

            @if (!string.IsNullOrWhiteSpace(Model.Phone))
            {
                <span>
                    Phone: @Model.Phone
                </span>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Email))
            {
                <span>
                    Email: @Model.Email
                </span>
            }

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
        {
            <div class="print-gstin">
                GSTIN: @Model.GSTIN
            </div>
        }

        <hr />

        <h3 class="print-report-heading">
            @(string.IsNullOrWhiteSpace(Model.ReportHeading)
                        ? "Stock Report"
                        : Model.ReportHeading)
        </h3>

    </div>


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-boxes text-primary me-2"></i>

                Stock Reports

            </h2>

            <p class="text-muted mb-0">

                Current inventory, warehouse stock and stock valuation

            </p>

        </div>


        <div class="d-flex gap-2">

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="window.print()">

                <i class="bi bi-printer me-1"></i>

                Print

            </button>


            <a asp-controller="Reports"
               asp-action="Dashboard"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Back

            </a>

        </div>

    </div>


    <!-- =====================================================
         FILTER CARD
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4 no-print">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="bi bi-funnel me-2"></i>

                Stock Report Filters

            </h5>

        </div>


        <div class="card-body">

            <form asp-controller="Reports"
                  asp-action="Stock"
                  method="get">

                <div class="row g-3">


                    <!-- =================================================
                         STOCK STATUS
                         ================================================= -->

                    <div class="col-lg-4 col-md-6">

                        <label class="form-label fw-semibold">

                            Stock Status

                        </label>

                        <select name="stockStatus"
                                class="form-select">

                            <option value="">
                                All Stock
                            </option>

                            <option value="InStock"
                                    selected="@(Model.StockStatus == "InStock")">

                                In Stock

                            </option>

                            <option value="LowStock"
                                    selected="@(Model.StockStatus == "LowStock")">

                                Low Stock

                            </option>

                            <option value="OutOfStock"
                                    selected="@(Model.StockStatus == "OutOfStock")">

                                Out of Stock

                            </option>

                        </select>

                    </div>


                    <!-- =================================================
                         BUTTONS
                         ================================================= -->

                    <div class="col-12">

                        <hr />

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="bi bi-search me-1"></i>

                            Generate Report

                        </button>


                        <a asp-controller="Reports"
                           asp-action="Stock"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-arrow-clockwise me-1"></i>

                            Reset

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =====================================================
         SUMMARY CARDS
         ===================================================== -->

    <div class="row g-3 mb-4 no-print">


        <!-- TOTAL PRODUCTS -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Products
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                @Model.TotalProducts
                            </h3>

                        </div>

                        <div class="text-primary fs-2">

                            <i class="bi bi-box-seam"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL QUANTITY -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Quantity On Hand
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                @Model.TotalQuantity.ToString("N2")
                            </h3>

                        </div>

                        <div class="text-success fs-2">

                            <i class="bi bi-stack"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- STOCK VALUE -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Stock Value
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">
                                ₹@Model.TotalStockValue.ToString("N2")
                            </h3>

                        </div>

                        <div class="text-warning fs-2">

                            <i class="bi bi-currency-rupee"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- LOW / OUT OF STOCK -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Low / Out of Stock
                            </div>

                            <h3 class="fw-bold mt-2 mb-0">

                                @(Model.LowStockProducts +
                                                                Model.OutOfStockProducts)

                            </h3>

                        </div>

                        <div class="text-danger fs-2">

                            <i class="bi bi-exclamation-triangle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         STOCK STATUS SUMMARY
         ===================================================== -->

    <div class="row g-3 mb-4 no-print">


        <div class="col-md-6">

            <div class="alert alert-warning mb-0">

                <div class="d-flex align-items-center">

                    <i class="bi bi-exclamation-circle fs-3 me-3"></i>

                    <div>

                        <strong>
                            Low Stock
                        </strong>

                        <div>

                            @Model.LowStockProducts
                            product(s) need attention.

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-6">

            <div class="alert alert-danger mb-0">

                <div class="d-flex align-items-center">

                    <i class="bi bi-x-circle fs-3 me-3"></i>

                    <div>

                        <strong>
                            Out of Stock
                        </strong>

                        <div>

                            @Model.OutOfStockProducts
                            product(s) have no stock.

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         STOCK TABLE
         ===================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0 fw-bold">

                    <i class="bi bi-table me-2"></i>

                    Stock Details

                </h5>


                <div class="d-flex gap-2 no-print">

                    <button type="button"
                            class="btn btn-sm btn-outline-success"
                            onclick="exportStockExcel()">

                        <i class="bi bi-file-earmark-excel me-1"></i>

                        Excel

                    </button>


                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            onclick="window.print()">

                        <i class="bi bi-file-earmark-pdf me-1"></i>

                        PDF / Print

                    </button>

                </div>

            </div>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="stockReportTable"
                       class="table table-bordered table-hover align-middle w-100">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Product</th>

                            <th>SKU</th>

                            <th>Warehouse</th>

                            <th class="text-end">
                                Opening
                            </th>

                            <th class="text-end">
                                Received
                            </th>

                            <th class="text-end">
                                Sold
                            </th>

                            <th class="text-end">
                                On Hand
                            </th>

                            <th class="text-end">
                                Reorder
                            </th>

                            <th class="text-end">
                                Purchase Price
                            </th>

                            <th class="text-end">
                                Stock Value
                            </th>

                            <th class="text-center">
                                Status
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @if (Model.Stocks != null &&
                                                Model.Stocks.Any())
                        {
                            var index = 1;

                            foreach (var stock in Model.Stocks)
                            {
                                <tr>

                                    <!-- NUMBER -->

                                    <td>
                                        @index
                                    </td>


                                    <!-- PRODUCT -->

                                    <td>

                                        <strong>
                                            @stock.ProductName
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(stock.Barcode))
                                        {
                                            <br />

                                            <small class="text-muted">

                                                Barcode:
                                                @stock.Barcode

                                            </small>
                                        }

                                    </td>


                                    <!-- SKU -->

                                    <td>
                                        @stock.SKU
                                    </td>


                                    <!-- WAREHOUSE -->

                                    <td>
                                        @stock.WarehouseName
                                    </td>


                                    <!-- OPENING -->

                                    <td class="text-end">
                                        @stock.OpeningStock.ToString("N2")
                                    </td>


                                    <!-- RECEIVED -->

                                    <td class="text-end text-success">
                                        @stock.ReceivedQuantity.ToString("N2")
                                    </td>


                                    <!-- SOLD -->

                                    <td class="text-end text-danger">
                                        @stock.SoldQuantity.ToString("N2")
                                    </td>


                                    <!-- ON HAND -->

                                    <td class="text-end fw-bold">
                                        @stock.QuantityOnHand.ToString("N2")
                                    </td>


                                    <!-- REORDER -->

                                    <td class="text-end">
                                        @stock.ReorderLevel.ToString("N2")
                                    </td>


                                    <!-- PURCHASE PRICE -->

                                    <td class="text-end">
                                        ₹@stock.PurchasePrice.ToString("N2")
                                    </td>


                                    <!-- STOCK VALUE -->

                                    <td class="text-end fw-semibold">
                                        ₹@stock.StockValue.ToString("N2")
                                    </td>


                                    <!-- STATUS -->

                                    <td class="text-center">

                                        @switch (stock.StockStatus)
                                        {
                                            case "InStock":

                                                <span class="badge bg-success">
                                                    In Stock
                                                </span>

                                                break;

                                            case "LowStock":

                                                <span class="badge bg-warning text-dark">
                                                    Low Stock
                                                </span>

                                                break;

                                            case "OutOfStock":

                                                <span class="badge bg-danger">
                                                    Out of Stock
                                                </span>

                                                break;

                                            default:

                                                <span class="badge bg-secondary">
                                                    @stock.StockStatus
                                                </span>

                                                break;
                                        }

                                    </td>

                                </tr>

                                index++;
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="12"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-box-seam fs-1"></i>

                                        <h5 class="mt-3">
                                            No Stock Records Found
                                        </h5>

                                        <p class="mb-0">
                                            Try changing your report filters.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>


                    <!-- =================================================
                         TOTAL
                         ================================================= -->

                    <tfoot class="table-light">

                        <tr>

                            <th colspan="4"
                                class="text-end">

                                Total:

                            </th>


                            <th class="text-end">

                                @(Model.Stocks?
                                                                .Sum(x => x.OpeningStock)
                                                                .ToString("N2") ?? "0.00")

                            </th>


                            <th class="text-end">

                                @(Model.Stocks?
                                                                .Sum(x => x.ReceivedQuantity)
                                                                .ToString("N2") ?? "0.00")

                            </th>


                            <th class="text-end">

                                @(Model.Stocks?
                                                                .Sum(x => x.SoldQuantity)
                                                                .ToString("N2") ?? "0.00")

                            </th>


                            <th class="text-end fw-bold">

                                @Model.TotalQuantity.ToString("N2")

                            </th>


                            <th></th>

                            <th></th>


                            <th class="text-end fw-bold">

                                ₹@Model.TotalStockValue.ToString("N2")

                            </th>


                            <th></th>

                        </tr>

                    </tfoot>

                </table>

            </div>

        </div>

    </div>


    <!-- =====================================================
         AUTHORISED SIGNATORY
         ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.AuthorisedSignatory))
    {
        <div class="print-signatory">

            <div class="signatory-line">
                ______________________________
            </div>

            <div class="signatory-name">
                @Model.AuthorisedSignatory
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.AuthorisedDesignation))
            {
                <div class="signatory-designation">
                    @Model.AuthorisedDesignation
                </div>
            }

        </div>
    }

</div>


@section Scripts {

    <script>

        $(document).ready(function () {

            $('#stockReportTable').DataTable({

                pageLength: 25,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "All"]
                ],

                order: [
                    [1, 'asc']
                ],

                columnDefs: [

                    {
                        orderable: false,
                        targets: [11]
                    }

                ],

                language: {

                    search: "Search Stock:",

                    lengthMenu:
                        "Show _MENU_ records",

                    info:
                        "Showing _START_ to _END_ of _TOTAL_ stock records",

                    emptyTable:
                        "No stock records found."

                }

            });

        });


        // =====================================================
        // EXCEL / CSV EXPORT
        // =====================================================

        function exportStockExcel()
        {
            const table =
                document.getElementById(
                    "stockReportTable"
                );


            let csv = [];


            const rows =
                table.querySelectorAll("tr");


            rows.forEach(function (row) {

                const columns =
                    row.querySelectorAll(
                        "th, td"
                    );


                const rowData = [];


                columns.forEach(function (column) {

                    let text =
                        column.innerText
                            .replace(/,/g, "")
                            .replace(/\n/g, " ")
                            .trim();


                    rowData.push(
                        '"' + text + '"'
                    );

                });


                csv.push(
                    rowData.join(",")
                );

            });


            const csvFile =
                new Blob(
                    [csv.join("\n")],
                    {
                        type:
                            "text/csv;charset=utf-8;"
                    }
                );


            const downloadLink =
                document.createElement("a");


            downloadLink.href =
                URL.createObjectURL(csvFile);


            downloadLink.download =
                "Stock_Report.csv";


            document.body.appendChild(
                downloadLink
            );


            downloadLink.click();


            document.body.removeChild(
                downloadLink
            );

        }

    </script>

}


<style>

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .progress {
        border-radius: 10px;
    }


    /* =====================================================
           PRINT REPORT HEADER
           ===================================================== */

    .print-report-header {
        display: none;
        text-align: center;
        margin-bottom: 20px;
    }

    .print-organisation-name {
        font-size: 24px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .print-branch {
        font-size: 15px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .print-address {
        font-size: 13px;
        margin-bottom: 3px;
    }

    .print-contact {
        font-size: 13px;
        margin-bottom: 3px;
    }

        .print-contact span {
            margin: 0 8px;
        }

    .print-gstin {
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .print-report-heading {
        font-size: 20px;
        font-weight: 700;
        margin-top: 10px;
        margin-bottom: 8px;
    }


    /* =====================================================
           PRINT SIGNATORY
           ===================================================== */

    .print-signatory {
        display: none;
        text-align: right;
        margin-top: 50px;
        margin-right: 30px;
    }

    .signatory-line {
        margin-bottom: 6px;
    }

    .signatory-name {
        font-weight: 700;
    }

    .signatory-designation {
        font-size: 13px;
        margin-top: 2px;
    }


    /* =====================================================
           PRINT
           ===================================================== */

    @@media print {

        @@page {
            size: landscape;
            margin: 10mm;
        }

        body {
            background: white !important;
        }

        .no-print,
        .btn,
        nav,
        .sidebar,
        .navbar,
        footer,
        .dataTables_wrapper .dataTables_filter,
        .dataTables_wrapper .dataTables_length,
        .dataTables_wrapper .dataTables_info,
        .dataTables_wrapper .dataTables_paginate {
            display: none !important;
        }

        .print-report-header {
            display: block !important;
        }

        .print-signatory {
            display: block !important;
        }

        .container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #999 !important;
            border-radius: 0 !important;
        }

        .card-header {
            border-radius: 0 !important;
        }

        .table {
            width: 100% !important;
        }

            .table th,
            .table td {
                border: 1px solid #999 !important;
            }

        .table-responsive {
            overflow: visible !important;
        }

        #stockReportTable {
            font-size: 10px !important;
        }

            #stockReportTable th,
            #stockReportTable td {
                padding: 4px !important;
            }
    }

</style>

