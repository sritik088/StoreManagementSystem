@model DashboardReportViewModel

@{
    ViewData["Title"] = "Dashboard Reports";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-bar-chart-line text-primary"></i>
                Dashboard Reports
            </h2>

            <p class="text-muted mb-0">
                Overall business performance
            </p>
        </div>

    </div>


    <div class="row g-4">


        <!-- Products -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <i class="bi bi-box-seam fs-2
                              text-primary"></i>

                    <h6 class="text-muted mt-3">
                        Total Products
                    </h6>

                    <h2>
                        @Model.TotalProducts
                    </h2>

                </div>

            </div>

        </div>


        <!-- Suppliers -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <i class="bi bi-truck fs-2
                              text-warning"></i>

                    <h6 class="text-muted mt-3">
                        Total Suppliers
                    </h6>

                    <h2>
                        @Model.TotalSuppliers
                    </h2>

                </div>

            </div>

        </div>


        <!-- Customers -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <i class="bi bi-people fs-2
                              text-success"></i>

                    <h6 class="text-muted mt-3">
                        Total Customers
                    </h6>

                    <h2>
                        @Model.TotalCustomers
                    </h2>

                </div>

            </div>

        </div>


        <!-- Warehouses -->

        <div class="col-xl-3 col-md-6">

            <div class="card shadow-sm border-0">

                <div class="card-body">

                    <i class="bi bi-building fs-2
                              text-danger"></i>

                    <h6 class="text-muted mt-3">
                        Warehouses
                    </h6>

                    <h2>
                        @Model.TotalWarehouses
                    </h2>

                </div>

            </div>

        </div>

    </div>


    <!-- Report Navigation -->

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white">

            <h5 class="mb-0">
                Reports
            </h5>

        </div>

        <div class="card-body">

            <div class="row g-3">


                <div class="col-md-4">

                    <a asp-action="Purchases"
                       class="btn btn-outline-primary
                              w-100 p-3">

                        <i class="bi bi-cart-plus"></i>

                        Purchase Reports

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="Sales"
                       class="btn btn-outline-success
                              w-100 p-3">

                        <i class="bi bi-cart-check"></i>

                        Sales Reports

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="Stock"
                       class="btn btn-outline-warning
                              w-100 p-3">

                        <i class="bi bi-boxes"></i>

                        Stock Reports

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="InventoryValuation"
                       class="btn btn-outline-info
                              w-100 p-3">

                        <i class="bi bi-calculator"></i>

                        Inventory Valuation

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="LowStock"
                       class="btn btn-outline-danger
                              w-100 p-3">

                        <i class="bi bi-exclamation-triangle"></i>

                        Low Stock

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="ProfitLoss"
                       class="btn btn-outline-dark
                              w-100 p-3">

                        <i class="bi bi-graph-up"></i>

                        Profit & Loss

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="GST"
                       class="btn btn-outline-primary
                              w-100 p-3">

                        <i class="bi bi-percent"></i>

                        GST Reports

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="Customers"
                       class="btn btn-outline-success
                              w-100 p-3">

                        <i class="bi bi-person"></i>

                        Customer Reports

                    </a>

                </div>


                <div class="col-md-4">

                    <a asp-action="Suppliers"
                       class="btn btn-outline-secondary
                              w-100 p-3">

                        <i class="bi bi-truck"></i>

                        Supplier Reports

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>