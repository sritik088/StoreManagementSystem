@model StoreManagementSystem.Web.ViewModels.Reports.SalesReportViewModel

@{
    ViewData["Title"] = "Sales Report";
    Layout = "_AdminLayout";

    var preparedBy = User.Identity?.Name ?? "System User";

    var reportHeading = string.IsNullOrWhiteSpace(Model.ReportHeading)
        ? "SALES REGISTER"
        : Model.ReportHeading.ToUpperInvariant();

    var fromLabel = string.IsNullOrWhiteSpace(Model.FromDateLabel)
        ? "From"
        : Model.FromDateLabel;

    var toLabel = string.IsNullOrWhiteSpace(Model.ToDateLabel)
        ? "To"
        : Model.ToDateLabel;
}

<div class="container-fluid sales-report-page">

    <!-- =========================================================
         PRINT REPORT
         ========================================================= -->

    <div class="sales-print-report">

        <!-- =====================================================
             COMPANY HEADER
             ===================================================== -->

        <div class="sales-print-company">

            @if (!string.IsNullOrWhiteSpace(Model.OrganisationName))
            {
                <div class="sales-print-organisation">
                    @Model.OrganisationName.ToUpperInvariant()
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Branch))
            {
                <div class="sales-print-branch">
                    @Model.Branch.ToUpperInvariant()
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Address))
            {
                <div class="sales-print-address">
                    @Model.Address
                </div>
            }

            <div class="sales-print-contact">

                @if (!string.IsNullOrWhiteSpace(Model.Phone))
                {
                    <span>
                        @Model.Phone
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <span>
                        @Model.Email
                    </span>
                }

                @if (!string.IsNullOrWhiteSpace(Model.GSTIN))
                {
                    <span>
                        GSTIN: @Model.GSTIN
                    </span>
                }

            </div>

        </div>


        <!-- =====================================================
             REPORT TITLE
             ===================================================== -->

        <div class="sales-print-separator"></div>

        <div class="sales-print-heading">
            @reportHeading
        </div>


        <!-- =====================================================
             DATE RANGE
             ===================================================== -->

        <div class="sales-print-date-range">

            @fromLabel:
            @Model.FromDate.ToString("dd/MM/yyyy")

            <span class="sales-date-gap">
                -
            </span>

            @toLabel:
            @Model.ToDate.ToString("dd/MM/yyyy")

        </div>


        <div class="sales-print-separator"></div>


        <!-- =====================================================
             REPORT SUMMARY
             ===================================================== -->

        <div class="sales-print-section-title">
            REPORT SUMMARY
        </div>


        <table class="sales-summary-table">

            <thead>

                <tr>

                    <th>
                        TOTAL SALES
                    </th>

                    <th>
                        DISCOUNT
                    </th>

                    <th>
                        NET SALES
                    </th>

                    <th>
                        COGS
                    </th>

                    <th>
                        GROSS PROFIT
                    </th>

                    <th>
                        MARGIN
                    </th>

                    <th>
                        TAX
                    </th>

                    <th>
                        GRAND TOTAL
                    </th>

                    <th>
                        INVOICES
                    </th>

                </tr>

            </thead>

            <tbody>

                <tr>

                    <td>
                        ₹@Model.TotalSales.ToString("N2")
                    </td>

                    <td>
                        ₹@Model.TotalDiscount.ToString("N2")
                    </td>

                    <td>
                        ₹@Model.NetSales.ToString("N2")
                    </td>

                    <td>
                        ₹@Model.CostOfGoodsSold.ToString("N2")
                    </td>

                    <td>
                        ₹@Model.GrossProfit.ToString("N2")
                    </td>

                    <td>
                        @Model.GrossMarginPercent.ToString("N2")%
                    </td>

                    <td>
                        ₹@Model.TotalTax.ToString("N2")
                    </td>

                    <td>
                        ₹@Model.GrandTotal.ToString("N2")
                    </td>

                    <td>
                        @Model.TotalInvoices
                    </td>

                </tr>

            </tbody>

        </table>


        <div class="sales-print-separator"></div>


        <!-- =====================================================
             SALES DETAILS
             ===================================================== -->

        <div class="sales-print-section-title">
            SALES DETAILS
        </div>


        <table class="sales-details-table">

            <thead>

                <tr>

                    <th class="sales-number-column">
                        #
                    </th>

                    <th>
                        PARTICULAR
                    </th>

                    <th class="sales-amount-column">
                        AMOUNT
                    </th>

                </tr>

            </thead>


            <tbody>

                <!-- TOTAL SALES -->

                <tr>

                    <td class="text-center">
                        1
                    </td>

                    <td>
                        Total Sales
                    </td>

                    <td class="text-end">
                        ₹@Model.TotalSales.ToString("N2")
                    </td>

                </tr>


                <!-- DISCOUNT -->

                <tr>

                    <td class="text-center">
                        2
                    </td>

                    <td>
                        Less: Discount
                    </td>

                    <td class="text-end">
                        -₹@Model.TotalDiscount.ToString("N2")
                    </td>

                </tr>


                <!-- NET SALES -->

                <tr class="sales-net-row">

                    <td class="text-center">
                        3
                    </td>

                    <td>
                        <strong>
                            Net Sales
                        </strong>
                    </td>

                    <td class="text-end">
                        <strong>
                            ₹@Model.NetSales.ToString("N2")
                        </strong>
                    </td>

                </tr>


                <!-- COGS -->

                <tr class="sales-cogs-row">

                    <td class="text-center">
                        4
                    </td>

                    <td>
                        Cost of Goods Sold
                    </td>

                    <td class="text-end">
                        ₹@Model.CostOfGoodsSold.ToString("N2")
                    </td>

                </tr>


                <!-- GROSS PROFIT -->

                <tr class="sales-profit-row">

                    <td class="text-center">
                        5
                    </td>

                    <td>
                        <strong>
                            Gross Profit
                        </strong>
                    </td>

                    <td class="text-end">
                        <strong>
                            ₹@Model.GrossProfit.ToString("N2")
                        </strong>
                    </td>

                </tr>


                <!-- GROSS MARGIN -->

                <tr>

                    <td class="text-center">
                        6
                    </td>

                    <td>
                        Gross Margin
                    </td>

                    <td class="text-end">
                        @Model.GrossMarginPercent.ToString("N2")%
                    </td>

                </tr>


                <!-- TAX -->

                <tr>

                    <td class="text-center">
                        7
                    </td>

                    <td>
                        Total Tax
                    </td>

                    <td class="text-end">
                        ₹@Model.TotalTax.ToString("N2")
                    </td>

                </tr>


                <!-- GRAND TOTAL -->

                <tr class="sales-grand-total-row">

                    <td colspan="2" class="text-end">
                        <strong>
                            Grand Total:
                        </strong>
                    </td>

                    <td class="text-end">
                        <strong>
                            ₹@Model.GrandTotal.ToString("N2")
                        </strong>
                    </td>

                </tr>

            </tbody>

        </table>


        <!-- =====================================================
             TOTALS
             ===================================================== -->

        <div class="sales-total-section">

            <div>

                <strong>
                    Total Invoices:
                </strong>

                @Model.TotalInvoices

            </div>


            <div>

                <strong>
                    Total Sales:
                </strong>

                ₹@Model.TotalSales.ToString("N2")

            </div>


            <div>

                <strong>
                    Total Discount:
                </strong>

                ₹@Model.TotalDiscount.ToString("N2")

            </div>


            <div>

                <strong>
                    Net Sales:
                </strong>

                ₹@Model.NetSales.ToString("N2")

            </div>


            <div>

                <strong>
                    Cost of Goods Sold:
                </strong>

                ₹@Model.CostOfGoodsSold.ToString("N2")

            </div>


            <div>

                <strong>
                    Gross Profit:
                </strong>

                ₹@Model.GrossProfit.ToString("N2")

            </div>


            <div>

                <strong>
                    Gross Margin:
                </strong>

                @Model.GrossMarginPercent.ToString("N2")%

            </div>


            <div>

                <strong>
                    Total Tax:
                </strong>

                ₹@Model.TotalTax.ToString("N2")

            </div>


            <div>

                <strong>
                    Grand Total:
                </strong>

                ₹@Model.GrandTotal.ToString("N2")

            </div>

        </div>


        <!-- =====================================================
             SIGNATURE SECTION
             ===================================================== -->

        <div class="sales-print-signatures">

            <!-- PREPARED BY -->

            <div class="sales-signature-block">

                <div class="sales-signature-title">
                    Prepared By
                </div>

                <div class="sales-signature-space">
                    &nbsp;
                </div>

                <div class="sales-signature-name">
                    @preparedBy
                </div>

                <div class="sales-signature-line">
                    ______________________
                </div>

            </div>


            <!-- AUTHORISED SIGNATORY -->

            <div class="sales-signature-block authorised">

                <div class="sales-signature-title">
                    Authorised Signatory
                </div>

                <div class="sales-signature-space">
                    &nbsp;
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.AuthorisedSignatory))
                {
                    <div class="sales-signature-name">
                        @Model.AuthorisedSignatory
                    </div>
                }
                else
                {
                    <div class="sales-signature-name">
                        &nbsp;
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.AuthorisedDesignation))
                {
                    <div class="sales-signature-designation">
                        @Model.AuthorisedDesignation
                    </div>
                }

                <div class="sales-signature-line">
                    ______________________
                </div>

            </div>

        </div>


        <!-- =====================================================
             PRINT FOOTER
             ===================================================== -->

        <div class="sales-print-footer">

            © @DateTime.Now.Year Store Management ERP

        </div>

    </div>


    <!-- =========================================================
         NORMAL WEB PAGE
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4 no-print">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-graph-up-arrow me-2"></i>

                Sales Report

            </h2>

            <p class="text-muted mb-0">
                Confirmed sales, cost, gross profit and financial summary.
            </p>

        </div>


        <div>

            <button type="button"
                    class="btn btn-outline-secondary"
                    onclick="window.print()">

                <i class="bi bi-printer me-1"></i>

                Print

            </button>

        </div>

    </div>


    <!-- =========================================================
         DATE RANGE
         ========================================================= -->

    <div class="card border-0 shadow-sm mb-4 no-print">

        <div class="card-body">

            <div class="row align-items-center">

                <div class="col-md-4">

                    <div class="text-muted small">
                        @fromLabel.ToUpperInvariant()
                    </div>

                    <div class="fw-semibold">
                        @Model.FromDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <div class="col-md-4">

                    <div class="text-muted small">
                        @toLabel.ToUpperInvariant()
                    </div>

                    <div class="fw-semibold">
                        @Model.ToDate.ToString("dd MMM yyyy")
                    </div>

                </div>


                <div class="col-md-4 text-md-end mt-3 mt-md-0">

                    <span class="badge bg-primary px-3 py-2">

                        <i class="bi bi-calendar3 me-1"></i>

                        @Model.FromDate.ToString("dd MMM yyyy")
                        -
                        @Model.ToDate.ToString("dd MMM yyyy")

                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY CARDS
         ========================================================= -->

    <div class="row g-4 mb-4 no-print">


        <!-- TOTAL SALES -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Total Sales
                            </p>

                            <h3 class="fw-bold mb-0">
                                ₹ @Model.TotalSales.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-success bg-opacity-10 p-3">

                            <i class="bi bi-currency-rupee fs-4 text-success"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- NET SALES -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Net Sales
                            </p>

                            <h3 class="fw-bold mb-0">
                                ₹ @Model.NetSales.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3">

                            <i class="bi bi-cash-stack fs-4 text-primary"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- COGS -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Cost of Goods Sold
                            </p>

                            <h3 class="fw-bold mb-0">
                                ₹ @Model.CostOfGoodsSold.ToString("N2")
                            </h3>

                        </div>

                        <div class="rounded-circle bg-warning bg-opacity-10 p-3">

                            <i class="bi bi-box-seam fs-4 text-warning"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- GROSS PROFIT -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>

                            <p class="text-muted mb-1">
                                Gross Profit
                            </p>

                            <h3 class="fw-bold mb-0
                                @(Model.GrossProfit >= 0
                                                                    ? "text-success"
                                                                    : "text-danger")">

                                ₹ @Model.GrossProfit.ToString("N2")

                            </h3>

                            <div class="small text-muted mt-1">

                                Margin:
                                <strong>
                                    @Model.GrossMarginPercent.ToString("N2")%
                                </strong>

                            </div>

                        </div>

                        <div class="rounded-circle bg-success bg-opacity-10 p-3">

                            <i class="bi bi-graph-up-arrow fs-4 text-success"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SECONDARY SUMMARY
         ========================================================= -->

    <div class="row g-4 mb-4 no-print">

        <!-- DISCOUNT -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Total Discount
                    </p>

                    <h4 class="fw-bold mb-0 text-danger">
                        ₹ @Model.TotalDiscount.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- TAX -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Total Tax
                    </p>

                    <h4 class="fw-bold mb-0 text-warning">
                        ₹ @Model.TotalTax.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- GRAND TOTAL -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Grand Total
                    </p>

                    <h4 class="fw-bold mb-0">
                        ₹ @Model.GrandTotal.ToString("N2")
                    </h4>

                </div>

            </div>

        </div>


        <!-- INVOICES -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <p class="text-muted mb-1">
                        Total Invoices
                    </p>

                    <h4 class="fw-bold mb-0">
                        @Model.TotalInvoices
                    </h4>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         MAIN REPORT
         ========================================================= -->

    <div class="row g-4 no-print">


        <!-- FINANCIAL SUMMARY -->

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 py-3">

                    <h5 class="mb-0 fw-bold">

                        <i class="bi bi-bar-chart-line me-2"></i>

                        Sales Financial Summary

                    </h5>

                </div>


                <div class="card-body">

                    <div class="table-responsive">

                        <table class="table table-bordered align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Particular
                                    </th>

                                    <th class="text-end">
                                        Amount
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                <!-- TOTAL SALES -->

                                <tr>

                                    <td>

                                        <i class="bi bi-cart-check me-2 text-success"></i>

                                        Total Sales

                                    </td>

                                    <td class="text-end fw-semibold">

                                        ₹ @Model.TotalSales.ToString("N2")

                                    </td>

                                </tr>


                                <!-- DISCOUNT -->

                                <tr>

                                    <td>

                                        <i class="bi bi-tag me-2 text-danger"></i>

                                        Less: Total Discount

                                    </td>

                                    <td class="text-end fw-semibold text-danger">

                                        -₹ @Model.TotalDiscount.ToString("N2")

                                    </td>

                                </tr>


                                <!-- NET SALES -->

                                <tr class="table-primary">

                                    <td class="fw-bold">

                                        <i class="bi bi-cash-stack me-2"></i>

                                        Net Sales

                                    </td>

                                    <td class="text-end fw-bold fs-5">

                                        ₹ @Model.NetSales.ToString("N2")

                                    </td>

                                </tr>


                                <!-- COGS -->

                                <tr>

                                    <td>

                                        <i class="bi bi-box-seam me-2 text-warning"></i>

                                        Cost of Goods Sold

                                    </td>

                                    <td class="text-end fw-semibold">

                                        ₹ @Model.CostOfGoodsSold.ToString("N2")

                                    </td>

                                </tr>


                                <!-- GROSS PROFIT -->

                                <tr class="table-success">

                                    <td class="fw-bold">

                                        <i class="bi bi-graph-up-arrow me-2"></i>

                                        Gross Profit

                                    </td>

                                    <td class="text-end fw-bold fs-5
                                        @(Model.GrossProfit < 0
                                                                                    ? "text-danger"
                                                                                    : "text-success")">

                                        ₹ @Model.GrossProfit.ToString("N2")

                                    </td>

                                </tr>


                                <!-- GROSS MARGIN -->

                                <tr>

                                    <td>

                                        <i class="bi bi-percent me-2"></i>

                                        Gross Margin

                                    </td>

                                    <td class="text-end fw-bold">

                                        @Model.GrossMarginPercent.ToString("N2")%

                                    </td>

                                </tr>


                                <!-- TAX -->

                                <tr>

                                    <td>

                                        <i class="bi bi-receipt me-2 text-warning"></i>

                                        Total Tax

                                    </td>

                                    <td class="text-end fw-semibold">

                                        ₹ @Model.TotalTax.ToString("N2")

                                    </td>

                                </tr>


                                <!-- GRAND TOTAL -->

                                <tr class="table-light">

                                    <td class="fw-bold">

                                        <i class="bi bi-wallet2 me-2"></i>

                                        Grand Total

                                    </td>

                                    <td class="text-end fw-bold fs-5">

                                        ₹ @Model.GrandTotal.ToString("N2")

                                    </td>

                                </tr>

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>

        </div>


        <!-- SALES STATISTICS -->

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 py-3">

                    <h5 class="mb-0 fw-bold">

                        <i class="bi bi-pie-chart me-2"></i>

                        Sales Statistics

                    </h5>

                </div>


                <div class="card-body">


                    <!-- INVOICES -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Total Invoices
                            </span>

                            <span class="fw-bold">
                                @Model.TotalInvoices
                            </span>

                        </div>

                        <div class="progress" style="height: 8px;">

                            <div class="progress-bar"
                                 role="progressbar"
                                 style="width: 100%;">
                            </div>

                        </div>

                    </div>


                    <!-- TOTAL SALES -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Total Sales
                            </span>

                            <span class="fw-bold">
                                ₹ @Model.TotalSales.ToString("N2")
                            </span>

                        </div>

                    </div>


                    <!-- NET SALES -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Net Sales
                            </span>

                            <span class="fw-bold text-primary">
                                ₹ @Model.NetSales.ToString("N2")
                            </span>

                        </div>

                    </div>


                    <!-- COGS -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Cost of Goods Sold
                            </span>

                            <span class="fw-bold text-warning">
                                ₹ @Model.CostOfGoodsSold.ToString("N2")
                            </span>

                        </div>

                    </div>


                    <!-- GROSS PROFIT -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Gross Profit
                            </span>

                            <span class="fw-bold
                                @(Model.GrossProfit >= 0
                                                                      ? "text-success"
                                                                      : "text-danger")">

                                ₹ @Model.GrossProfit.ToString("N2")

                            </span>

                        </div>

                    </div>


                    <!-- GROSS MARGIN -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Gross Margin
                            </span>

                            <span class="fw-bold">

                                @Model.GrossMarginPercent.ToString("N2")%

                            </span>

                        </div>

                    </div>


                    <!-- TAX -->

                    <div class="mb-4">

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Total Tax
                            </span>

                            <span class="fw-bold text-warning">
                                ₹ @Model.TotalTax.ToString("N2")
                            </span>

                        </div>

                    </div>


                    <!-- GRAND TOTAL -->

                    <div>

                        <div class="d-flex justify-content-between mb-2">

                            <span class="text-muted">
                                Grand Total
                            </span>

                            <span class="fw-bold">
                                ₹ @Model.GrandTotal.ToString("N2")
                            </span>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         WEB FOOTER
         ========================================================= -->

    <div class="text-muted small mt-4 no-print">

        <i class="bi bi-clock me-1"></i>

        Report generated on
        @DateTime.Now.ToString("dd MMM yyyy, hh:mm tt")

    </div>

</div>


<style>

    /* =========================================================
           NORMAL WEB PAGE
           ========================================================= */

    .card {
        border-radius: 12px;
    }

    .card-header {
        border-radius: 12px 12px 0 0 !important;
    }

    .progress {
