@model IEnumerable<StoreManagementSystem.Application.ViewModels.WarehouseStockViewModel>

@{
    ViewData["Title"] = "Warehouse Stock";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var warehouses = ViewBag.Warehouses;

    int totalWarehouseCount =
        ViewBag.TotalWarehouseCount ?? 0;
}

<div class="container-fluid">

    <!-- ========================================== -->
    <!-- PAGE HEADER -->
    <!-- ========================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                Warehouse Stock
            </h2>

            <p class="text-muted mb-0">
                Monitor inventory warehouse-wise
            </p>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- SUMMARY CARDS -->
    <!-- ========================================== -->

    <div class="row g-3 mb-4">


        <!-- ========================================== -->
        <!-- STOCK RECORDS -->
        <!-- ========================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Stock Records
                            </div>

                            <h3 class="fw-bold mb-0">
                                @Model.Count()
                            </h3>

                        </div>

                        <div class="fs-2 text-primary">

                            <i class="bi bi-box-seam"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- TOTAL WAREHOUSES -->
        <!-- ========================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Warehouses
                            </div>

                            <h3 class="fw-bold mb-0">
                                @totalWarehouseCount
                            </h3>

                        </div>

                        <div class="fs-2 text-info">

                            <i class="bi bi-building"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- LOW STOCK -->
        <!-- ========================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Low Stock
                            </div>

                            <h3 class="fw-bold text-warning mb-0">

                                @Model.Count(x =>
                                x.ClosingBalance > 0 &&
                                x.ClosingBalance <= x.MinimumStock)

                            </h3>

                        </div>

                        <div class="fs-2 text-warning">

                            <i class="bi bi-exclamation-triangle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- ========================================== -->
        <!-- OUT OF STOCK -->
        <!-- ========================================== -->

        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <div class="text-muted small">
                                Out of Stock
                            </div>

                            <h3 class="fw-bold text-danger mb-0">

                                @Model.Count(x =>
                                                                x.ClosingBalance <= 0)

                            </h3>

                        </div>

                        <div class="fs-2 text-danger">

                            <i class="bi bi-x-circle"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================== -->
    <!-- WAREHOUSE STOCK -->
    <!-- ========================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h5 class="mb-0 fw-bold">
                        Warehouse Inventory
                    </h5>

                    <small class="text-muted">
                        Click a warehouse to view its stock
                    </small>

                </div>

                <span class="badge bg-light text-dark">
                    @totalWarehouseCount warehouses
                </span>

            </div>

        </div>


        <div class="card-body p-0">

            @if (warehouses != null && warehouses.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table align-middle mb-0"
                           id="warehouseStockTable">

                        <thead class="table-light">

                            <tr>

                                <th style="width: 45%;">
                                    Warehouse
                                </th>

                                <th class="text-center"
                                    style="width: 20%;">
                                    Stock Records
                                </th>

                                <th class="text-center"
                                    style="width: 20%;">
                                    Closing Balance
                                </th>

                                <th class="text-center"
                                    style="width: 15%;">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var warehouse in warehouses)
                            {
                                var warehouseStocks =
                                Model.Where(x =>
                                x.WarehouseId == warehouse.Id)
                                .ToList();

                                var warehouseClosingBalance =
                                warehouseStocks.Sum(x =>
                                x.ClosingBalance);

                                var collapseId =
                                "warehouse-" + warehouse.Id;

                                <!-- ========================================== -->
                                <!-- WAREHOUSE MAIN ROW -->
                                <!-- ========================================== -->

                                <tr class="warehouse-main-row"
                                    data-target="@collapseId"
                                    style="cursor:pointer;">

                                    <!-- Warehouse -->

                                    <td>

                                        <div class="d-flex align-items-center">

                                            <div class="me-3">

                                                <span class="warehouse-arrow"
                                                      id="arrow-@warehouse.Id">

                                                    <i class="bi bi-chevron-right"></i>

                                                </span>

                                            </div>


                                            <div>

                                                <div class="fw-bold">

                                                    @warehouse.Name

                                                </div>

                                                <small class="text-muted">

                                                    Warehouse

                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- Stock Records -->

                                    <td class="text-center">

                                        <span class="badge bg-primary">

                                            @warehouseStocks.Count

                                        </span>

                                    </td>


                                    <!-- Closing Balance -->

                                    <td class="text-center">

                                        <span class="fw-bold">

                                            @warehouseClosingBalance.ToString("N2")

                                        </span>

                                    </td>


                                    <!-- Action -->

                                    <td class="text-center">

                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary warehouse-toggle">

                                            <i class="bi bi-chevron-down"></i>

                                        </button>

                                    </td>

                                </tr>


                                <!-- ========================================== -->
                                <!-- WAREHOUSE PRODUCT ROWS -->
                                <!-- ========================================== -->

                                <tr id="@collapseId"
                                    class="warehouse-detail-row"
                                    style="display:none;">

                                    <td colspan="4"
                                        class="p-0 bg-light">

                                        @if (warehouseStocks.Any())
                                        {
                                            <div class="p-3">

                                                <div class="table-responsive">

                                                    <table class="table table-sm table-hover align-middle mb-0">

                                                        <thead>

                                                            <tr>

                                                                <th>
                                                                    SKU
                                                                </th>

                                                                <th>
                                                                    Barcode
                                                                </th>

                                                                <th class="text-end">
                                                                    Closing Balance
                                                                </th>

                                                                <th>
                                                                    Status
                                                                </th>

                                                            </tr>

                                                        </thead>


                                                        <tbody>

                                                            @foreach (var item in warehouseStocks)
                                                            {
                                                                <tr>

                                                                    <!-- SKU -->

                                                                    <td>

                                                                        @if (!string.IsNullOrWhiteSpace(item.SKU))
                                                                        {
                                                                            <span class="badge bg-white text-dark border">

                                                                                @item.SKU

                                                                            </span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted">
                                                                                -
                                                                            </span>
                                                                        }

                                                                    </td>


                                                                    <!-- Barcode -->

                                                                    <td>

                                                                        @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                                                        {
                                                                            @item.Barcode
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="text-muted">
                                                                                -
                                                                            </span>
                                                                        }

                                                                    </td>


                                                                    <!-- Closing Balance -->

                                                                    <td class="text-end">

                                                                        <span class="fw-bold">

                                                                            @item.ClosingBalance.ToString("N2")

                                                                        </span>

                                                                    </td>


                                                                    <!-- Status -->

                                                                    <td>

                                                                        <span class="badge @item.StockStatusClass">

                                                                            @item.StockStatus

                                                                        </span>

                                                                    </td>

                                                                </tr>
                                                            }

                                                        </tbody>

                                                    </table>

                                                </div>

                                            </div>
                                        }
                                        else
                                        {
                                            <div class="text-center py-4">

                                                <i class="bi bi-box-seam fs-3 text-muted"></i>

                                                <p class="text-muted mb-0 mt-2">

                                                    No stock available in this warehouse.

                                                </p>

                                            </div>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-building display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No Warehouses Found
                    </h5>

                    <p class="text-muted mb-0">
                        Create a warehouse to view warehouse stock.
                    </p>

                </div>
            }

        </div>

    </div>

</div>


@section Scripts
{
    <script>

        $(document).ready(function () {

            // ==========================================
            // WAREHOUSE EXPAND / COLLAPSE
            // ==========================================

            $('.warehouse-main-row').on('click', function () {

                var targetId =
                    $(this).data('target');

                var detailRow =
                    $('#' + targetId);

                var warehouseId =
                    targetId.replace('warehouse-', '');

                var arrow =
                    $('#arrow-' + warehouseId);

                // ==========================================
                // CLOSE
                // ==========================================

                if (detailRow.is(':visible'))
                {
                    detailRow.hide();

                    arrow.html(
                        '<i class="bi bi-chevron-right"></i>'
                    );
                }

                // ==========================================
                // OPEN
                // ==========================================

                else
                {
                    detailRow.show();

                    arrow.html(
                        '<i class="bi bi-chevron-down"></i>'
                    );
                }

            });


            // ==========================================
            // PREVENT BUTTON DEFAULT ACTION
            // ==========================================

            $('.warehouse-toggle').on('click', function (e) {

                e.stopPropagation();

                $(this)
                    .closest('.warehouse-main-row')
                    .trigger('click');

            });

        });

    </script>
}