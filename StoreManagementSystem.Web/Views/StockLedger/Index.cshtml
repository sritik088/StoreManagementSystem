
@model StoreManagementSystem.Web.ViewModels.StockLedger.StockLedgerIndexViewModel

@{
    ViewData["Title"] = "Stock Ledger";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-text me-2"></i>
                Stock Ledger
            </h2>

            <p class="text-muted mb-0">
                View warehouse-wise product closing balances.
            </p>
        </div>

    </div>


    <!-- =========================================================
         SUMMARY CARDS
    ========================================================== -->

    <div class="row g-3 mb-4">

        <!-- TOTAL WAREHOUSES -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 me-3">

                            <i class="bi bi-building fs-4 text-primary"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Warehouses
                            </div>

                            <div class="fs-4 fw-bold">
                                @Model.TotalWarehouses
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- TOTAL PRODUCTS -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-info bg-opacity-10 p-3 me-3">

                            <i class="bi bi-box-seam fs-4 text-info"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Products
                            </div>

                            <div class="fs-4 fw-bold">
                                @Model.TotalProducts
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- CLOSING QUANTITY -->

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-success bg-opacity-10 p-3 me-3">

                            <i class="bi bi-bar-chart-line fs-4 text-success"></i>

                        </div>

                        <div>

                            <div class="text-muted small">
                                Closing Quantity
                            </div>

                            <div class="fs-4 fw-bold">
                                @Model.TotalClosingQuantity.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         DATE FILTER
    ========================================================== -->

    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white border-bottom">

            <div class="d-flex align-items-center">

                <i class="bi bi-calendar3 me-2 text-primary"></i>

                <h5 class="mb-0 fw-semibold">
                    Closing Balance Date
                </h5>

            </div>

        </div>


        <div class="card-body">

            <form asp-controller="StockLedger"
                  asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Select Date
                        </label>

                        <input type="date"
                               name="date"
                               class="form-control"
                               value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />

                    </div>


                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search me-1"></i>
                            View Closing Balance

                        </button>

                    </div>


                    <div class="col-md-2">

                        <a asp-controller="StockLedger"
                           asp-action="Index"
                           class="btn btn-outline-secondary w-100">

                            <i class="bi bi-arrow-counterclockwise me-1"></i>
                            Today

                        </a>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         SELECTED DATE
    ========================================================== -->

    <div class="alert alert-light border shadow-sm mb-4">

        <div class="d-flex align-items-center">

            <i class="bi bi-calendar-check text-primary fs-5 me-2"></i>

            <div>

                <strong>
                    Closing Balance as of
                </strong>

                <span class="ms-1">
                    @Model.SelectedDate.ToString("dd-MMM-yyyy")
                </span>

            </div>

        </div>

    </div>


    <!-- =========================================================
         WAREHOUSE INVENTORY
    ========================================================== -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-bottom">

            <div>

                <h5 class="mb-1 fw-semibold">
                    Warehouse Stock Ledger
                </h5>

                <small class="text-muted">
                    Click a warehouse to expand or minimize its products.
                </small>

            </div>

        </div>


        <div class="card-body p-0">

            @if (Model.Warehouses.Any())
            {
                <div class="accordion accordion-flush"
                     id="warehouseAccordion">

                    @{
                        int warehouseIndex = 0;
                    }

                    @foreach (var warehouse in Model.Warehouses)
                    {
                        var collapseId =
                        "warehouse_" + warehouse.WarehouseId;

                        var headingId =
                        "heading_" + warehouse.WarehouseId;

                        warehouseIndex++;

                        <div class="accordion-item">

                            <!-- =====================================
                                 WAREHOUSE HEADER
                            ====================================== -->

                            <h2 class="accordion-header"
                                id="@headingId">

                                <button class="accordion-button collapsed"
                                        type="button"
                                        data-bs-toggle="collapse"
                                        data-bs-target="#@collapseId"
                                        aria-expanded="false"
                                        aria-controls="@collapseId">

                                    <div class="container-fluid px-0">

                                        <div class="row align-items-center">

                                            <!-- WAREHOUSE -->

                                            <div class="col-md-5">

                                                <div class="d-flex align-items-center">

                                                    <div class="rounded-circle bg-primary bg-opacity-10 p-2 me-3">

                                                        <i class="bi bi-building text-primary"></i>

                                                    </div>

                                                    <div>

                                                        <div class="fw-semibold">
                                                            @warehouse.WarehouseName
                                                        </div>

                                                        <small class="text-muted">
                                                            @warehouse.ProductCount product(s)
                                                        </small>

                                                    </div>

                                                </div>

                                            </div>


                                            <!-- PRODUCT COUNT -->

                                            <div class="col-md-3 text-center">

                                                <span class="badge bg-light text-dark border">

                                                    @warehouse.ProductCount
                                                    Products

                                                </span>

                                            </div>


                                            <!-- CLOSING BALANCE -->

                                            <div class="col-md-4 text-end">

                                                <small class="text-muted d-block">
                                                    Closing Balance
                                                </small>

                                                <span class="fw-bold">

                                                    @warehouse.ClosingBalance.ToString("N2")

                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </button>

                            </h2>


                            <!-- =====================================
                                 PRODUCTS
                            ====================================== -->

                            <div id="@collapseId"
                                 class="accordion-collapse collapse"
                                 aria-labelledby="@headingId"
                                 data-bs-parent="#warehouseAccordion">

                                <div class="accordion-body p-0">

                                    <div class="table-responsive">

                                        <table class="table table-hover table-bordered align-middle mb-0">

                                            <thead class="table-light">

                                                <tr>

                                                    <th class="text-center">
                                                        #
                                                    </th>

                                                    <th>
                                                        Product
                                                    </th>

                                                    <th>
                                                        Main Category
                                                    </th>

                                                    <th>
                                                        Category
                                                    </th>

                                                    <th>
                                                        Subcategory
                                                    </th>

                                                    <th>
                                                        Transaction Type
                                                    </th>

                                                    <th class="text-end">
                                                        Quantity
                                                    </th>

                                                    <th class="text-end">
                                                        Balance
                                                    </th>

                                                    <th class="text-end">
                                                        Unit Cost
                                                    </th>

                                                    <th>
                                                        Reference No.
                                                    </th>

                                                </tr>

                                            </thead>


                                            <tbody>

                                                @{
                                                    int productRowNumber = 1;
                                                }

                                                @foreach (var ledger in warehouse.Products)
                                                {
                                                    <tr>

                                                        <!-- # -->

                                                        <td class="text-center">
                                                            @productRowNumber
                                                        </td>


                                                        <!-- PRODUCT -->

                                                        <td>

                                                            <span class="fw-semibold">
                                                                @ledger.ProductName
                                                            </span>

                                                        </td>


                                                        <!-- MAIN CATEGORY -->

                                                        <td>
                                                            @(string.IsNullOrWhiteSpace(
                                                                                                            ledger.MainCategoryName)
                                                                                                            ? "—"
                                                                                                            : ledger.MainCategoryName)
                                                                                                                                  </td>


                                                        <!-- CATEGORY -->

                                                        <td>
                                                            @(string.IsNullOrWhiteSpace(
                                                                                                            ledger.CategoryName)
                                                                                                            ? "—"
                                                                                                            : ledger.CategoryName)
                                                                                                                              </td>


                                                        <!-- SUBCATEGORY -->

                                                        <td>
                                                            @(string.IsNullOrWhiteSpace(
                                                                                                            ledger.SubCategoryName)
                                                                                                            ? "—"
                                                                                                            : ledger.SubCategoryName)
                                            </td>


                                                        <!-- TRANSACTION TYPE -->

                                                        <td>

                                                @{
                                                                var transactionType =
                                                                ledger.TransactionType.ToString();

                                                                var badgeClass =
                                                                "bg-secondary";

                                                                if (transactionType.Contains(
                                                                "PurchaseReceipt",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-success";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "SalesIssue",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-danger";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "SalesReturn",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-info text-dark";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "PurchaseReturn",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-warning text-dark";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "StockTransferIn",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-primary";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "StockTransferOut",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-warning text-dark";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "StockAdjustment",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-dark";
                                                                }
                                                                else if (transactionType.Contains(
                                                                "OpeningStock",
                                                                StringComparison.OrdinalIgnoreCase))
                                                                {
                                                                    badgeClass =
                                                                    "bg-primary";
                                                                }
                                                            }

                                                            <span class="badge @badgeClass">
                                                                @transactionType
                                                            </span>

                                                        </td>


                                                        <!-- QUANTITY -->

                                                        <td class="text-end">

                                                            @if (ledger.Quantity > 0)
                                                            {
                                                                <span class="text-success fw-semibold">
                                                                    +@(ledger.Quantity.ToString("N2"))
                                                                </span>
                                                            }
                                                            else if (ledger.Quantity < 0)
                                                            {
                                                                <span class="text-danger fw-semibold">
                                                                    @(ledger.Quantity.ToString("N2"))
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span>
                                                                    @(ledger.Quantity.ToString("N2"))
                                                                </span>
                                                            }

                                                        </td>


                                                        <!-- BALANCE -->

                                                        <td class="text-end fw-bold">

                                                            @(ledger.BalanceAfterTransaction.ToString("N2"))

                                                        </td>


                                                        <!-- UNIT COST -->

                                                        <td class="text-end">

                                                            ₹@(ledger.UnitCost.ToString("N2"))

                                                        </td>


                                                        <!-- REFERENCE -->

                                                        <td>

                                                            @if (!string.IsNullOrWhiteSpace(
                                                                                                            ledger.ReferenceNo))
                                                            {
                                                                <span class="badge bg-light text-dark border">
                                                                    @ledger.ReferenceNo
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted">
                                                                    —
                                                                </span>
                                                            }

                                                        </td>

                                                    </tr>

                                                    productRowNumber++;
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-journal-x display-4 text-muted"></i>

                    <h5 class="fw-semibold mt-3">
                        No Stock Data Found
                    </h5>

                    <p class="text-muted mb-0">
                        No stock ledger transactions were found
                        up to the selected date.
                    </p>

                </div>
            }

        </div>

    </div>

</div>

