@model StoreManagementSystem.Domain.Entities.StockLedger

@{
    ViewData["Title"] = "Stock Ledger Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-journal-text me-2"></i>
                Stock Ledger Details
            </h2>
            <p class="text-muted mb-0">
                View product, warehouse, and transaction information.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="mb-0 fw-semibold">
                <i class="bi bi-info-circle me-2 text-primary"></i>
                Transaction Information
            </h5>
        </div>

        <div class="card-body p-4">

            <div class="row g-3">

                <!-- PRODUCT TITLE -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Product Title
                    </label>
                    <input class="form-control"
                           value="@(Model.Product?.Title ?? "—")"
                           readonly />
                </div>

                <!-- WAREHOUSE -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Warehouse
                    </label>
                    <input class="form-control"
                           value="@(Model.Warehouse?.Name ?? "—")"
                           readonly />
                </div>

                <!-- TRANSACTION TYPE -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Transaction Type
                    </label>
                    <input class="form-control"
                           value="@Model.TransactionType"
                           readonly />
                </div>

                <!-- QUANTITY -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Quantity
                    </label>
                    <input class="form-control"
                           value="@Model.Quantity.ToString("N2")"
                           readonly />
                </div>

                <!-- BALANCE -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Balance After Transaction
                    </label>
                    <input class="form-control fw-bold"
                           value="@Model.BalanceAfterTransaction.ToString("N2")"
                           readonly />
                </div>

                <!-- UNIT COST -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Unit Cost
                    </label>
                    <input class="form-control"
                           value="₹ @Model.UnitCost.ToString("N2")"
                           readonly />
                </div>

                <!-- REFERENCE NUMBER -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Reference Number
                    </label>
                    <input class="form-control"
                           value="@(Model.ReferenceNo ?? "—")"
                           readonly />
                </div>

                <!-- TRANSACTION DATE -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Transaction Date
                    </label>
                    <input class="form-control"
                           value="@Model.TransactionDate.ToString("dd-MMM-yyyy HH:mm")"
                           readonly />
                </div>

                <!-- CREATED BY -->
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        Created By
                    </label>
                    <input class="form-control"
                           value="@(Model.CreatedBy ?? "—")"
                           readonly />
                </div>

                <!-- REMARKS -->
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        Remarks
                    </label>
                    <textarea class="form-control"
                              rows="3"
                              readonly>@(Model.Remarks ?? string.Empty)</textarea>
                </div>

            </div>

            <!-- ACTIONS -->
            <div class="d-flex justify-content-start mt-4">
                <a asp-controller="StockLedger"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Stock Ledger
                </a>
            </div>

        </div>
    </div>

</div>
