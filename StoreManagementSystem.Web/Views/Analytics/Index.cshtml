                "#dc3545",
                "#d63384",
                "#6610f2",
                "#0dcaf0",
                "#6c7576",
                "#343a40"
            ];


            // =========================================================
            // DOUGHNUT PLUGIN
            // =========================================================

            const doughnutInfoPlugin = {

                id: "doughnutInfoPlugin",

                afterDraw(chart, args, pluginOptions) {

                    const dataset =
                        chart.data.datasets[0];

                    if (!dataset ||
                        !dataset.data ||
                        !dataset.data.length) {

                        return;
                    }

                    const meta =
                        chart.getDatasetMeta(0);

                    const values =
                        dataset.data.map(function (value) {

                            return Math.max(
                                Number(value) || 0,
                                0
                            );

                        });

                    const total =
                        values.reduce(
                            function (sum, value) {
                                return sum + value;
                            },
                            0
                        );

                    if (total <= 0) {
                        return;
                    }

                    const ctx =
                        chart.ctx;

                    ctx.save();


                    // =====================================================
                    // SLICE LABELS
                    // =====================================================

                    meta.data.forEach(function (arc, index) {

                        const value =
                            values[index];

                        if (value <= 0) {
                            return;
                        }

                        const percent =
                            (value / total) * 100;

                        if (percent < 5) {
                            return;
                        }

                        const angle =
                            (arc.startAngle + arc.endAngle) / 2;

                        const radius =
                            arc.innerRadius +
                            (arc.outerRadius - arc.innerRadius) * 0.52;

                        const x =
                            arc.x +
                            Math.cos(angle) * radius;

                        const y =
                            arc.y +
                            Math.sin(angle) * radius;

                        const label =
                            chart.data.labels[index] || "";

                        const shortLabel =
                            label.length > 12
                                ? label.substring(0, 10) + "…"
                                : label;


                        ctx.textAlign = "center";
                        ctx.textBaseline = "middle";

                        ctx.fillStyle = "#ffffff";

                        ctx.font =
                            "600 9px Inter, Arial, sans-serif";

                        ctx.fillText(
                            shortLabel,
                            x,
                            y - 6
                        );

                        ctx.font =
                            "700 9px Inter, Arial, sans-serif";

                        ctx.fillText(
                            percent.toFixed(1) + "%",
                            x,
                            y + 6
                        );

                    });


                    // =====================================================
                    // CENTER TEXT
                    // =====================================================

                    const centerX =
                        chart.chartArea.left +
                        (chart.chartArea.right -
                         chart.chartArea.left) / 2;

                    const centerY =
                        chart.chartArea.top +
                        (chart.chartArea.bottom -
                         chart.chartArea.top) / 2;

                    const centerTitle =
                        pluginOptions?.centerTitle || "";

                    const centerValue =
                        pluginOptions?.centerValue || "";

                    ctx.textAlign = "center";
                    ctx.textBaseline = "middle";

                    ctx.fillStyle = "#6c757d";

                    ctx.font =
                        "600 9px Inter, Arial, sans-serif";

                    ctx.fillText(
                        centerTitle,
                        centerX,
                        centerY - 8
                    );

                    ctx.fillStyle = "#212529";

                    ctx.font =
                        "700 12px Inter, Arial, sans-serif";

                    ctx.fillText(
                        centerValue,
                        centerX,
                        centerY + 9
                    );

                    ctx.restore();
                }
            };


            Chart.register(
                doughnutInfoPlugin
            );


            // =========================================================
            // FORMATTERS
            // =========================================================

            function formatCurrency(value) {

                return "₹" +
                    Number(value || 0).toLocaleString(
                        "en-IN",
                        {
                            minimumFractionDigits: 2,
                            maximumFractionDigits: 2
                        }
                    );
            }


            function formatNumber(value) {

                return Number(value || 0).toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 0,
                        maximumFractionDigits: 2
                    }
                );
            }


            function cleanArray(values) {

                if (!Array.isArray(values)) {
                    return [];
                }

                return values.map(function (value) {

                    return Number(value) || 0;

                });
            }


            // =========================================================
            // KPI CANVAS
            // =========================================================

            function prepareKpiCanvas(canvas) {

                if (!canvas) {
                    return;
                }

                const parent =
                    canvas.parentElement;

                if (!parent) {
                    return;
                }

                parent.style.position = "relative";
                parent.style.width = "100%";
                parent.style.height = "250px";
                parent.style.minHeight = "250px";

                canvas.style.width = "100%";
                canvas.style.height = "100%";
            }


            // =========================================================
            // KPI DOUGHNUT
            // =========================================================

            function createKpiDoughnut(
                canvasId,
                labels,
                values,
                colors,
                centerTitle,
                centerValue
            ) {

                const canvas =
                    document.getElementById(canvasId);

                if (!canvas) {
                    return;
                }

                prepareKpiCanvas(canvas);

                const safeLabels =
                    Array.isArray(labels)
                        ? labels
                        : [];

                const safeValues =
                    cleanArray(values);

                const count =
                    Math.min(
                        safeLabels.length,
                        safeValues.length
                    );

                const finalLabels = [];
                const finalValues = [];


                // =====================================================
                // KEEP EVERY CATEGORY
                // =====================================================

                for (let i = 0; i < count; i++) {

                    const label =
                        String(
                            safeLabels[i] ?? "Uncategorized"
                        ).trim() ||
                        "Uncategorized";

                    const value =
                        Number(safeValues[i]) || 0;

                    finalLabels.push(label);

                    finalValues.push(
                        Math.max(value, 0)
                    );
                }


                const total =
                    finalValues.reduce(
                        function (sum, value) {

                            return sum +
                                Math.max(
                                    Number(value) || 0,
                                    0
                                );

                        },
                        0
                    );


                // =====================================================
                // NO DATA
                // =====================================================

                if (!finalLabels.length ||
                    !finalValues.length ||
                    total <= 0) {

                    const parent =
                        canvas.parentElement;

                    if (parent) {

                        parent.innerHTML =
                            '<div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">' +
                            '<i class="bi bi-pie-chart fs-2 mb-2"></i>' +
                            '<span class="small">No category data available</span>' +
                            '</div>';

                    }

                    return;
                }


                // =====================================================
                // DESTROY OLD CHART
                // =====================================================

                const existingChart =
                    Chart.getChart(canvas);

                if (existingChart) {
                    existingChart.destroy();
                }


                // =====================================================
                // CREATE CHART
                // =====================================================

                new Chart(
                    canvas,
                    {
                        type: "doughnut",

                        data: {

                            labels: finalLabels,

                            datasets: [
                                {

                                    data: finalValues,

                                    backgroundColor:
                                        finalLabels.map(
                                            function (_, index) {

                                                return colors[
                                                    index %
                                                    colors.length
                                                ];

                                            }
                                        ),

                                    borderColor: "#ffffff",

                                    borderWidth: 2,

                                    hoverOffset: 6,

                                    spacing: 1
                                }
                            ]
                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            cutout: "62%",

                            radius: "88%",

                            animation: {
                                duration: 700
                            },

                            layout: {

                                padding: {
                                    top: 4,
                                    bottom: 4,
                                    left: 4,
                                    right: 4
                                }

                            },

                            plugins: {

                                legend: {

                                    display: true,

                                    position: "bottom",

                                    align: "center",

                                    maxHeight: 65,

                                    labels: {

                                        usePointStyle: true,

                                        pointStyle: "circle",

                                        padding: 8,

                                        boxWidth: 8,

                                        boxHeight: 8,

                                        font: {
                                            size: 10
                                        }

                                    }

                                },

                                doughnutInfoPlugin: {

                                    centerTitle: centerTitle,

                                    centerValue: centerValue

                                },

                                tooltip: {

                                    callbacks: {

                                        label:
                                            function (context) {

                                                const value =
                                                    Number(
                                                        context.raw || 0
                                                    );

                                                const totalValue =
                                                    context.dataset.data.reduce(
                                                        function (
                                                            sum,
                                                            item
                                                        ) {

                                                            return sum +
                                                                Math.max(
                                                                    Number(item) || 0,
                                                                    0
                                                                );

                                                        },
                                                        0
                                                    );

                                                const percentage =
                                                    totalValue > 0
                                                        ? (
                                                            value /
                                                            totalValue
                                                        ) * 100
                                                        : 0;

                                                return (
                                                    " " +
                                                    context.label +
                                                    ": " +
                                                    formatCurrency(value) +
                                                    " (" +
                                                    percentage.toFixed(1) +
                                                    "%)"
                                                );

                                            }

                                    }

                                }

                            }

                        }

                    }
                );
            }


            // =========================================================
            // KPI CHARTS
            // =========================================================

            // ---------------------------------------------------------
            // NET SALES
            // ---------------------------------------------------------

            if (salesOrderEnabled) {

                createKpiDoughnut(
                    "netSalesKpiChart",
                    categoryLabels,
                    categorySalesValues,
                    netSalesColors,
                    "NET SALES",
                    formatCurrency(netSalesTotal)
                );

            }


            // ---------------------------------------------------------
            // PURCHASES
            // ---------------------------------------------------------

            createKpiDoughnut(
                "purchaseKpiChart",
                categoryLabels,
                categoryPurchaseValues,
                purchaseColors,
                "PURCHASES",
                formatCurrency(purchasesTotal)
            );


            // ---------------------------------------------------------
            // GROSS PROFIT
            // ---------------------------------------------------------

            if (salesOrderEnabled) {

                createKpiDoughnut(
                    "profitKpiChart",
                    categoryLabels,
                    categoryProfitValues,
                    profitColors,
                    "GROSS PROFIT",
                    formatCurrency(grossProfitTotal)
                );

            }


            // ---------------------------------------------------------
            // INVENTORY
            // ---------------------------------------------------------

            createKpiDoughnut(
                "inventoryKpiChart",
                categoryLabels,
                categoryInventoryValues,
                inventoryColors,
                "INVENTORY",
                formatCurrency(inventoryTotal)
            );


            // =========================================================
            // BUSINESS PERFORMANCE
            // =========================================================

            const businessTrendCanvas =
                document.getElementById("businessTrendChart");

            if (businessTrendCanvas) {

                const datasets = [];


                // -----------------------------------------------------
                // SALES
                // -----------------------------------------------------

                if (salesOrderEnabled) {

                    datasets.push({

                        label: salesOrderPluralLabel,

                        data: cleanArray(salesValues),

                        borderColor: "#0d6efd",

                        backgroundColor:
                            "rgba(13,110,253,0.10)",

                        borderWidth: 3,

                        tension: 0.35,

                        fill: true,

                        pointRadius: 3,

                        pointHoverRadius: 6

                    });

                }


                // -----------------------------------------------------
                // PURCHASES
                // -----------------------------------------------------

                datasets.push({

                    label: "Purchases",

                    data: cleanArray(purchaseValues),

                    borderColor: "#198754",

                    backgroundColor:
                        "rgba(25,135,84,0.08)",

                    borderWidth: 3,

                    tension: 0.35,

                    fill: true,

                    pointRadius: 3,

                    pointHoverRadius: 6

                });


                // -----------------------------------------------------
                // GROSS PROFIT
                // -----------------------------------------------------

                if (salesOrderEnabled) {

                    datasets.push({

                        label: "Gross Profit",

                        data: cleanArray(profitValues),

                        borderColor: "#fd7e14",

                        backgroundColor:
                            "rgba(253,126,20,0.08)",

                        borderWidth: 3,

                        tension: 0.35,

                        fill: true,

                        pointRadius: 3,

                        pointHoverRadius: 6

                    });

                }


                // -----------------------------------------------------
                // TREND LABELS
                // -----------------------------------------------------

                let trendLabels = [];


                if (salesOrderEnabled &&
                    Array.isArray(salesLabels) &&
                    salesLabels.length > 0) {

                    trendLabels = salesLabels;

                }
                else if (
                    Array.isArray(purchaseLabels) &&
                    purchaseLabels.length > 0
                ) {

                    trendLabels = purchaseLabels;

                }


                if (!trendLabels.length) {

                    const parent =
                        businessTrendCanvas.parentElement;

                    if (parent) {

                        parent.innerHTML =
                            '<div class="d-flex align-items-center justify-content-center h-100 text-muted small">' +
                            'No trend data available' +
                            '</div>';

                    }

                }
                else {

                    const existingChart =
                        Chart.getChart(
                            businessTrendCanvas
                        );

                    if (existingChart) {
                        existingChart.destroy();
                    }


                    new Chart(
                        businessTrendCanvas,
                        {

                            type: "line",

                            data: {

                                labels: trendLabels,

                                datasets: datasets

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                interaction: {

                                    mode: "index",

                                    intersect: false

                                },

                                plugins: {

                                    legend: {

                                        position: "top",

                                        align: "end"

                                    },

                                    tooltip: {

                                        callbacks: {

                                            label:
                                                function (context) {

                                                    return (
                                                        " " +
                                                        context.dataset.label +
                                                        ": " +
                                                        formatCurrency(
                                                            context.raw
                                                        )
                                                    );

                                                }

                                        }

                                    }

                                },

                                scales: {

                                    x: {

                                        grid: {
                                            display: false
                                        }

                                    },

                                    y: {

                                        beginAtZero: true,

                                        ticks: {

                                            callback:
                                                function (value) {

                                                    return formatCurrency(
                                                        value
                                                    );

                                                }

                                        }

                                    }

                                }

                            }

                        }
                    );

                }

            }


            // =========================================================
            // INVENTORY HEALTH
            // =========================================================

            const inventoryHealthCanvas =
                document.getElementById(
                    "inventoryHealthChart"
                );

            if (inventoryHealthCanvas) {

                const healthValues =
                    cleanArray(
                        inventoryHealthValues
                    );

                const healthLabels = [
                    "In Stock",
                    "Low Stock",
                    "Out of Stock"
                ];

                const healthTotal =
                    healthValues.reduce(
                        function (sum, value) {

                            return sum +
                                Math.max(value, 0);

                        },
                        0
                    );


                if (healthTotal <= 0) {

                    const parent =
                        inventoryHealthCanvas.parentElement;

                    if (parent) {

                        parent.innerHTML =
                            '<div class="d-flex align-items-center justify-content-center h-100 text-muted small">' +
                            'No inventory health data available' +
                            '</div>';

                    }

                }
                else {

                    const existingChart =
                        Chart.getChart(
                            inventoryHealthCanvas
                        );

                    if (existingChart) {
                        existingChart.destroy();
                    }


                    new Chart(
                        inventoryHealthCanvas,
                        {

                            type: "doughnut",

                            data: {

                                labels: healthLabels,

                                datasets: [
                                    {

                                        data: healthValues,

                                        backgroundColor: [
                                            "#198754",
                                            "#ffc107",
                                            "#dc3545"
                                        ],

                                        borderColor: "#ffffff",

                                        borderWidth: 2,

                                        hoverOffset: 6

                                    }
                                ]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                cutout: "60%",

                                plugins: {

                                    legend: {

                                        display: true,

                                        position: "bottom",

                                        labels: {

                                            usePointStyle: true,

                                            pointStyle: "circle",

                                            padding: 15

                                        }

                                    },

                                    tooltip: {

                                        callbacks: {

                                            label:
                                                function (context) {

                                                    const value =
                                                        Number(
                                                            context.raw || 0
                                                        );

                                                    const percentage =
                                                        healthTotal > 0
                                                            ? (
                                                                value /
                                                                healthTotal
                                                            ) * 100
                                                            : 0;

                                                    return (
                                                        " " +
                                                        context.label +
                                                        ": " +
                                                        formatNumber(value) +
                                                        " (" +
                                                        percentage.toFixed(1) +
                                                        "%)"
                                                    );

                                                }

                                        }

                                    }

                                }

                            }

                        }
                    );

                }

            }


            // =========================================================
            // WAREHOUSE CHART
            // =========================================================

            const warehouseCanvas =
                document.getElementById(
                    "warehouseChart"
                );

            if (warehouseCanvas) {

                const safeWarehouseLabels =
                    Array.isArray(warehouseLabels)
                        ? warehouseLabels
                        : [];

                const safeWarehouseValues =
                    cleanArray(warehouseValues);

                const warehouseCount =
                    Math.min(
                        safeWarehouseLabels.length,
                        safeWarehouseValues.length
                    );

                const finalWarehouseLabels =
                    safeWarehouseLabels.slice(
                        0,
                        warehouseCount
                    );

                const finalWarehouseValues =
                    safeWarehouseValues.slice(
                        0,
                        warehouseCount
                    );


                if (!finalWarehouseLabels.length) {

                    const parent =
                        warehouseCanvas.parentElement;

                    if (parent) {

                        parent.innerHTML =
                            '<div class="d-flex align-items-center justify-content-center h-100 text-muted small">' +
                            'No warehouse data available' +
                            '</div>';

                    }

                }
                else {

                    const existingChart =
                        Chart.getChart(
                            warehouseCanvas
                        );

                    if (existingChart) {
                        existingChart.destroy();
                    }


                    new Chart(
                        warehouseCanvas,
                        {

                            type: "bar",

                            data: {

                                labels:
                                    finalWarehouseLabels,

                                datasets: [
                                    {

                                        label:
                                            "Inventory Value",

                                        data:
                                            finalWarehouseValues,

                                        backgroundColor: [
                                            "#6f42c1",
                                            "#0d6efd",
                                            "#20c997",
                                            "#198754",
                                            "#ffc107",
                                            "#fd7e14",
                                            "#dc3545",
                                            "#d63384",
                                            "#6610f2",
                                            "#0dcaf0"
                                        ],

                                        borderRadius: 8,

                                        borderSkipped: false

                                    }
                                ]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                plugins: {

                                    legend: {
                                        display: false
                                    },

                                    tooltip: {

                                        callbacks: {

                                            label:
                                                function (context) {

                                                    return (
                                                        " Inventory Value: " +
                                                        formatCurrency(
                                                            context.raw
                                                        )
                                                    );

                                                }

                                        }

                                    }

                                },

                                scales: {

                                    x: {

                                        grid: {
                                            display: false
                                        }

                                    },

                                    y: {

                                        beginAtZero: true,

                                        ticks: {

                                            callback:
                                                function (value) {

                                                    return formatCurrency(
                                                        value
                                                    );

                                                }

                                        }

                                    }

                                }

                            }

                        }
                    );

                }

            }


            // =========================================================
            // STOCK MOVEMENT
            // =========================================================

            const stockMovementCanvas =
                document.getElementById(
                    "stockMovementChart"
                );

            if (stockMovementCanvas) {

                const safeMovementLabels =
                    Array.isArray(stockMovementLabels)
                        ? stockMovementLabels
                        : [];

                const movementValues =
                    cleanArray(
                        stockMovementValues
                    );

                const movementCount =
                    Math.min(
                        safeMovementLabels.length,
                        movementValues.length
                    );

                const finalMovementLabels =
                    safeMovementLabels.slice(
                        0,
                        movementCount
                    );

                const finalMovementValues =
                    movementValues.slice(
                        0,
                        movementCount
                    );


                if (!finalMovementLabels.length) {

                    const parent =
                        stockMovementCanvas.parentElement;

                    if (parent) {

                        parent.innerHTML =
                            '<div class="d-flex align-items-center justify-content-center h-100 text-muted small">' +
                            'No stock movement data available' +
                            '</div>';

                    }

                }
                else {

                    const existingChart =
                        Chart.getChart(
                            stockMovementCanvas
                        );

                    if (existingChart) {
                        existingChart.destroy();
                    }


                    new Chart(
                        stockMovementCanvas,
                        {

                            type: "bar",

                            data: {

                                labels:
                                    finalMovementLabels,

                                datasets: [
                                    {

                                        label:
                                            "Quantity",

                                        data:
                                            finalMovementValues,

                                        backgroundColor: [
                                            "#198754",
                                            "#0d6efd",
                                            "#20c997",
                                            "#dc3545",
                                            "#6f42c1",
                                            "#fd7e14",
                                            "#6c757d"
                                        ],

                                        borderRadius: 8,

                                        borderSkipped: false

                                    }
                                ]

                            },

                            options: {

                                responsive: true,

                                maintainAspectRatio: false,

                                plugins: {

                                    legend: {
                                        display: false
                                    },

                                    tooltip: {

                                        callbacks: {

                                            label:
                                                function (context) {

                                                    return (
                                                        " Quantity: " +
                                                        formatNumber(
                                                            context.raw
                                                        )
                                                    );

                                                }

                                        }

                                    }

                                },

                                scales: {

                                    x: {

                                        grid: {
                                            display: false
                                        }

                                    },

                                    y: {

                                        beginAtZero: true,

                                        ticks: {

                                            callback:
                                                function (value) {

                                                    return formatNumber(
                                                        value
                                                    );

                                                }

                                        }

                                    }

                                }

                            }

                        }
                    );

                }

            }


            // =========================================================
            // CSV EXPORT
            // =========================================================

            window.exportCategoryReport =
                function () {

                    const table =
                        document.getElementById(
                            "categoryInventoryReportTable"
                        );

                    if (!table) {
                        return;
                    }


                    const rows =
                        Array.from(
                            table.querySelectorAll("tr")
                        );


                    const csvRows =
                        rows.map(function (row) {

                            const cells =
                                Array.from(
                                    row.querySelectorAll(
                                        "th, td"
                                    )
                                );

                            return cells
                                .map(function (cell) {

                                    let value =
                                        cell.innerText
                                            .replace(
                                                /\s+/g,
                                                " "
                                            )
                                            .trim();

                                    value =
                                        value.replace(
                                            /"/g,
                                            '""'
                                        );

                                    return '"' +
                                        value +
                                        '"';

                                })
                                .join(",");

                        });


                    const csv =
                        csvRows.join("\n");


                    const blob =
                        new Blob(
                            [csv],
                            {
                                type:
                                    "text/csv;charset=utf-8;"
                            }
                        );


                    const url =
                        URL.createObjectURL(blob);


                    const link =
                        document.createElement("a");

                    link.href = url;

                    link.download =
                        "category-analytics-" +
                        new Date()
                            .toISOString()
                            .slice(0, 10) +
                        ".csv";


                    document.body.appendChild(link);

                    link.click();

                    document.body.removeChild(link);

                    URL.revokeObjectURL(url);

                };

        });

    </script>

}