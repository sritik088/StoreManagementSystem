@model StoreManagementSystem.Web.ViewModels.Analytics.AnalyticsDashboardViewModel

@using System.Text.Json
@using System.Globalization

@{
    ViewData["Title"] = "Analytics Dashboard";
    Layout = "_AdminLayout";

    // =========================================================
    // SALES ORDER SETTINGS
    // =========================================================

    var salesOrderEnabled =
        ViewData["SalesOrderEnabled"] is bool enabled && enabled;

    var salesOrderLabel =
        ViewData["SalesOrderLabel"]?.ToString() ?? "Sales Order";

    var salesOrderPluralLabel =
        ViewData["SalesOrderPluralLabel"]?.ToString() ?? "Sales Orders";

    var salesOrderUses =
        ViewData["SalesOrderUses"]?.ToString() ?? "Order";


    // =========================================================
    // SAFE COLLECTIONS
    // =========================================================

    var categoryAnalytics =
        Model.CategoryAnalytics
        ?? new List<StoreManagementSystem.Web.ViewModels.Analytics.CategoryAnalyticsRowViewModel>();

    var warehouses =
        Model.Warehouses
        ?? new List<StoreManagementSystem.Web.ViewModels.Analytics.WarehouseAnalyticsRowViewModel>();

    var insights =
        Model.Insights
        ?? new List<StoreManagementSystem.Web.ViewModels.Analytics.AnalyticsInsightViewModel>();


    // =========================================================
    // MAIN CATEGORY DATA
    // =========================================================

    var categoryLabels =
        Model.CategoryChartLabels
        ?? new List<string>();

    var categorySalesValues =
        Model.CategorySalesValues
        ?? new List<decimal>();

    var categoryPurchaseValues =
        Model.CategoryPurchaseValues
        ?? new List<decimal>();

    var categoryGrossProfitValues =
        Model.CategoryGrossProfitValues
        ?? new List<decimal>();

    var categoryInventoryValues =
        Model.CategoryInventoryValues
        ?? new List<decimal>();


    // =========================================================
    // ALIGN CATEGORY ARRAYS
    // =========================================================

    var categoryChartCount =
        new[]
        {
            categoryLabels.Count,
            categorySalesValues.Count,
            categoryPurchaseValues.Count,
            categoryGrossProfitValues.Count,
            categoryInventoryValues.Count
        }.Min();


    var finalCategoryLabels =
        categoryLabels
            .Take(categoryChartCount)
            .ToList();

    var finalCategorySalesValues =
        categorySalesValues
            .Take(categoryChartCount)
            .ToList();

    var finalCategoryPurchaseValues =
        categoryPurchaseValues
            .Take(categoryChartCount)
            .ToList();

    var finalCategoryGrossProfitValues =
        categoryGrossProfitValues
            .Take(categoryChartCount)
            .ToList();

    var finalCategoryInventoryValues =
        categoryInventoryValues
            .Take(categoryChartCount)
            .ToList();


    // =========================================================
    // JSON DATA
    // =========================================================

    var categoryLabelsJson =
        JsonSerializer.Serialize(finalCategoryLabels);

    var categorySalesValuesJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? finalCategorySalesValues
                : new List<decimal>());

    var categoryPurchaseValuesJson =
        JsonSerializer.Serialize(finalCategoryPurchaseValues);

    var categoryProfitValuesJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? finalCategoryGrossProfitValues
                : new List<decimal>());

    var categoryInventoryValuesJson =
        JsonSerializer.Serialize(finalCategoryInventoryValues);


    // =========================================================
    // TREND DATA
    // =========================================================

    var salesTrendLabelsJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.SalesTrendLabels ?? new List<string>()
                : new List<string>());

    var salesTrendValuesJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.SalesTrendValues ?? new List<decimal>()
                : new List<decimal>());

    var purchaseTrendLabelsJson =
        JsonSerializer.Serialize(
            Model.PurchaseTrendLabels
            ?? new List<string>());

    var purchaseTrendValuesJson =
        JsonSerializer.Serialize(
            Model.PurchaseTrendValues
            ?? new List<decimal>());

    var profitTrendLabelsJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.ProfitTrendLabels ?? new List<string>()
                : new List<string>());

    var profitTrendValuesJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.ProfitTrendValues ?? new List<decimal>()
                : new List<decimal>());


    // =========================================================
    // WAREHOUSE DATA
    // =========================================================

    var warehouseLabelsJson =
        JsonSerializer.Serialize(
            Model.WarehouseLabels
            ?? new List<string>());

    var warehouseStockValuesJson =
        JsonSerializer.Serialize(
            Model.WarehouseStockValues
            ?? new List<decimal>());


    // =========================================================
    // INVENTORY HEALTH
    // =========================================================

    var inventoryHealthValuesJson =
        JsonSerializer.Serialize(
            new[]
            {
                Model.InStockProducts,
                Model.LowStockProducts,
                Model.OutOfStockProducts
            });


    // =========================================================
    // STOCK MOVEMENT
    // =========================================================

    var stockMovementLabels =
        new List<string>
        {
            "Purchase Receipt"
        };

    var stockMovementValues =
        new List<decimal>
        {
            Model.PurchaseReceiptQuantity
        };

    // SALES ISSUE ONLY WHEN SALES MODULE IS ENABLED
    if (salesOrderEnabled)
    {
        stockMovementLabels.Add("Sales Issue");
        stockMovementValues.Add(Model.SalesIssueQuantity);
    }

    stockMovementLabels.Add("Sales Return");
    stockMovementValues.Add(Model.SalesReturnQuantity);

    stockMovementLabels.Add("Purchase Return");
    stockMovementValues.Add(Model.PurchaseReturnQuantity);

    stockMovementLabels.Add("Transfer In");
    stockMovementValues.Add(Model.TransferInQuantity);

    stockMovementLabels.Add("Transfer Out");
    stockMovementValues.Add(Model.TransferOutQuantity);

    stockMovementLabels.Add("Adjustment");
    stockMovementValues.Add(Model.AdjustmentQuantity);

    var stockMovementLabelsJson =
        JsonSerializer.Serialize(stockMovementLabels);

    var stockMovementValuesJson =
        JsonSerializer.Serialize(stockMovementValues);


    // =========================================================
    // KPI TOTALS
    // =========================================================

    var netSalesJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.NetSales
                : 0m);

    var purchasesJson =
        JsonSerializer.Serialize(Model.Purchases);

    var grossProfitJson =
        JsonSerializer.Serialize(
            salesOrderEnabled
                ? Model.GrossProfit
                : 0m);

    var inventoryValueJson =
        JsonSerializer.Serialize(Model.InventoryValue);

    var salesOrderPluralLabelJson =
        JsonSerializer.Serialize(salesOrderPluralLabel);


    // =========================================================
    // CATEGORY SUMMARY
    // =========================================================

    var totalCategoryDamage =
        categoryAnalytics.Sum(x => x.Damage);

    var totalCategoryOpening =
        categoryAnalytics.Sum(x => x.OpeningBalance);

    var totalCategoryPurchases =
        categoryAnalytics.Sum(x => x.PurchaseBalance);

    var totalCategorySales =
        salesOrderEnabled
            ? categoryAnalytics.Sum(x => x.SaleBalance)
            : 0m;
}

<style>
    /* =========================================================
           GENERAL
           ========================================================= */

    .analytics-card {
        border: 0;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
    }


    /* =========================================================
           KPI CARDS
           ========================================================= */

    .kpi-card {
        min-height: 500px;
        overflow: hidden;
    }

    .kpi-chart-wrapper {
        position: relative;
        width: 100%;
        height: 330px;
        margin-top: 10px;
    }

        .kpi-chart-wrapper canvas {
            width: 100% !important;
            height: 100% !important;
        }


    /* =========================================================
           BUSINESS PERFORMANCE
           ========================================================= */

    .business-performance-wrapper {
        position: relative;
        width: 100%;
        height: 380px;
    }

        .business-performance-wrapper canvas {
            width: 100% !important;
            height: 100% !important;
        }


    /* =========================================================
           BUSINESS BAR
           ========================================================= */

    .business-bar-wrapper {
        width: 100%;
    }

    .business-bar {
        position: relative;
        width: 100%;
        height: 46px;
        display: flex;
        overflow: hidden;
        border-radius: 10px;
        background: #f1f3f5;
        border: 1px solid #e5e7eb;
    }

    .business-segment {
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 0;
        overflow: hidden;
        white-space: nowrap;
        font-size: 12px;
        font-weight: 700;
        transition: opacity 0.2s ease;
    }

        .business-segment:hover {
            opacity: 0.82;
        }

    .business-opening {
        background: #fff3cd;
        color: #664d03;
        border-right: 1px solid #ffe69c;
    }

    .business-purchase {
        background: #d1e7dd;
        color: #0f5132;
        border-right: 1px solid #a3cfbb;
    }

    .business-sale {
        background: #cfe2ff;
        color: #084298;
        border-right: 1px solid #9ec5fe;
    }

    .business-damage {
        background: #f8d7da;
        color: #842029;
        border-right: 1px solid #f1aeb5;
    }

    .business-closing {
        background: #e2e3e5;
        color: #41464b;
    }


    /* =========================================================
           BUSINESS LEGEND
           ========================================================= */

    .business-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        margin-bottom: 20px;
    }

    .business-legend-item {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        color: #6c757d;
    }

    .business-legend-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        display: inline-block;
        border: 1px solid transparent;
    }

    .legend-opening {
        background: #fff3cd;
        border-color: #ffe69c;
    }

    .legend-purchase {
        background: #d1e7dd;
        border-color: #a3cfbb;
    }

    .legend-sale {
        background: #cfe2ff;
        border-color: #9ec5fe;
    }

    .legend-damage {
        background: #f8d7da;
        border-color: #f1aeb5;
    }

    .legend-closing {
        background: #e2e3e5;
        border-color: #c4c8cb;
    }


    /* =========================================================
           CALCULATION
           ========================================================= */

    .business-calculation {
        font-size: 12px;
        color: #6c757d;
        margin-top: 7px;
    }

        .business-calculation strong {
            color: #212529;
        }

    .text-purple {
        color: #6f42c1 !important;
    }


    /* =========================================================
           CATEGORY
           ========================================================= */

    .category-business-row {
        padding: 16px 0;
        border-bottom: 1px solid #edf0f2;
    }

        .category-business-row:last-child {
            border-bottom: 0;
        }


    /* =========================================================
           METRIC
           ========================================================= */

    .metric-box {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 15px;
        height: 100%;
    }


    /* =========================================================
           TABLE
           ========================================================= */

    .analytics-table th {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }

    .analytics-table td {
        vertical-align: middle;
    }


    /* =========================================================
           INSIGHTS
           ========================================================= */

    .insight-box {
        border: 1px solid #e9ecef;
        border-radius: 12px;
        padding: 16px;
        height: 100%;
    }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 768px) {

        .kpi-card {
            min-height: 470px;
        }

        .kpi-chart-wrapper {
            height: 310px;
        }

        .business-performance-wrapper {
            height: 300px;
        }

        .business-segment {
            font-size: 10px;
        }

        .business-bar {
            height: 40px;
        }

        .business-legend {
            gap: 10px;
        }
    }
</style>


<!-- =========================================================
     PAGE HEADER
     ========================================================= -->

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

    <div class="d-flex align-items-center gap-3">

        <div class="bg-primary text-white rounded-3 p-3">
            <i class="bi bi-bar-chart-line fs-4"></i>
        </div>

        <div>

            <h3 class="fw-bold mb-1">
                Analytics Dashboard
            </h3>

            <div class="text-muted small">
                Business performance, inventory intelligence and operational insights
            </div>

        </div>

    </div>


    <form method="get"
          asp-controller="Analytics"
          asp-action="Index"
          class="d-flex flex-wrap align-items-end gap-2">

        <div>

            <label class="form-label small text-muted mb-1">
                From Date
            </label>

            <input type="date"
                   name="fromDate"
                   value="@Model.FromDate.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>

        <div>

            <label class="form-label small text-muted mb-1">
                To Date
            </label>

            <input type="date"
                   name="toDate"
                   value="@Model.ToDate.ToString("yyyy-MM-dd")"
                   class="form-control" />

        </div>

        <button type="submit"
                class="btn btn-primary">

            <i class="bi bi-filter me-1"></i>
            Apply

        </button>

        <a asp-controller="Analytics"
           asp-action="Index"
           class="btn btn-light border"
           title="Reset">

            <i class="bi bi-arrow-clockwise"></i>

        </a>

    </form>

</div>


<!-- =========================================================
     PERIOD
     ========================================================= -->

<div class="alert alert-light border rounded-3 mb-4">

    <div class="d-flex align-items-center gap-2">

        <i class="bi bi-calendar3 text-primary"></i>

        <div>

            <span class="text-muted">
                Analytics period:
            </span>

            <strong>
                @Model.FromDate.ToString("dd MMM yyyy")
            </strong>

            <span class="text-muted mx-1">
                to
            </span>

            <strong>
                @Model.ToDate.ToString("dd MMM yyyy")
            </strong>

        </div>

    </div>

</div>


<!-- =========================================================
     PRIMARY KPI
     ========================================================= -->

<div class="row g-4 mb-4">

    <!-- =====================================================
         NET SALES
         SALES MODULE ONLY
         ===================================================== -->
    @if (salesOrderEnabled)
    {
        <div class="col-xl-3 col-md-6">

            <div class="card analytics-card kpi-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="text-muted small fw-semibold">
                                NET SALES
                            </div>

                            <div class="fs-3 fw-bold mt-2">
                                ₹@Model.NetSales.ToString("N2")
                            </div>

                            <div class="small text-muted mt-1">
                                Main Category-wise Sales
                            </div>

                        </div>

                        <div class="rounded-3 bg-primary-subtle text-primary p-3">
                            <i class="bi bi-currency-rupee fs-4"></i>
                        </div>

                    </div>

                    <div class="kpi-chart-wrapper">
                        <canvas id="netSalesKpiChart"></canvas>
                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         PURCHASES
         ===================================================== -->

    <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-6") col-md-6">

        <div class="card analytics-card kpi-card h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-muted small fw-semibold">
                            PURCHASES
                        </div>

                        <div class="fs-3 fw-bold mt-2">
                            ₹@Model.Purchases.ToString("N2")
                        </div>

                        <div class="small text-muted mt-1">
                            Main Category-wise Purchases
                        </div>

                    </div>

                    <div class="rounded-3 bg-success-subtle text-success p-3">
                        <i class="bi bi-cart-check fs-4"></i>
                    </div>

                </div>

                <div class="kpi-chart-wrapper">
                    <canvas id="purchaseKpiChart"></canvas>
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         GROSS PROFIT
         SALES MODULE ONLY
         ===================================================== -->
    @if (salesOrderEnabled)
    {
        <div class="col-xl-3 col-md-6">

            <div class="card analytics-card kpi-card h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-start">

                        <div>

                            <div class="text-muted small fw-semibold">
                                GROSS PROFIT
                            </div>

                            <div class="fs-3 fw-bold mt-2">
                                ₹@Model.GrossProfit.ToString("N2")
                            </div>

                            <div class="small text-muted mt-1">
                                Main Category-wise Gross Profit
                            </div>

                        </div>

                        <div class="rounded-3 bg-warning-subtle text-warning p-3">
                            <i class="bi bi-graph-up-arrow fs-4"></i>
                        </div>

                    </div>

                    <div class="kpi-chart-wrapper">
                        <canvas id="profitKpiChart"></canvas>
                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         INVENTORY
         ===================================================== -->

    <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-6") col-md-6">

        <div class="card analytics-card kpi-card h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <div class="text-muted small fw-semibold">
                            INVENTORY VALUE
                        </div>

                        <div class="fs-3 fw-bold mt-2">
                            ₹@Model.InventoryValue.ToString("N2")
                        </div>

                        <div class="small text-muted mt-1">
                            Main Category-wise Inventory Value
                        </div>

                    </div>

                    <div class="rounded-3 bg-info-subtle text-info p-3">
                        <i class="bi bi-box-seam fs-4"></i>
                    </div>

                </div>

                <div class="kpi-chart-wrapper">
                    <canvas id="inventoryKpiChart"></canvas>
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     SECONDARY KPI
     ========================================================= -->

<div class="row g-4 mb-4">

    <!-- SALES ORDER COUNT -->
    @if (salesOrderEnabled)
    {
        <div class="col-xl-3 col-md-6">

            <div class="card analytics-card h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold">
                        @salesOrderPluralLabel.ToUpper()
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @Model.TotalOrders.ToString("N0")
                    </div>

                    <div class="small mt-1 @(Model.OrdersChangePercent >= 0 ? "text-success" : "text-danger")">

                        @(Model.OrdersChangePercent >= 0 ? "+" : "")
                        @Model.OrdersChangePercent.ToString("N1")%

                    </div>

                </div>

            </div>

        </div>


        <!-- AVERAGE SALES ORDER -->
        <div class="col-xl-3 col-md-6">

            <div class="card analytics-card h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold">
                        AVERAGE @salesOrderLabel.ToUpper()
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        ₹@Model.AverageOrderValue.ToString("N2")
                    </div>

                    <div class="small text-muted mt-1">
                        Per @salesOrderUses.ToLower()
                    </div>

                </div>

            </div>

        </div>
    }


    <!-- =====================================================
         GROSS MARGIN
         SALES MODULE ONLY
         ===================================================== -->
    @if (salesOrderEnabled)
    {
        <div class="col-xl-3 col-md-6">

            <div class="card analytics-card h-100">

                <div class="card-body">

                    <div class="text-muted small fw-semibold">
                        GROSS MARGIN
                    </div>

                    <div class="fs-4 fw-bold mt-2">
                        @Model.GrossMarginPercent.ToString("N1")%
                    </div>

                    <div class="small text-muted mt-1">
                        Profitability
                    </div>

                </div>

            </div>

        </div>
    }


    <!-- AVAILABLE STOCK -->
    <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-6") col-md-6">

        <div class="card analytics-card h-100">

            <div class="card-body">

                <div class="text-muted small fw-semibold">
                    AVAILABLE STOCK
                </div>

                <div class="fs-4 fw-bold mt-2">
                    @((Model.TotalStockQuantity - Model.ReservedStockQuantity).ToString("N2"))
                </div>

                <div class="small text-muted mt-1">
                    Units available
                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     BUSINESS PERFORMANCE
     ========================================================= -->

<div class="card analytics-card mb-4">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <h5 class="fw-bold mb-1">
            Business Performance
        </h5>

        <div class="small text-muted">

            @if (salesOrderEnabled)
            {
                <span>@salesOrderPluralLabel</span>
                <span>, purchases and gross profit trend</span>
            }
            else
            {
                <span>Purchases and operational trend</span>
            }

        </div>

    </div>

    <div class="card-body px-4">

        <div class="business-performance-wrapper">
            <canvas id="businessTrendChart"></canvas>
        </div>

    </div>

</div>


<!-- =========================================================
     INVENTORY HEALTH
     ========================================================= -->

<div class="card analytics-card mb-4">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <h5 class="fw-bold mb-1">
            Inventory Health
        </h5>

        <div class="small text-muted">
            Current stock condition
        </div>

    </div>

    <div class="card-body">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <div style="height:280px;">
                    <canvas id="inventoryHealthChart"></canvas>
                </div>

            </div>

            <div class="col-lg-6">

                <div class="row g-3 text-center">

                    <div class="col-4">

                        <div class="border rounded-3 p-3">

                            <div class="fs-4 fw-bold text-success">
                                @Model.InStockProducts
                            </div>

                            <div class="small text-muted">
                                In Stock
                            </div>

                        </div>

                    </div>

                    <div class="col-4">

                        <div class="border rounded-3 p-3">

                            <div class="fs-4 fw-bold text-warning">
                                @Model.LowStockProducts
                            </div>

                            <div class="small text-muted">
                                Low Stock
                            </div>

                        </div>

                    </div>

                    <div class="col-4">

                        <div class="border rounded-3 p-3">

                            <div class="fs-4 fw-bold text-danger">
                                @Model.OutOfStockProducts
                            </div>

                            <div class="small text-muted">
                                Out
                            </div>

                        </div>

                    </div>

                </div>

                <div class="row g-3 mt-2">

                    <div class="col-6">

                        <div class="metric-box">

                            <div class="small text-muted">
                                RESERVED
                            </div>

                            <div class="fs-5 fw-bold mt-1">
                                @Model.ReservedStockQuantity.ToString("N2")
                            </div>

                            <div class="small text-muted">
                                units
                            </div>

                        </div>

                    </div>

                    <div class="col-6">

                        <div class="metric-box">

                            <div class="small text-muted">
                                DAMAGE VALUE
                            </div>

                            <div class="fs-5 fw-bold mt-1 text-danger">
                                ₹@Model.DamageValue.ToString("N2")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     CATEGORY BUSINESS STOCK FLOW
     ========================================================= -->

<div class="card analytics-card mb-4">

    <div class="card-header bg-white border-0 pt-4 px-4">

        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div>

                <h5 class="fw-bold mb-1">

                    <i class="bi bi-bar-chart-fill text-primary me-2"></i>

                    Category Business Stock Flow

                </h5>

                <div class="small text-muted">

                    One business bar per category showing
                    Opening,
                    Purchases,

                    @if (salesOrderEnabled)
                    {
                        <span>Sales,</span>
                    }

                    Damage and Closing Stock

                </div>

            </div>

            <span class="badge bg-light text-dark border">
                @categoryAnalytics.Count Categories
            </span>

        </div>

    </div>


    <div class="card-body px-4">

        <div class="business-legend">

            <div class="business-legend-item">
                <span class="business-legend-dot legend-opening"></span>
                Opening
            </div>

            <div class="business-legend-item">
                <span class="business-legend-dot legend-purchase"></span>
                Purchases
            </div>

            @if (salesOrderEnabled)
            {
                <div class="business-legend-item">
                    <span class="business-legend-dot legend-sale"></span>
                    Sales
                </div>
            }

            <div class="business-legend-item">
                <span class="business-legend-dot legend-damage"></span>
                Damage
            </div>

            <div class="business-legend-item">
                <span class="business-legend-dot legend-closing"></span>
                Closing Stock
            </div>

        </div>


        @if (categoryAnalytics.Any())
        {
            foreach (var category in categoryAnalytics)
            {
                var opening =
                Math.Max(category.OpeningBalance, 0m);

                var purchase =
                Math.Max(category.PurchaseBalance, 0m);

                var sales =
                salesOrderEnabled
                ? Math.Max(category.SaleBalance, 0m)
                : 0m;

                var damage =
                Math.Max(category.Damage, 0m);

                var closing =
                Math.Max(category.CalculatedClosingBalance, 0m);

                var totalBarValue =
                opening +
                purchase +
                sales +
                damage +
                closing;

                if (totalBarValue <= 0)
                {
                    totalBarValue = 1m;
                }

                var openingWidth =
                opening / totalBarValue * 100m;

                var purchaseWidth =
                purchase / totalBarValue * 100m;

                var salesWidth =
                sales / totalBarValue * 100m;

                var damageWidth =
                damage / totalBarValue * 100m;

                var closingWidth =
                closing / totalBarValue * 100m;


                <div class="category-business-row">

                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">

                        <div class="fw-bold">

                            <i class="bi bi-folder2-open text-primary me-2"></i>

                            @category.CategoryName

                        </div>

                        <div class="small">

                            <span class="text-muted">
                                Actual Stock:
                            </span>

                            <strong>
                                @category.StockBalance.ToString("N2")
                            </strong>

                            <span class="text-muted ms-2">
                                units
                            </span>

                        </div>

                    </div>


                    <div class="business-bar-wrapper">

                        <div class="business-bar"
                             title="@category.CategoryName">

                            @if (opening > 0)
                            {
                                <div class="business-segment business-opening"
                                     style="width:@openingWidth.ToString("0.##", CultureInfo.InvariantCulture)%"
                                     title="Opening Stock: @opening.ToString("N2") units">

                                    @if (openingWidth >= 8)
                                    {
                                        @opening.ToString("N0")
                                    }

                                </div>
                            }

                            @if (purchase > 0)
                            {
                                <div class="business-segment business-purchase"
                                     style="width:@purchaseWidth.ToString("0.##", CultureInfo.InvariantCulture)%"
                                     title="Purchases: @purchase.ToString("N2") units">

                                    @if (purchaseWidth >= 8)
                                    {
                                        @purchase.ToString("N0")
                                    }

                                </div>
                            }

                            @if (salesOrderEnabled && sales > 0)
                            {
                                <div class="business-segment business-sale"
                                     style="width:@salesWidth.ToString("0.##", CultureInfo.InvariantCulture)%"
                                     title="Sales: @sales.ToString("N2") units">

                                    @if (salesWidth >= 8)
                                    {
                                        @sales.ToString("N0")
                                    }

                                </div>
                            }

                            @if (damage > 0)
                            {
                                <div class="business-segment business-damage"
                                     style="width:@damageWidth.ToString("0.##", CultureInfo.InvariantCulture)%"
                                     title="Damage: @damage.ToString("N2") units">

                                    @if (damageWidth >= 8)
                                    {
                                        @damage.ToString("N0")
                                    }

                                </div>
                            }

                            @if (closing > 0)
                            {
                                <div class="business-segment business-closing"
                                     style="width:@closingWidth.ToString("0.##", CultureInfo.InvariantCulture)%"
                                     title="Calculated Closing Stock: @closing.ToString("N2") units">

                                    @if (closingWidth >= 8)
                                    {
                                        @closing.ToString("N0")
                                    }

                                </div>
                            }

                        </div>

                    </div>


                    <div class="business-calculation">

                        <strong>
                            Calculation:
                        </strong>

                        <span class="ms-1">
                            @category.OpeningBalance.ToString("N2")
                        </span>

                        <span class="text-muted">
                            +
                        </span>

                        <span class="text-success">
                            @category.PurchaseBalance.ToString("N2")
                        </span>

                        @if (salesOrderEnabled)
                        {
                            <span class="text-muted">
                                −
                            </span>

                            <span class="text-primary">
                                @category.SaleBalance.ToString("N2")
                            </span>
                        }

                        <span class="text-muted">
                            −
                        </span>

                        <span class="text-danger">
                            @category.Damage.ToString("N2")
                        </span>

                        <span class="text-muted">
                            =
                        </span>

                        <strong class="text-purple">
                            @category.CalculatedClosingBalance.ToString("N2")
                            units
                        </strong>

                        <span class="text-muted ms-2">
                            calculated closing
                        </span>

                    </div>


                    <div class="row g-2 mt-2">

                        <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-4") col-md-6">

                            <div class="small text-muted">
                                Purchase Value
                            </div>

                            <div class="fw-semibold">
                                ₹@category.PurchaseValue.ToString("N2")
                            </div>

                        </div>


                        @if (salesOrderEnabled)
                        {
                            <div class="col-xl-3 col-md-6">

                                <div class="small text-muted">
                                    Sales Value
                                </div>

                                <div class="fw-semibold">
                                    ₹@category.SalesValue.ToString("N2")
                                </div>

                            </div>
                        }


                        <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-4") col-md-6">

                            <div class="small text-muted">
                                Actual Stock Value
                            </div>

                            <div class="fw-semibold">
                                ₹@category.StockValue.ToString("N2")
                            </div>

                        </div>


                        <div class="@(salesOrderEnabled ? "col-xl-3" : "col-xl-4") col-md-6">

                            <div class="small text-muted">
                                Stock Difference
                            </div>

                            <div class="fw-semibold">

                                @{
                                    var stockDifference =
                                    category.StockBalance -
                                    category.CalculatedClosingBalance;
                                }

                                <span class="@(Math.Abs(stockDifference) < 0.01m
                                                                          ? "text-success"
                                                                          : "text-warning")">

                            @stockDifference.ToString("N2")

                                </span>

                            </div>

                        </div>

                    </div>

                </div>
                }
        }
        else
        {
            <div class="text-center text-muted py-5">

                <i class="bi bi-bar-chart fs-1 d-block mb-3"></i>

                <div class="fw-semibold">
                    No category business data available.
                </div>

                <div class="small mt-1">
                    Category stock movement will appear here when data is available.
                </div>

            </div>
        }

    </div>

</div>


