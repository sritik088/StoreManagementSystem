@model StoreManagementSystem.Web.ViewModels.PurchaseOrder.PurchaseOrderViewModel

@{
    ViewData["Title"] = "Create Purchase Order";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cart-plus text-primary me-2"></i>
                Create Purchase Order
            </h2>
            <small class="text-muted">Create a new Purchase Order</small>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Create" method="post" id="purchaseOrderForm">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <!-- PURCHASE ORDER INFORMATION -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Purchase Order Information
                </h5>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="SupplierId" class="form-label fw-semibold">
                            Supplier
                        </label>
                        <select asp-for="SupplierId"
                                asp-items="Model.Suppliers"
                                class="form-select">
                            <option value="">-- Select Supplier --</option>
                        </select>
                        <span asp-validation-for="SupplierId" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OrderDate" class="form-label fw-semibold">
                            Order Date
                        </label>
                        <input asp-for="OrderDate" type="date" class="form-control" />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="ExpectedDate" class="form-label fw-semibold">
                            Expected Date
                        </label>
                        <input asp-for="ExpectedDate" type="date" class="form-control" />
                        <span asp-validation-for="ExpectedDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Status</label>
                        <input type="text" class="form-control"
                               value="@Model.Status" readonly />
                    </div>
                </div>
            </div>
        </div>

        <!-- PRODUCTS -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">
                    <i class="bi bi-box-seam me-2"></i> Products
                </h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle"
                           id="itemTable">
                        <thead class="table-dark">
                            <tr>
                                <th style="min-width:210px;">Select Product</th>
                                <th style="min-width:200px;">Product Title</th>
                                <th style="min-width:140px;">SKU</th>
                                <th style="width:110px;">Qty</th>
                                <th style="width:140px;">Unit Price</th>
                                <th style="width:145px;">Discount %</th>
                                <th style="width:125px;">Tax %</th>
                                <th style="width:150px;">Total</th>
                                <th style="width:70px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Items != null && Model.Items.Count > 0)
                            {
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <select name="Items[@i].ProductId"
                                                    class="form-select product">
                                                <option value="">-- Select Product --</option>
                                                @foreach (var product in Model.Products)
                                                {
                                                    if (product.Value == Model.Items[i].ProductId.ToString())
                                                    {
                                                        <option value="@product.Value" selected>
                                                            @product.Text
                                                        </option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@product.Value">
                                                            @product.Text
                                                        </option>
                                                    }
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <input type="text"
                                                   name="Items[@i].ProductName"
                                                   class="form-control product-title"
                                                   value="@Model.Items[i].ProductName"
                                                   readonly
                                                   placeholder="Product title" />
                                        </td>

                                        <td>
                                            <input type="text"
                                                   name="Items[@i].SKU"
                                                   class="form-control product-sku"
                                                   value="@Model.Items[i].SKU"
                                                   readonly
                                                   placeholder="SKU" />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].Quantity"
                                                   class="form-control qty"
                                                   value="@Model.Items[i].Quantity"
                                                   min="0.01" step="0.01" required />
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].UnitPrice"
                                                   class="form-control price"
                                                   value="@Model.Items[i].UnitPrice"
                                                   min="0" step="0.01" required />
                                        </td>

                                        <td>
                                            <div class="input-group">
                                                <input type="number"
                                                       name="Items[@i].DiscountPercent"
                                                       class="form-control discount"
                                                       value="@Model.Items[i].DiscountPercent"
                                                       min="0" max="100" step="0.01" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </td>

                                        <td>
                                            <div class="input-group">
                                                <input type="number"
                                                       name="Items[@i].TaxPercent"
                                                       class="form-control tax"
                                                       value="@Model.Items[i].TaxPercent"
                                                       min="0" max="100" step="0.01" />
                                                <span class="input-group-text">%</span>
                                            </div>
                                        </td>

                                        <td>
                                            <input type="number"
                                                   name="Items[@i].Total"
                                                   class="form-control total"
                                                   value="@Model.Items[i].Total"
                                                   readonly />
                                        </td>

                                        <td class="text-center">
                                            <button type="button"
                                                    class="btn btn-danger removeRow"
                                                    title="Remove Product">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td>
                                        <select name="Items[0].ProductId"
                                                class="form-select product">
                                            <option value="">-- Select Product --</option>
                                            @foreach (var product in Model.Products)
                                            {
                                                <option value="@product.Value">
                                                    @product.Text
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input type="text" name="Items[0].ProductName"
                                               class="form-control product-title"
                                               readonly placeholder="Product title" />
                                    </td>

                                    <td>
                                        <input type="text" name="Items[0].SKU"
                                               class="form-control product-sku"
                                               readonly placeholder="SKU" />
                                    </td>

                                    <td>
                                        <input type="number" name="Items[0].Quantity"
                                               class="form-control qty" value="1"
                                               min="0.01" step="0.01" required />
                                    </td>

                                    <td>
                                        <input type="number" name="Items[0].UnitPrice"
                                               class="form-control price" value="0"
                                               min="0" step="0.01" required />
                                    </td>

                                    <td>
                                        <div class="input-group">
                                            <input type="number"
                                                   name="Items[0].DiscountPercent"
                                                   class="form-control discount" value="0"
                                                   min="0" max="100" step="0.01" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="input-group">
                                            <input type="number"
                                                   name="Items[0].TaxPercent"
                                                   class="form-control tax" value="0"
                                                   min="0" max="100" step="0.01" />
                                            <span class="input-group-text">%</span>
                                        </div>
                                    </td>

                                    <td>
                                        <input type="number" name="Items[0].Total"
                                               class="form-control total" value="0"
                                               readonly />
                                    </td>

                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-danger removeRow"
                                                title="Remove Product">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button type="button" id="addRow" class="btn btn-success">
                    <i class="bi bi-plus-circle me-1"></i> Add Product
                </button>
            </div>
        </div>

        <!-- TOTALS -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-warning">
                <h5 class="mb-0">
                    <i class="bi bi-calculator me-2"></i> Totals
                </h5>
            </div>

            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Sub Total</label>
                        <input asp-for="SubTotal" id="SubTotal"
                               class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Discount Amount</label>
                        <input asp-for="Discount" id="Discount"
                               class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Tax Amount</label>
                        <input asp-for="TaxAmount" id="TaxAmount"
                               class="form-control" readonly />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">Grand Total</label>
                        <input asp-for="GrandTotal" id="GrandTotal"
                               class="form-control fw-bold" readonly />
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control"
                                  rows="4" placeholder="Enter remarks..."></textarea>
                    </div>
                </div>

                <hr class="my-4" />

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Save Purchase Order
                </button>

                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/purchase-order-create.js"
            asp-append-version="true"></script>
}