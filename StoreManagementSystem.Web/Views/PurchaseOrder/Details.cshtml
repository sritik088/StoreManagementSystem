
@model StoreManagementSystem.Domain.Entities.PurchaseOrder

@{
    ViewData["Title"] = "Purchase Order Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">

                <i class="bi bi-file-earmark-text text-primary me-2"></i>

                Purchase Order Details

            </h2>

            <p class="text-muted mb-0">

                View complete purchase order information

            </p>

        </div>


        <div class="d-flex gap-2">

            <button type="button"
                    class="btn btn-outline-primary"
                    onclick="window.print()">

                <i class="bi bi-printer me-1"></i>

                Print

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Back

            </a>

        </div>

    </div>


    <!-- =====================================================
         PURCHASE ORDER HEADER
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="bi bi-file-earmark-text me-2"></i>

                    Purchase Order Information

                </h5>


                @switch (Model.Status)
                {
                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft:

                        <span class="badge bg-light text-dark">
                            Draft
                        </span>

                        break;


                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Approved:

                        <span class="badge bg-success">
                            Approved
                        </span>

                        break;


                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Received:

                        <span class="badge bg-info text-dark">
                            Received
                        </span>

                        break;


                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Cancelled:

                        <span class="badge bg-danger">
                            Cancelled
                        </span>

                        break;


                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.PartiallyReceived:

                        <span class="badge bg-warning text-dark">
                            Partially Received
                        </span>

                        break;


                    case StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.FullyReceived:

                        <span class="badge bg-light text-dark">
                            Fully Received
                        </span>

                        break;


                    default:

                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>

                        break;
                }

            </div>

        </div>


        <div class="card-body">

            <div class="row g-4">


                <!-- PO NUMBER -->

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        PO Number
                    </small>

                    <strong class="fs-5 text-primary">

                        @(string.IsNullOrWhiteSpace(Model.PONumber)
                                                ? $"PO-{Model.Id:D5}"
                                                : Model.PONumber)

                    </strong>

                </div>


                <!-- SUPPLIER -->

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Supplier
                    </small>

                    <strong>

                        @(Model.Supplier?.Name ?? "N/A")

                    </strong>

                </div>


                <!-- ORDER DATE -->

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Order Date
                    </small>

                    <strong>

                        @Model.OrderDate.ToString("dd-MMM-yyyy")

                    </strong>

                </div>


                <!-- EXPECTED DATE -->

                <div class="col-md-3">

                    <small class="text-muted d-block">
                        Expected Date
                    </small>

                    <strong>

                        @Model.ExpectedDate.ToString("dd-MMM-yyyy")

                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PRODUCTS
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-success text-white">

            <h5 class="mb-0">

                <i class="bi bi-box-seam me-2"></i>

                Purchase Order Items

            </h5>

        </div>


        <div class="card-body">

            @if (Model.Items != null && Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered align-middle">

                        <thead class="table-dark">

                            <tr>

                                <th style="width:60px;">
                                    #
                                </th>

                                <th>
                                    Product
                                </th>

                                <th class="text-end">
                                    Quantity
                                </th>

                                <th class="text-end">
                                    Unit Price
                                </th>

                                <th class="text-end">
                                    Discount
                                </th>

                                <th class="text-end">
                                    GST / Tax
                                </th>

                                <th class="text-end">
                                    Total
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @{
                                var itemNumber = 1;
                            }

                            @foreach (var item in Model.Items)
                            {
                                <tr>

                                    <td>
                                        @itemNumber
                                    </td>


                                    <td>

                                        <strong>

                                            @(item.Product?.SKU ?? "Unknown Product")

                                        </strong>

                                    </td>


                                    <td class="text-end">

                                        @item.Quantity.ToString("N2")

                                    </td>


                                    <td class="text-end">

                                        ₹@item.UnitPrice.ToString("N2")

                                    </td>


                                    <td class="text-end">

                                        ₹@item.Discount.ToString("N2")

                                    </td>


                                    <td class="text-end">

                                        ₹@item.TaxAmount.ToString("N2")

                                    </td>


                                    <td class="text-end">

                                        <strong>

                                            ₹@item.Total.ToString("N2")

                                        </strong>

                                    </td>

                                </tr>

                                itemNumber++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">

                    <i class="bi bi-box-seam fs-1"></i>

                    <h5 class="mt-3">
                        No Products
                    </h5>

                    <p class="mb-0">
                        No products have been added to this purchase order.
                    </p>

                </div>
            }

        </div>

    </div>


    <!-- =====================================================
         TOTALS
         ===================================================== -->

    <div class="row justify-content-end mb-4">

        <div class="col-xl-5 col-lg-6 col-md-8">

            <div class="card shadow-sm border-0">

                <div class="card-header bg-warning">

                    <h5 class="mb-0">

                        <i class="bi bi-calculator me-2"></i>

                        Order Summary

                    </h5>

                </div>


                <div class="card-body">


                    <!-- SUBTOTAL -->

                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            Sub Total
                        </span>

                        <strong>
                            ₹@Model.SubTotal.ToString("N2")
                        </strong>

                    </div>


                    <!-- DISCOUNT -->

                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            Discount
                        </span>

                        <strong class="text-danger">

                            - ₹@Model.Discount.ToString("N2")

                        </strong>

                    </div>


                    <!-- TAX -->

                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            GST / Tax
                        </span>

                        <strong class="text-warning">

                            ₹@Model.TaxAmount.ToString("N2")

                        </strong>

                    </div>


                    <hr />


                    <!-- GRAND TOTAL -->

                    <div class="d-flex justify-content-between">

                        <span class="fw-bold fs-5">

                            Grand Total

                        </span>

                        <strong class="fw-bold fs-4 text-success">

                            ₹@Model.GrandTotal.ToString("N2")

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         REMARKS
         ===================================================== -->
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header bg-light">

                <h5 class="mb-0">

                    <i class="bi bi-chat-left-text me-2"></i>

                    Remarks

                </h5>

            </div>


            <div class="card-body">

                <p class="mb-0">

                    @Model.Remarks

                </p>

            </div>

        </div>
    }


    <!-- =====================================================
         AUDIT INFORMATION
         ===================================================== -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-light">

            <h5 class="mb-0">

                <i class="bi bi-clock-history me-2"></i>

                Record Information

            </h5>

        </div>


        <div class="card-body">

            <div class="row">


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Created Date
                    </small>

                    <strong>

                        @Model.CreatedDate.ToString("dd-MMM-yyyy HH:mm")

                    </strong>

                </div>


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Last Updated
                    </small>

                    <strong>

                        @(Model.UpdatedDate.HasValue
                                                ? Model.UpdatedDate.Value.ToString("dd-MMM-yyyy HH:mm")
                                                : "Never updated")

                    </strong>

                </div>


                <div class="col-md-4">

                    <small class="text-muted d-block">
                        Current Status
                    </small>

                    <strong>

                        @Model.Status

                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         BOTTOM ACTIONS
         ===================================================== -->

    <div class="d-flex justify-content-between mb-5">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Purchase Orders

        </a>


        <div class="d-flex gap-2">

            @if (Model.Status ==
                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft)
            {
                <form asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success"
                            onclick="return confirm('Approve this Purchase Order?');">

                        <i class="bi bi-check-circle me-1"></i>

                        Approve

                    </button>

                </form>
            }


            @if (Model.Status ==
                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft
                        ||
                        Model.Status ==
                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Approved)
            {
                <form asp-action="Cancel"
                      asp-route-id="@Model.Id"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-warning"
                            onclick="return confirm('Cancel this Purchase Order?');">

                        <i class="bi bi-x-circle me-1"></i>

                        Cancel

                    </button>

                </form>
            }

        </div>

    </div>

</div>


<style>

    @@media print {

        .sidebar,
        .navbar,
        footer,
        .btn,
        button {
            display: none !important;
        }

        .main {
            margin: 0 !important;
            width: 100% !important;
        }

        .card {
            box-shadow: none !important;
            border: 1px solid #ddd !important;
        }

        body {
            background: white !important;
        }
    }

</style>

