@model IEnumerable<StoreManagementSystem.Domain.Entities.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders";
    Layout = "_AdminLayout";

    var purchaseOrders = Model?.ToList()
        ?? new List<StoreManagementSystem.Domain.Entities.PurchaseOrder>();

    var activeOrders = purchaseOrders
        .Where(x => !x.IsDeleted)
        .ToList();

    var deletedOrders = purchaseOrders
        .Where(x => x.IsDeleted)
        .ToList();

    var draftCount = activeOrders.Count(x =>
        x.Status == StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft);

    var approvedCount = activeOrders.Count(x =>
        x.Status == StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Approved);

    var cancelledCount = activeOrders.Count(x =>
        x.Status == StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Cancelled);

    var activeTotal = activeOrders.Sum(x => x.GrandTotal);
}

<div class="container-fluid py-4">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Purchase Orders
            </h2>

            <p class="text-muted mb-0">
                Manage purchase orders and supplier purchases
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>
                New Purchase Order
            </a>
        </div>

    </div>


    <!-- ========================================================= -->
    <!-- TEMP DATA MESSAGES -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- SUMMARY CARDS -->
    <!-- ========================================================= -->

    <div class="row g-3 mb-4">

        <!-- Total Active -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Active Orders
                            </p>

                            <h3 class="fw-bold mb-0">
                                @activeOrders.Count
                            </h3>
                        </div>

                        <div class="bg-primary bg-opacity-10
                                    text-primary rounded-circle
                                    p-3">

                            <i class="bi bi-cart-check fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Draft -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Draft
                            </p>

                            <h3 class="fw-bold mb-0">
                                @draftCount
                            </h3>
                        </div>

                        <div class="bg-warning bg-opacity-10
                                    text-warning rounded-circle
                                    p-3">

                            <i class="bi bi-file-earmark-text fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Approved -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Approved
                            </p>

                            <h3 class="fw-bold mb-0">
                                @approvedCount
                            </h3>
                        </div>

                        <div class="bg-success bg-opacity-10
                                    text-success rounded-circle
                                    p-3">

                            <i class="bi bi-check-circle fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Total Value -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between align-items-center">

                        <div>
                            <p class="text-muted mb-1">
                                Active PO Value
                            </p>

                            <h3 class="fw-bold mb-0">
                                ₹ @activeTotal.ToString("N2")
                            </h3>
                        </div>

                        <div class="bg-info bg-opacity-10
                                    text-info rounded-circle
                                    p-3">

                            <i class="bi bi-currency-rupee fs-4"></i>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================================= -->
    <!-- PURCHASE ORDER TABLE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <div class="d-flex justify-content-between align-items-center">

                <div>
                    <h5 class="fw-bold mb-0">
                        Purchase Order List
                    </h5>

                    <small class="text-muted">
                        Active and deleted purchase orders
                    </small>
                </div>

                <div class="text-muted">

                    <span class="me-3">
                        <i class="bi bi-circle-fill text-primary small"></i>
                        Active:
                        <strong>@activeOrders.Count</strong>
                    </span>

                    <span>
                        <i class="bi bi-circle-fill text-danger small"></i>
                        Deleted:
                        <strong>@deletedOrders.Count</strong>
                    </span>

                </div>

            </div>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0"
                       id="purchaseOrderTable">

                    <thead class="table-light">

                        <tr>

                            <th>
                                #
                            </th>

                            <th>
                                PO Number
                            </th>

                            <th>
                                Supplier
                            </th>

                            <th>
                                Order Date
                            </th>

                            <th>
                                Expected Date
                            </th>

                            <th class="text-end">
                                Grand Total
                            </th>

                            <th class="text-center">
                                Status
                            </th>

                            <th class="text-center"
                                style="width:180px;">
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (!purchaseOrders.Any())
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center py-5">

                                    <div class="text-muted">

                                        <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                                        <h6 class="fw-bold">
                                            No Purchase Orders Found
                                        </h6>

                                        <p class="mb-0">
                                            Create your first purchase order.
                                        </p>

                                    </div>

                                </td>

                            </tr>
                        }
                        else
                        {
                            var rowNumber = 1;

                            foreach (var po in purchaseOrders)
                            {
                                var isDeleted = po.IsDeleted;

                                var statusText =
                                isDeleted
                                ? "Deleted"
                                : po.Status.ToString();

                                <tr class="@(isDeleted ? "table-danger" : "")">

                                    <!-- ================================================= -->
                                    <!-- ROW NUMBER -->
                                    <!-- ================================================= -->

                                    <td>
                                        @rowNumber
                                    </td>


                                    <!-- ================================================= -->
                                    <!-- PO NUMBER -->
                                    <!-- ================================================= -->

                                    <td>

                                        <div class="fw-semibold">

                                            @po.PONumber

                                        </div>

                                        @if (isDeleted)
                                        {
                                            <small class="text-danger">

                                                <i class="bi bi-trash me-1"></i>
                                                Deleted Purchase Order

                                            </small>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- SUPPLIER -->
                                    <!-- ================================================= -->

                                    <td>

                                        @if (po.Supplier != null)
                                        {
                                            <span>
                                                @po.Supplier.Name
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                N/A
                                            </span>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ORDER DATE -->
                                    <!-- ================================================= -->

                                    <td>

                                        @po.OrderDate.ToString("dd-MM-yyyy")

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- EXPECTED DATE -->
                                    <!-- ================================================= -->

                                    <td>

                                        @po.ExpectedDate.ToString("dd-MM-yyyy")

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- GRAND TOTAL -->
                                    <!-- ================================================= -->

                                    <td class="text-end fw-semibold">

                                        ₹ @po.GrandTotal.ToString("N2")

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- STATUS -->
                                    <!-- ================================================= -->

                                    <td class="text-center">

                                        @if (isDeleted)
                                        {
                                            <span class="badge bg-danger">

                                                <i class="bi bi-trash me-1"></i>
                                                Deleted

                                            </span>
                                        }
                                        else if (
                                        po.Status ==
                                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft)
                                        {
                                            <span class="badge bg-warning text-dark">

                                                <i class="bi bi-pencil me-1"></i>
                                                Draft

                                            </span>
                                        }
                                        else if (
                                        po.Status ==
                                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Approved)
                                        {
                                            <span class="badge bg-success">

                                                <i class="bi bi-check-circle me-1"></i>
                                                Approved

                                            </span>
                                        }
                                        else if (
                                        po.Status ==
                                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.PartiallyReceived)
                                        {
                                            <span class="badge bg-info text-dark">

                                                <i class="bi bi-box-seam me-1"></i>
                                                Partially Received

                                            </span>
                                        }
                                        else if (
                                        po.Status ==
                                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.FullyReceived)
                                        {
                                            <span class="badge bg-primary">

                                                <i class="bi bi-check2-all me-1"></i>
                                                Fully Received

                                            </span>
                                        }
                                        else if (
                                        po.Status ==
                                        StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Cancelled)
                                        {
                                            <span class="badge bg-secondary">

                                                <i class="bi bi-x-circle me-1"></i>
                                                Cancelled

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">

                                                @statusText

                                            </span>
                                        }

                                    </td>


                                    <!-- ================================================= -->
                                    <!-- ACTIONS -->
                                    <!-- ================================================= -->

                                    <td class="text-center">

                                        @if (isDeleted)
                                        {
                                            <!-- RESTORE -->

                                            <form asp-action="Restore"
                                                  asp-route-id="@po.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirmPurchaseOrderRestore('@po.PONumber');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success"
                                                        title="Restore Purchase Order">

                                                    <i class="bi bi-arrow-counterclockwise"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- DETAILS -->

                                            <a asp-action="Details"
                                               asp-route-id="@po.Id"
                                               class="btn btn-sm btn-outline-primary me-1"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- EDIT -->
                                            @if (
                                                                            po.Status ==
                                                                            StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@po.Id"
                                                   class="btn btn-sm btn-outline-warning me-1"
                                                   title="Edit Purchase Order">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            <!-- APPROVE -->
                                            @if (
                                                                            po.Status ==
                                                                            StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft)
                                            {
                                                <form asp-action="Approve"
                                                      asp-route-id="@po.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirmPurchaseOrderApprove('@po.PONumber');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-success me-1"
                                                            title="Approve Purchase Order">

                                                        <i class="bi bi-check-lg"></i>

                                                    </button>

                                                </form>
                                            }


                                            <!-- CANCEL -->
                                            @if (
                                                                            po.Status ==
                                                                            StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft
                                                                            ||
                                                                            po.Status ==
                                                                            StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Approved)
                                            {
                                                <form asp-action="Cancel"
                                                      asp-route-id="@po.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirmPurchaseOrderCancel('@po.PONumber');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-secondary me-1"
                                                            title="Cancel Purchase Order">

                                                        <i class="bi bi-x-lg"></i>

                                                    </button>

                                                </form>
                                            }


                                            <!-- DELETE -->
                                            @if (
                                                                            po.Status ==
                                                                            StoreManagementSystem.Domain.Enums.PurchaseOrderStatus.Draft)
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@po.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirmPurchaseOrderDelete('@po.PONumber');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-outline-danger"
                                                            title="Delete Purchase Order">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>
                                            }

                                        }

                                    </td>

                                </tr>

                                rowNumber++;
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


<!-- ============================================================= -->
<!-- CONFIRMATION SCRIPTS -->
<!-- ============================================================= -->
@section Scripts {

    <script>

        function confirmPurchaseOrderDelete(poNumber) {

            return confirm(
                "Are you sure you want to delete Purchase Order " +
                poNumber +
                "?\n\n" +
                "The Purchase Order will NOT be permanently deleted. " +
                "It will be marked as Deleted and can be restored later."
            );
        }


        function confirmPurchaseOrderRestore(poNumber) {

            return confirm(
                "Are you sure you want to restore Purchase Order " +
                poNumber +
                "?"
            );
        }


        function confirmPurchaseOrderApprove(poNumber) {

            return confirm(
                "Are you sure you want to approve Purchase Order " +
                poNumber +
                "?"
            );
        }


        function confirmPurchaseOrderCancel(poNumber) {

            return confirm(
                "Are you sure you want to cancel Purchase Order " +
                poNumber +
                "?"
            );
        }

    </script>

}