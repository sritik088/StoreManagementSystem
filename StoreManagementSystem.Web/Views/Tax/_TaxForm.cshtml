@model StoreManagementSystem.Web.ViewModels.Tax.TaxViewModel

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name"
               class="form-control"
               placeholder="Enter Tax Name" />

        <span asp-validation-for="Name"
              class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="TaxPercentage" class="form-label"></label>

        <input asp-for="TaxPercentage"
               class="form-control"
               type="number"
               step="0.01"
               min="0"
               max="100"
               placeholder="0.00" />

        <span asp-validation-for="TaxPercentage"
              class="text-danger"></span>

    </div>

</div>

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="TaxType" class="form-label"></label>

        <select asp-for="TaxType" class="form-select">

            <option value="">-- Select Tax Type --</option>

            <option value="GST">GST</option>

            <option value="CGST">CGST</option>

            <option value="SGST">SGST</option>

            <option value="IGST">IGST</option>

            <option value="VAT">VAT</option>

        </select>

        <span asp-validation-for="TaxType"
              class="text-danger"></span>

    </div>

    <div class="col-md-6 d-flex align-items-center">

        <div class="form-check form-switch mt-4">

            <input asp-for="IsActive"
                   class="form-check-input" />

            <label asp-for="IsActive"
                   class="form-check-label"></label>

        </div>

    </div>

</div>

<div class="mb-3">

    <label asp-for="Description"
           class="form-label"></label>

    <textarea asp-for="Description"
              class="form-control"
              rows="4"
              placeholder="Enter Description"></textarea>

    <span asp-validation-for="Description"
          class="text-danger"></span>

</div>