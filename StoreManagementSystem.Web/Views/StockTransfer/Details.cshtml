@model StoreManagementSystem.Domain.Entities.StockTransfer

@{
    ViewData["Title"] = "Stock Transfer Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Stock Transfer Details</h3>
            <p class="text-muted mb-0">
                Transfer Number: @Model.TransferNumber
            </p>
        </div>

        <a asp-controller="StockTransfer"
           asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to List
        </a>
    </div>

    <!-- TRANSFER INFORMATION -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-arrow-left-right text-primary me-2"></i>
                Transfer Information
            </h5>
        </div>

        <div class="card-body p-4">
            <div class="row g-4">

                <div class="col-md-4">
                    <label class="text-muted small">Transfer Number</label>
                    <div class="fw-semibold mt-1">
                        @Model.TransferNumber
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">Transfer Date</label>
                    <div class="fw-semibold mt-1">
                        @Model.TransferDate.ToString("dd MMM yyyy")
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="text-muted small">Status</label>
                    <div class="mt-1">
                        <span class="badge bg-info-subtle text-info-emphasis border">
                            @Model.Status
                        </span>
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">From Warehouse</label>
                    <div class="fw-semibold mt-1">
                        @(Model.FromWarehouse?.Name ?? "Not available")
                    </div>
                </div>

                <div class="col-md-6">
                    <label class="text-muted small">To Warehouse</label>
                    <div class="fw-semibold mt-1">
                        @(Model.ToWarehouse?.Name ?? "Not available")
                    </div>
                </div>

                <div class="col-12">
                    <label class="text-muted small">Remarks</label>
                    <div class="mt-1">
                        @(string.IsNullOrWhiteSpace(Model.Remarks)
                                                ? "No remarks"
                                                : Model.Remarks)
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- TRANSFERRED PRODUCTS -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-box-seam text-primary me-2"></i>
                Transferred Products
            </h5>

            <span class="badge bg-primary-subtle text-primary-emphasis">
                @(Model.Items?.Count ?? 0) Items
            </span>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Product Title</th>
                            <th>Barcode</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Cost</th>
                            <th class="text-end pe-3">Total Cost</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            var index = 1;

                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="ps-3">@index</td>

                                    <!-- PRODUCT TITLE -->
                                    <td class="fw-semibold">
                                        @(item.Product?.Title ?? "—")
                                    </td>

                                    <!-- BARCODE -->
                                    <td>
                                        @(item.Product?.Barcode ?? "—")
                                    </td>

                                    <!-- QUANTITY -->
                                    <td class="text-end">
                                        @item.Quantity.ToString("N2")
                                    </td>

                                    <!-- UNIT COST -->
                                    <td class="text-end">
                                        @item.UnitCost.ToString("N2")
                                    </td>

                                    <!-- TOTAL COST -->
                                    <td class="text-end pe-3 fw-semibold">
                                        @((item.Quantity * item.UnitCost).ToString("N2"))
                                    </td>
                                </tr>

                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                    No products found for this transfer.
                                </td>
                            </tr>
                        }
                    </tbody>

                    @if (Model.Items != null && Model.Items.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <th colspan="3" class="text-end">
                                    Total
                                </th>

                                <th class="text-end">
                                    @Model.Items.Sum(x => x.Quantity).ToString("N2")
                                </th>

                                <th></th>

                                <th class="text-end pe-3">
                                    @Model.Items.Sum(x => x.Quantity * x.UnitCost).ToString("N2")
                                </th>
                            </tr>
                        </tfoot>
                    }

                </table>
            </div>
        </div>

        <div class="card-footer bg-white text-muted small">
            <i class="bi bi-info-circle me-1"></i>
            Unit costs and totals are displayed using the values saved on this transfer.
        </div>

    </div>

</div>
