@model IEnumerable<StoreManagementSystem.Domain.Entities.StockTransfer>

@{
    ViewData["Title"] = "Stock Transfers";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="card-header d-flex justify-content-between align-items-center">

        <h4 class="mb-0">
            <i class="bi bi-arrow-left-right me-1"></i>
            Stock Transfers
        </h4>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle me-1"></i>
            New Transfer

        </a>

    </div>


    <!-- =========================================================
         BODY
         ========================================================= -->

    <div class="card-body">

        <!-- =====================================================
             SUCCESS / ERROR MESSAGES
             ===================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-check-circle me-1"></i>

                @TempData["Success"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show"
                 role="alert">

                <i class="bi bi-exclamation-triangle me-1"></i>

                @TempData["Error"]

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="table-responsive">

            <table id="transferTable"
                   class="table table-bordered table-hover align-middle w-100">

                <thead class="table-light">

                    <tr>

                        <th>
                            Transfer No
                        </th>

                        <th>
                            Date
                        </th>

                        <th>
                            From Warehouse
                        </th>

                        <th>
                            To Warehouse
                        </th>

                        <th>
                            Status
                        </th>

                        <th>
                            Total Items
                        </th>

                        <th class="text-center"
                            style="width:220px;">

                            Action

                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string rowClass =
                            item.IsDeleted
                            ? "table-danger"
                            : "";

                            string transferNumber =
                            item.TransferNumber ?? "N/A";

                            <tr class="@rowClass">

                                <!-- =================================================
                                     TRANSFER NUMBER
                                     ================================================= -->

                                <td>

                                    @if (item.IsDeleted)
                                    {
                                        <strong class="text-danger">

                                            <i class="bi bi-trash me-1"></i>

                                            @transferNumber

                                        </strong>
                                    }
                                    else
                                    {
                                        <strong>

                                            @transferNumber

                                        </strong>
                                    }

                                </td>


                                <!-- =================================================
                                     DATE
                                     ================================================= -->

                                <td>

                                    @item.TransferDate.ToString("dd-MMM-yyyy")

                                </td>


                                <!-- =================================================
                                     FROM WAREHOUSE
                                     ================================================= -->

                                <td>

                                    <i class="bi bi-building me-1"></i>

                                    @(item.FromWarehouse?.Name ?? "N/A")

                                </td>


                                <!-- =================================================
                                     TO WAREHOUSE
                                     ================================================= -->

                                <td>

                                    <i class="bi bi-shop me-1"></i>

                                    @(item.ToWarehouse?.Name ?? "N/A")

                                </td>


                                <!-- =================================================
                                     STATUS
                                     ================================================= -->

                                <td>

                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-trash me-1"></i>

                                            Deleted / Reversed

                                        </span>
                                    }
                                    else if (
                                    item.Status ==
                                    StoreManagementSystem.Domain.Enums.StockTransferStatus.Completed)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Completed

                                        </span>
                                    }
                                    else if (
                                    item.Status ==
                                    StoreManagementSystem.Domain.Enums.StockTransferStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">

                                            <i class="bi bi-clock me-1"></i>

                                            Draft

                                        </span>
                                    }

                                </td>


                                <!-- =================================================
                                     TOTAL ITEMS
                                     ================================================= -->

                                <td>

                                    <span class="badge bg-secondary">

                                        @(item.Items?.Count ?? 0)

                                    </span>

                                </td>


                                <!-- =========================================================
                                ACTIONS
                                ========================================================= -->

                                <td class="text-center">

                                    <div class="btn-group" role="group">

                                        @if (item.IsDeleted)
                                        {
                                            <!-- =============================================
                                                 VIEW DELETED TRANSFER
                                                 ============================================= -->

                                            <a asp-controller="StockTransfer"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="View Deleted Transfer">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- =============================================
                                                 RESTORE
                                                 ============================================= -->

                                            <form asp-controller="StockTransfer"
                                                  asp-action="Restore"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirmTransferRestore('@transferNumber');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        title="Restore Transfer">

                                                    <i class="bi bi-arrow-counterclockwise"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- =============================================
                                                 VIEW
                                                 ============================================= -->

                                            <a asp-controller="StockTransfer"
                                               asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="View Transfer">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- =============================================
                                                 PRINT
                                                 ============================================= -->

                                            <a asp-controller="StockTransfer"
                                               asp-action="Print"
                                               asp-route-id="@item.Id"
                                               class="btn btn-secondary btn-sm"
                                               title="Print Transfer">

                                                <i class="bi bi-printer"></i>

                                            </a>


                                            <!-- =============================================
                                                 DELETE / REVERSE
                                                 ============================================= -->
                                            @if (
                                                                            item.Status ==
                                                                            StoreManagementSystem.Domain.Enums.StockTransferStatus.Completed)
                                            {
                                                <form asp-controller="StockTransfer"
                                                      asp-action="Delete"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirmTransferDelete('@transferNumber');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            title="Reverse and Delete Transfer">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>
                                            }
                                        }

                                    </div>

                                </td>

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        // =========================================================
        // DATATABLE
        // =========================================================

        $(document).ready(function () {

            $("#transferTable").DataTable({

                responsive: true,

                pageLength: 10,

                order: [
                    [1, "desc"]
                ],

                language: {

                    emptyTable:
                        "No stock transfers found.",

                    zeroRecords:
                        "No matching stock transfers found.",

                    search:
                        "Search:",

                    lengthMenu:
                        "Show _MENU_ transfers",

                    info:
                        "Showing _START_ to _END_ of _TOTAL_ transfers",

                    infoEmpty:
                        "No transfers available"

                }

            });

        });


        // =========================================================
        // DELETE CONFIRMATION
        // =========================================================

        function confirmTransferDelete(transferNumber)
        {
            return confirm(

                "Delete Stock Transfer " +
                transferNumber +
                "?\n\n" +

                "The transfer will NOT be permanently deleted.\n\n" +

                "The stock movement will be reversed:\n" +
                "• Stock will be returned to the source warehouse.\n" +
                "• Stock will be removed from the destination warehouse.\n" +
                "• A reversal entry will be added to the Stock Ledger.\n" +
                "• The transfer will be marked as Deleted / Reversed.\n\n" +

                "You can restore this transfer later.\n\n" +

                "Do you want to continue?"

            );
        }


        // =========================================================
        // RESTORE CONFIRMATION
        // =========================================================

        function confirmTransferRestore(transferNumber)
        {
            return confirm(

                "Restore Stock Transfer " +
                transferNumber +
                "?\n\n" +

                "The transfer will become active again.\n\n" +

                "The stock movement will be applied again:\n" +
                "• Stock will be removed from the source warehouse.\n" +
                "• Stock will be added to the destination warehouse.\n" +
                "• A restore entry will be added to the Stock Ledger.\n" +
                "• The transfer status will become Completed.\n\n" +

                "Do you want to continue?"

            );
        }

    </script>

}