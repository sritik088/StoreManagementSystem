@model IEnumerable<StoreManagementSystem.Domain.Entities.Brand>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Brand Management";
}

<div class="row mb-4">

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm bg-primary text-white">
            <div class="card-body">
                <h6>Total Brands</h6>
                <h2>@Model.Count()</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm bg-success text-white">
            <div class="card-body">
                <h6>Active Brands</h6>
                <h2>@Model.Count(x => x.IsActive)</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm bg-danger text-white">
            <div class="card-body">
                <h6>Inactive</h6>
                <h2>@Model.Count(x => !x.IsActive)</h2>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 mb-3">
        <div class="card border-0 shadow-sm bg-warning">
            <div class="card-body">
                <h6>Countries</h6>
                <h2>@Model.Select(x => x.Country).Distinct().Count()</h2>
            </div>
        </div>
    </div>

</div>

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h2 class="fw-bold">

            <i class="bi bi-tags-fill text-primary"></i>

            Brand Management

        </h2>

        <p class="text-muted">

            Manage all product brands.

        </p>

    </div>

    <a asp-action="Create" class="btn btn-primary">

        <i class="bi bi-plus-circle"></i>

        Add Brand

    </a>

</div>

<div class="card shadow border-0">

    <div class="card-body">

        <div class="table-responsive">

            <table id="brandTable" class="table table-hover align-middle">

                <thead class="table-dark">

                    <tr>

                        <th>ID</th>

                        <th>Logo</th>

                        <th>Name</th>

                        <th>Code</th>

                        <th>Country</th>

                        <th>Products</th>

                        <th>Status</th>

                        <th width="180">Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td>@item.Id</td>

                            @* <td>

                                @if (!string.IsNullOrEmpty(item.LogoPath))
                                {
                                    <img src="/uploads/brands/@item.LogoPath"
                                         width="45"
                                         height="45"
                                         class="rounded-circle border" />
                                }
                                else
                                {
                                    <img src="https://via.placeholder.com/45"
                                         class="rounded-circle border" />
                                }

                            </td> *@

                            <td>

                                <strong>@item.Name</strong>

                            </td>

                            <td>

                                @item.Code

                            </td>

                            <td>

                                @item.Country

                            </td>

                            <td>

                                <span class="badge bg-info">

                                    @(item.Products?.Count ?? 0)

                                </span>

                            </td>

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge bg-success">

                                        Active

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">

                                        Inactive

                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">

                                    <i class="bi bi-eye"></i>

                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">

                                    <i class="bi bi-pencil"></i>

                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="deleteForm d-inline">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </form>

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts{

    <partial name="_ValidationScriptsPartial" />

    <script>

        $(document).ready(function(){

        $("#brandTable").DataTable({

        responsive:true,

        pageLength:10,

        lengthMenu:[[10,25,50,100,-1],[10,25,50,100,"All"]],

        dom:'Bfrtip',

        buttons:[

        'copy',

        'csv',

        'excel',

        'pdf',

        'print'

        ]

        });

        });

        $(".deleteForm").submit(function(e){

        e.preventDefault();

        let form=this;

        Swal.fire({

        title:'Delete Brand?',

        text:'You cannot undo this action.',

        icon:'warning',

        showCancelButton:true,

        confirmButtonColor:'#dc3545',

        cancelButtonColor:'#6c757d',

        confirmButtonText:'Yes, Delete'

        }).then((result)=>{

        if(result.isConfirmed){

        form.submit();

        }

        });

        });

        @if (TempData["Success"] != null)
        {
            <text>

            toastr.success('@TempData["Success"]');

            </text>
        }

        @if (TempData["Error"] != null)
        {
            <text>

            toastr.error('@TempData["Error"]');

            </text>
        }

    </script>

}