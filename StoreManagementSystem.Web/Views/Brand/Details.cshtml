@model StoreManagementSystem.Domain.Entities.Brand

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Brand Details";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-eye-fill text-info"></i>
                Brand Details
            </h2>

            <p class="text-muted mb-0">
                View complete brand information.
            </p>
        </div>

        <div>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-warning">

                <i class="bi bi-pencil-square"></i>

                Edit

            </a>

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left"></i>

                Back

            </a>

        </div>

    </div>

    <div class="card shadow border-0">

        <div class="card-header bg-info text-white">

            <h5 class="mb-0">

                Brand Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Brand Name
                    </label>

                    <div class="form-control bg-light">
                        @Model.Name
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Brand Code
                    </label>

                    <div class="form-control bg-light">
                        @(string.IsNullOrEmpty(Model.Code) ? "-" : Model.Code)
                    </div>

                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Country
                    </label>

                    <div class="form-control bg-light">
                        @(string.IsNullOrEmpty(Model.Country) ? "-" : Model.Country)
                    </div>

                </div>

                <div class="col-md-6 mb-4">

                    <label class="form-label fw-bold">
                        Website
                    </label>

                    <div class="form-control bg-light">

                        @if (!string.IsNullOrEmpty(Model.Website))
                        {
                            <a href="@Model.Website"
                               target="_blank">
                                @Model.Website
                            </a>
                        }
                        else
                        {
                            <span>-</span>
                        }

                    </div>

                </div>

            </div>

            <div class="mb-4">

                <label class="form-label fw-bold">
                    Description
                </label>

                <div class="form-control bg-light"
                     style="min-height:100px">

                    @(string.IsNullOrEmpty(Model.Description)
                                        ? "No Description"
                                        : Model.Description)

                </div>

            </div>

            <div class="row">

                <div class="col-md-4 mb-3">

                    <label class="form-label fw-bold">
                        Status
                    </label>

                    <div>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success fs-6">

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger fs-6">

                                Inactive

                            </span>
                        }

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label fw-bold">
                        Created Date
                    </label>

                    <div class="form-control bg-light">

                        @Model.CreatedDate.ToString("dd MMM yyyy")

                    </div>

                </div>

                <div class="col-md-4 mb-3">

                    <label class="form-label fw-bold">
                        Updated Date
                    </label>

                    <div class="form-control bg-light">

                        @(Model.UpdatedDate?.ToString("dd MMM yyyy") ?? "-")

                    </div>

                </div>

            </div>

            <hr />

            <div class="row text-center">

                <div class="col-md-4">

                    <div class="card border-0 bg-light">

                        <div class="card-body">

                            <h4 class="text-primary">

                                @(Model.Products?.Count ?? 0)

                            </h4>

                            <small class="text-muted">

                                Products Using This Brand

                            </small>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card border-0 bg-light">

                        <div class="card-body">

                            <h4 class="text-success">

                                @Model.Id

                            </h4>

                            <small class="text-muted">

                                Brand ID

                            </small>

                        </div>

                    </div>

                </div>

                <div class="col-md-4">

                    <div class="card border-0 bg-light">

                        <div class="card-body">

                            <h4 class="text-warning">

                                ERP

                            </h4>

                            <small class="text-muted">

                                Commercial Ready

                            </small>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>