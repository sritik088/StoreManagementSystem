@using StoreManagementSystem.Infrastructure.Identity
@using StoreManagementSystem.Application.Interfaces
@using StoreManagementSystem.Domain.Entities

@inject ISystemSettingService SystemSettingService
@inject ISidebarMenuService SidebarMenuService


@{
    // =========================================================
    // SUPER ADMIN CHECK
    // =========================================================
    //
    // SuperAdmin bypasses permission checks.
    //
    // IMPORTANT:
    // SuperAdmin DOES NOT bypass system module settings.
    //
    // Therefore:
    //
    // Sales OFF     -> Sales hidden for everyone
    // Customers OFF -> Customers hidden for everyone
    //
    // =========================================================

    bool IsSuperAdmin =
        User.IsInRole(RoleConstants.SuperAdmin);


    // =========================================================
    // PERMISSION CHECK
    // =========================================================

    bool HasPermission(string? permission)
    {
        // -----------------------------------------------------
        // SUPER ADMIN
        // -----------------------------------------------------
        // SuperAdmin has access to every permitted menu item.
        // -----------------------------------------------------

        if (IsSuperAdmin)
        {
            return true;
        }


        // -----------------------------------------------------
        // NO PERMISSION DEFINED
        // -----------------------------------------------------
        //
        // If a menu item does not require a permission,
        // authenticated users can see it.
        //
        // -----------------------------------------------------

        if (string.IsNullOrWhiteSpace(permission))
        {
            return true;
        }


        // -----------------------------------------------------
        // NORMAL USER
        // -----------------------------------------------------

        return User.Claims.Any(x =>
            x.Type == PermissionClaim.Type &&
            x.Value == permission);
    }


    // =========================================================
    // SYSTEM SETTINGS
    // =========================================================

    var locationLabel =
        await SystemSettingService.GetLocationLabelAsync();

    var locationPluralLabel =
        await SystemSettingService.GetLocationPluralLabelAsync();

    var salesOrderEnabled =
        await SystemSettingService.IsSalesOrderEnabledAsync();

    var salesOrderPluralLabel =
        await SystemSettingService.GetSalesOrderPluralLabelAsync();

    var customersEnabled =
        await SystemSettingService.GetCustomersEnabledAsync();


    // =========================================================
    // DEFAULT LABELS
    // =========================================================

    if (string.IsNullOrWhiteSpace(locationLabel))
    {
        locationLabel = "Warehouse";
    }

    if (string.IsNullOrWhiteSpace(locationPluralLabel))
    {
        locationPluralLabel = "Warehouses";
    }

    if (string.IsNullOrWhiteSpace(salesOrderPluralLabel))
    {
        salesOrderPluralLabel = "Sales Orders";
    }


    // =========================================================
    // LOAD SIDEBAR FROM DATABASE
    // =========================================================

    var sections =
        await SidebarMenuService.GetSectionsAsync();


    // =========================================================
    // DYNAMIC MENU LABELS
    // =========================================================

    foreach (var menuSection in sections)
    {
        foreach (var menuItem in menuSection.Items)
        {
            // -------------------------------------------------
            // WAREHOUSE LABEL
            // -------------------------------------------------

            if (menuItem.Controller == "Warehouse")
            {
                menuItem.Name =
                    locationPluralLabel;
            }


            // -------------------------------------------------
            // WAREHOUSE STOCK LABEL
            // -------------------------------------------------

            if (menuItem.Controller == "WarehouseStock")
            {
                menuItem.Name =
                    $"{locationLabel} Stock";
            }


            // -------------------------------------------------
            // SALES ORDER LABEL
            // -------------------------------------------------

            if (menuItem.Controller == "SalesOrder")
            {
                menuItem.Name =
                    salesOrderPluralLabel;
            }


            // -------------------------------------------------
            // SALES REPORT LABEL
            // -------------------------------------------------

            if (menuItem.Controller == "Reports" &&
                menuItem.Action == "Sales")
            {
                menuItem.Name =
                    $"{salesOrderPluralLabel} Report";
            }
        }
    }


    // =========================================================
    // MODULE ENABLE / DISABLE CHECK
    // =========================================================
    //
    // IMPORTANT:
    //
    // Module settings apply to EVERYONE, including SuperAdmin.
    //
    // SuperAdmin bypasses permission checks through
    // HasPermission(), but cannot bypass these module settings.
    //
    // =========================================================

    bool IsModuleEnabled(SidebarMenuItem menuItem)
    {
        // =====================================================
        // CUSTOMER MODULE
        // =====================================================

        if (menuItem.Controller == "Customer")
        {
            return customersEnabled;
        }


        // Customer Outstanding

        if (menuItem.Controller == "CustomerOutstanding")
        {
            return customersEnabled;
        }


        // Customer Receipts

        if (menuItem.Controller == "CustomerReceipts")
        {
            return customersEnabled;
        }


        // Customer Ledger

        if (menuItem.Controller == "CustomerLedger")
        {
            return customersEnabled;
        }


        // Accounts Receivable

        if (menuItem.Controller == "AccountsReceivable")
        {
            return customersEnabled;
        }


        // Customer Report

        if (menuItem.Controller == "Reports" &&
            menuItem.Action == "Customers")
        {
            return customersEnabled;
        }


        // =====================================================
        // SALES MODULE
        // =====================================================

        if (menuItem.Controller == "SalesOrder")
        {
            return salesOrderEnabled;
        }


        // Delivery Note

        if (menuItem.Controller == "DeliveryNote")
        {
            return salesOrderEnabled;
        }


        // Sales Invoice

        if (menuItem.Controller == "SalesInvoice")
        {
            return salesOrderEnabled;
        }


        // Sales Report

        if (menuItem.Controller == "Reports" &&
            menuItem.Action == "Sales")
        {
            return salesOrderEnabled;
        }


        // =====================================================
        // EVERYTHING ELSE
        // =====================================================

        return true;
    }
}


<!-- =========================================================
     SIDEBAR
     ========================================================= -->

<div class="sidebar">


    @foreach (var menuSection in sections
        .Where(x => x.IsActive)
        .OrderBy(x => x.DisplayOrder)
        .ThenBy(x => x.Id))
    {

        // =====================================================
        // FILTER VISIBLE ITEMS
        // =====================================================

        var visibleItems =
        menuSection.Items
        .Where(menuItem =>
        menuItem.IsActive &&
        HasPermission(menuItem.Permission) &&
        IsModuleEnabled(menuItem))
        .OrderBy(menuItem => menuItem.DisplayOrder)
        .ThenBy(menuItem => menuItem.Id)
        .ToList();


        // =====================================================
        // HIDE EMPTY SECTION
        // =====================================================

        if (!visibleItems.Any())
        {
            continue;
        }


        // =====================================================
        // SECTION HEADING
        // =====================================================

        <div class="sidebar-heading mt-3">

            @menuSection.Name

        </div>


        // =====================================================
        // MENU ITEMS
        // =====================================================

        <ul class="nav flex-column">

            @foreach (var menuItem in visibleItems)
            {
                <li class="nav-item">

                    <a asp-controller="@menuItem.Controller"
                       asp-action="@menuItem.Action"
                       class="nav-link">

                        @if (!string.IsNullOrWhiteSpace(menuItem.Icon))
                        {
                            <i class="bi @menuItem.Icon me-2"></i>
                        }

                        <span>
                            @menuItem.Name
                        </span>

                    </a>

                </li>
            }

        </ul>
    }

</div>