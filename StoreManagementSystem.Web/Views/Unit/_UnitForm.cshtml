@model StoreManagementSystem.Web.ViewModels.Unit.UnitViewModel

<div class="row">

    <div class="col-md-6 mb-3">

        <label asp-for="Name" class="form-label"></label>

        <input asp-for="Name" class="form-control" placeholder="Enter Unit Name" />

        <span asp-validation-for="Name" class="text-danger"></span>

    </div>

    <div class="col-md-6 mb-3">

        <label asp-for="ShortName" class="form-label"></label>

        <input asp-for="ShortName" class="form-control" placeholder="Kg, Ltr, Pcs..." />

        <span asp-validation-for="ShortName" class="text-danger"></span>

    </div>

</div>

<div class="mb-3">

    <label asp-for="Description" class="form-label"></label>

    <textarea asp-for="Description"
              class="form-control"
              rows="4"
              placeholder="Enter Description"></textarea>

    <span asp-validation-for="Description" class="text-danger"></span>

</div>

<div class="form-check form-switch mb-3">

    <input asp-for="IsActive"
           class="form-check-input" />

    <label asp-for="IsActive"
           class="form-check-label"></label>

</div>