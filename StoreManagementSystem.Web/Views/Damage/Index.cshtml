@model IEnumerable<StoreManagementSystem.Domain.Entities.Damage>

@{
    ViewData["Title"] = "Damage Master";
    Layout = "_AdminLayout";

    var damageTypes = Model.ToList();
    var total = damageTypes.Count;
    var active = damageTypes.Count(x => x.IsActive);
    var inactive = damageTypes.Count(x => !x.IsActive);
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-exclamation-triangle me-2"></i>
                Damage Master
            </h2>
            <p class="text-muted mb-0">
                Manage inventory damage types and reasons
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Add Damage Type
        </a>
    </div>

    <!-- Alerts -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Total Damage Types</div>
                        <h3 class="fw-bold mb-0">@total</h3>
                    </div>
                    <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                        <i class="bi bi-list-check fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Active</div>
                        <h3 class="fw-bold text-success mb-0">@active</h3>
                    </div>
                    <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                        <i class="bi bi-check-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-xl-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small mb-1">Inactive</div>
                        <h3 class="fw-bold text-secondary mb-0">@inactive</h3>
                    </div>
                    <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3">
                        <i class="bi bi-pause-circle fs-4"></i>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Damage Types Table -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <h5 class="fw-bold mb-0">Damage Types</h5>
                <span class="text-muted small">
                    @total record(s)
                </span>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">#</th>
                            <th>Damage Code</th>
                            <th>Damage Name</th>
                            <th>Description</th>
                            <th class="text-center">Status</th>
                            <th>Created</th>
                            <th class="text-center pe-4">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (damageTypes.Count > 0)
                        {
                            var number = 1;

                            @foreach (var item in damageTypes)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">
                                        @number
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.DamageCode
                                        </span>
                                    </td>

                                    <td>
                                        <span class="fw-semibold">
                                            @item.DamageName
                                        </span>
                                    </td>

                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <span class="text-muted">
                                                @item.Description
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>

                                    <td>
                                        <div>
                                            @item.CreatedDate.ToString("dd-MMM-yyyy")
                                        </div>
                                        <small class="text-muted">
                                            @item.CreatedDate.ToString("hh:mm tt")
                                        </small>
                                    </td>

                                    <td class="text-center pe-4">
                                        <div class="d-inline-flex align-items-center gap-1">

                                            <!-- Edit -->
                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit damage type"
                                               aria-label="Edit damage type">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <!-- Toggle Status -->
                                            <form asp-action="ToggleStatus"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm @(item.IsActive ? "btn-outline-warning" : "btn-outline-success")"
                                                        title="@(item.IsActive ? "Deactivate" : "Activate")"
                                                        aria-label="@(item.IsActive ? "Deactivate damage type" : "Activate damage type")">

                                                    <i class="bi @(item.IsActive ? "bi-pause-circle" : "bi-play-circle")"></i>
                                                </button>
                                            </form>

                                            <!-- Delete -->
                                            <form asp-action="Delete"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this damage type?');">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@item.Id" />

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete damage type"
                                                        aria-label="Delete damage type">

                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>

                                number++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="bi bi-inbox fs-1 d-block mb-3"></i>

                                        <h6 class="fw-semibold">
                                            No damage types found
                                        </h6>

                                        <p class="mb-3">
                                            Create your first damage type to get started.
                                        </p>

                                        <a asp-action="Create" class="btn btn-primary">
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Add Damage Type
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

</div>