@model StoreManagementSystem.Domain.Entities.Damage

@{
    ViewData["Title"] = "Create Damage Type";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    ```
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-plus-circle me-2"></i>
                Create Damage Type
            </h2>

            <p class="text-muted mb-0">
                Add a new inventory damage type
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back

        </a>

    </div>


    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white border-0 py-3">

            <h5 class="fw-bold mb-0">
                Damage Type Information
            </h5>

        </div>


        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="row g-4">

                    <!-- Damage Code -->

                    <div class="col-md-6">

                        <label asp-for="DamageCode"
                               class="form-label fw-semibold">

                            Damage Code
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="DamageCode"
                               class="form-control"
                               placeholder="Example: DMG001"
                               maxlength="50" />

                        <span asp-validation-for="DamageCode"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Damage Name -->

                    <div class="col-md-6">

                        <label asp-for="DamageName"
                               class="form-label fw-semibold">

                            Damage Name
                            <span class="text-danger">*</span>

                        </label>

                        <input asp-for="DamageName"
                               class="form-control"
                               placeholder="Example: Broken"
                               maxlength="100" />

                        <span asp-validation-for="DamageName"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- Description -->

                    <div class="col-12">

                        <label asp-for="Description"
                               class="form-label fw-semibold">

                            Description

                        </label>

                        <textarea asp-for="Description"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Describe this damage type..."></textarea>

                    </div>


                    <!-- Active -->

                    <div class="col-md-6">

                        <div class="form-check form-switch mt-2">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-semibold">

                                Active

                            </label>

                        </div>

                        <small class="text-muted">
                            Inactive damage types will not appear in Damage Entry.
                        </small>

                    </div>

                </div>


                <hr class="my-4" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-check-lg me-1"></i>
                        Save Damage Type

                    </button>

                </div>

            </form>

        </div>

    </div>
    ```

</div>

@section Scripts {

    ```
    <partial name="_ValidationScriptsPartial" />
    ```

}
