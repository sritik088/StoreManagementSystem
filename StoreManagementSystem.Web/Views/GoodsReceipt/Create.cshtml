
@model StoreManagementSystem.Web.ViewModels.GoodsReceipt.GoodsReceiptViewModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Purchase Goods Receipt";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <div class="card shadow-sm">
        <div class="card-header bg-success text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="bi bi-cart-check me-2"></i>
                    Purchase Goods Receipt Note
                </h4>
                <span class="badge bg-light text-success">Purchase GRN</span>
            </div>
        </div>

        <div class="card-body">

            <form asp-controller="GoodsReceipt"
                  asp-action="Create"
                  method="post"
                  id="purchaseReceiptForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <div class="row g-3">

                    <div class="col-md-5">
                        <label asp-for="PurchaseOrderId" class="form-label fw-semibold">
                            Purchase Order <span class="text-danger">*</span>
                        </label>

                        <select asp-for="PurchaseOrderId"
                                asp-items="Model.PurchaseOrders"
                                class="form-select"
                                id="PurchaseOrderId">
                            <option value="">-- Select Purchase Order --</option>
                        </select>

                        <span asp-validation-for="PurchaseOrderId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Supplier</label>
                        <input type="text"
                               id="SupplierName"
                               class="form-control"
                               readonly
                               placeholder="Supplier will appear here" />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="ReceiptDate" class="form-label fw-semibold">
                            Receipt Date <span class="text-danger">*</span>
                        </label>

                        <input asp-for="ReceiptDate"
                               type="date"
                               class="form-control"
                               id="ReceiptDate" />

                        <span asp-validation-for="ReceiptDate"
                              class="text-danger"></span>
                    </div>

                </div>

                <div id="poLoading" class="alert alert-info mt-4 d-none">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    Loading Purchase Order items...
                </div>

                <div id="poError" class="alert alert-danger mt-4 d-none"></div>

                <div class="mt-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0">
                            <i class="bi bi-box-seam me-2"></i>
                            Purchase Order Items
                        </h5>

                        <span class="badge bg-secondary" id="itemCount">0 Items</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle"
                               id="purchaseItemTable">

                            <thead class="table-dark">
                                <tr>
                                    <th style="min-width:220px;">Product Title</th>
                                    <th style="min-width:140px;">SKU</th>
                                    <th>Ordered</th>
                                    <th>Previously Received</th>
                                    <th>Remaining</th>
                                    <th style="min-width:130px;">Receive Qty</th>
                                    <th style="min-width:180px;">Warehouse</th>
                                    <th>Unit Price</th>
                                    <th>Discount</th>
                                    <th>Tax</th>
                                    <th>Total</th>
                                </tr>
                            </thead>

                            <tbody id="purchaseItemTableBody"></tbody>
                        </table>
                    </div>

                    <div id="noPurchaseItems"
                         class="text-center text-muted py-4 border rounded">
                        <i class="bi bi-info-circle me-1"></i>
                        Select a Purchase Order to load items.
                    </div>

                </div>

                <div class="card mt-4">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator me-2"></i>
                            Purchase Receipt Summary
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <div class="col-md-3">
                                <label class="form-label">Subtotal</label>
                                <input type="text"
                                       id="SubTotalDisplay"
                                       class="form-control"
                                       value="₹0.00"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Tax</label>
                                <input type="text"
                                       id="TaxAmountDisplay"
                                       class="form-control"
                                       value="₹0.00"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Discount</label>
                                <input type="text"
                                       id="DiscountDisplay"
                                       class="form-control"
                                       value="₹0.00"
                                       readonly />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label fw-bold">Grand Total</label>
                                <input type="text"
                                       id="GrandTotalDisplay"
                                       class="form-control fw-bold"
                                       value="₹0.00"
                                       readonly />
                            </div>

                        </div>

                        <div class="mt-4">
                            <label asp-for="Remarks" class="form-label">Remarks</label>
                            <textarea asp-for="Remarks"
                                      class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      placeholder="Enter remarks..."></textarea>
                            <span asp-validation-for="Remarks"
                                  class="text-danger"></span>
                        </div>

                    </div>
                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn btn-success"
                            id="savePurchaseButton">
                        <i class="bi bi-check-circle me-1"></i>
                        Save Purchase GRN
                    </button>

                    <a asp-controller="GoodsReceipt"
                       asp-action="Index"
                       class="btn btn-secondary">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {

            // Warehouse dropdown data supplied by the controller.
            var warehouses = @Html.Raw(
                System.Text.Json.JsonSerializer.Serialize(
                    (Model.Warehouses ?? Enumerable.Empty<SelectListItem>())
                    .Select(x => new {
                        id = x.Value,
                        name = x.Text
                    })
                )
            );

            $("#PurchaseOrderId").on("change", function () {
                var purchaseOrderId = $(this).val();

                clearPurchaseItems();
                $("#SupplierName").val("");
                $("#poError").addClass("d-none").text("");

                if (purchaseOrderId) {
                    loadPurchaseOrder(purchaseOrderId);
                }
            });

            function loadPurchaseOrder(purchaseOrderId) {
                $("#poLoading").removeClass("d-none");
                $("#poError").addClass("d-none").text("");
                $("#PurchaseOrderId").prop("disabled", true);

                $.ajax({
                    url: '@Url.Action("GetPurchaseOrder", "GoodsReceipt")',
                    type: "GET",
                    data: { id: purchaseOrderId },

                    success: function (response) {
                        $("#SupplierName").val(response.supplier || "");
                        renderPurchaseItems(response.items || []);
                    },

                    error: function (xhr) {
                        var message = "Unable to load Purchase Order.";

                        if (xhr.responseText &&
                            xhr.responseText.length < 500) {
                            message = xhr.responseText;
                        }

                        $("#poError").removeClass("d-none").text(message);
                        clearPurchaseItems();
                    },

                    complete: function () {
                        $("#poLoading").addClass("d-none");
                        $("#PurchaseOrderId").prop("disabled", false);
                    }
                });
            }

            function renderPurchaseItems(items) {
                $("#purchaseItemTableBody").empty();

                if (!items || items.length === 0) {
                    $("#noPurchaseItems")
                        .show()
                        .html(
                            '<i class="bi bi-check-circle me-1"></i>' +
                            'All Purchase Order items have already been received.'
                        );

                    updateItemCount();
                    calculateTotals();
                    return;
                }

                $("#noPurchaseItems").hide();

                $.each(items, function (index, item) {
                    addPurchaseItemRow(index, item);
                });

                updateItemCount();
                calculateTotals();
            }

            function getWarehouseOptions() {
                var options =
                    '<option value="">-- Select Warehouse --</option>';

                $.each(warehouses, function (_, warehouse) {
                    options +=
                        '<option value="' + escapeHtml(warehouse.id) + '">' +
                        escapeHtml(warehouse.name) +
                        '</option>';
                });

                return options;
            }

            // Product Title and SKU are displayed in separate columns.
            function addPurchaseItemRow(index, item) {
                var purchaseOrderItemId = item.purchaseOrderItemId || 0;
                var productId = item.productId || 0;
                var productTitle = item.productTitle || item.productName || "";
                var sku = item.sku || "";

                var orderedQty = parseFloat(item.orderedQty) || 0;
                var previouslyReceivedQty =
                    parseFloat(item.previouslyReceivedQty) || 0;
                var remainingQty = parseFloat(item.remainingQty) || 0;

                var unitPrice = parseFloat(item.price) || 0;
                var tax = parseFloat(item.tax) || 0;
                var discount = parseFloat(item.discount) || 0;

                var row = `
                    <tr>
                        <td>
                            <input type="hidden"
                                   name="Items[${index}].ProductName"
                                   value="${escapeHtml(productTitle)}" />
                            <span class="fw-semibold">
                                ${escapeHtml(productTitle || "—")}
                            </span>
                        </td>

                        <td>
                            <input type="hidden"
                                   name="Items[${index}].SKU"
                                   value="${escapeHtml(sku)}" />
                            <span class="badge bg-light text-dark border">
                                ${escapeHtml(sku || "—")}
                            </span>
                        </td>

                        <td>
                            <input type="hidden"
                                   name="Items[${index}].PurchaseOrderItemId"
                                   value="${escapeHtml(purchaseOrderItemId)}" />
                            <input type="hidden"
                                   name="Items[${index}].ProductId"
                                   value="${escapeHtml(productId)}" />
                            <input type="hidden"
                                   name="Items[${index}].OrderedQuantity"
                                   value="${escapeHtml(orderedQty)}" />
                            ${formatNumber(orderedQty)}
                        </td>

                        <td>${formatNumber(previouslyReceivedQty)}</td>

                        <td>
                            <span class="badge bg-info text-dark remainingQty">
                                ${formatNumber(remainingQty)}
                            </span>
                        </td>

                        <td>
                            <input type="number"
                                   class="form-control receiveQuantity"
                                   name="Items[${index}].ReceivedQuantity"
                                   value=""
                                   min="0"
                                   max="${remainingQty}"
                                   step="0.01"
                                   placeholder="0" />
                            <div class="text-danger small quantityError"></div>
                        </td>

                        <td>
                            <select class="form-select warehouseSelect"
                                    name="Items[${index}].WarehouseId">
                                ${getWarehouseOptions()}
                            </select>
                            <div class="text-danger small warehouseError"></div>
                        </td>

                        <td>
                            <input type="hidden"
                                   name="Items[${index}].UnitPrice"
                                   value="${escapeHtml(unitPrice)}"
                                   class="unitPriceHidden" />
                            <span>₹${formatMoney(unitPrice)}</span>
                        </td>

                        <td>
                            <input type="hidden"
                                   name="Items[${index}].Discount"
                                   value="${escapeHtml(discount)}"
                                   class="discountHidden" />
                            <span>₹${formatMoney(discount)}</span>
                        </td>

                        <td>
                            <input type="hidden"
                                   name="Items[${index}].TaxAmount"
                                   value="${escapeHtml(tax)}"
                                   class="taxHidden" />
                            <span>₹${formatMoney(tax)}</span>
                        </td>

                        <td>
                            <input type="text"
                                   class="form-control rowTotal"
                                   value="₹0.00"
                                   readonly />
                        </td>
                    </tr>`;

                $("#purchaseItemTableBody").append(row);
            }

            $(document).on("input", ".receiveQuantity", function () {
                var input = $(this);
                var row = input.closest("tr");
                var quantity = parseFloat(input.val()) || 0;
                var remaining = parseFloat(row.find(".remainingQty").text()) || 0;

                if (quantity < 0) {
                    input.val("");
                    quantity = 0;
                }

                if (quantity > remaining) {
                    input.addClass("is-invalid");
                    row.find(".quantityError")
                        .text("Receive quantity cannot exceed remaining quantity.");
                } else {
                    input.removeClass("is-invalid");
                    row.find(".quantityError").text("");
                }

                calculateRowTotal(row);
                calculateTotals();
            });

            $(document).on("change", ".warehouseSelect", function () {
                var select = $(this);
                var row = select.closest("tr");

                select.toggleClass("is-invalid", !select.val());
                row.find(".warehouseError")
                    .text(select.val() ? "" : "Please select a warehouse.");
            });

            function calculateRowTotal(row) {
                var quantity = parseFloat(row.find(".receiveQuantity").val()) || 0;
                var unitPrice = parseFloat(row.find(".unitPriceHidden").val()) || 0;
                var discount = parseFloat(row.find(".discountHidden").val()) || 0;
                var tax = parseFloat(row.find(".taxHidden").val()) || 0;
                var ordered = parseFloat(row.find("td:nth-child(3)").text()) || 0;

                var ratio = ordered > 0 ? quantity / ordered : 0;
                var gross = quantity * unitPrice;
                var lineDiscount = discount * ratio;
                var lineTax = tax * ratio;
                var total = Math.max(0, gross - lineDiscount + lineTax);

                row.find(".rowTotal").val("₹" + formatMoney(total));
            }

            function calculateTotals() {
                var subtotal = 0;
                var taxAmount = 0;
                var discount = 0;

                $("#purchaseItemTableBody tr").each(function () {
                    var row = $(this);
                    var quantity =
                        parseFloat(row.find(".receiveQuantity").val()) || 0;
                    var unitPrice =
                        parseFloat(row.find(".unitPriceHidden").val()) || 0;
                    var ordered =
                        parseFloat(row.find("td:nth-child(3)").text()) || 0;
                    var totalDiscount =
                        parseFloat(row.find(".discountHidden").val()) || 0;
                    var totalTax =
                        parseFloat(row.find(".taxHidden").val()) || 0;

                    var ratio = ordered > 0 ? quantity / ordered : 0;

                    subtotal += quantity * unitPrice;
                    discount += totalDiscount * ratio;
                    taxAmount += totalTax * ratio;

                    calculateRowTotal(row);
                });

                var grandTotal = Math.max(0, subtotal - discount + taxAmount);

                $("#SubTotalDisplay").val("₹" + formatMoney(subtotal));
                $("#TaxAmountDisplay").val("₹" + formatMoney(taxAmount));
                $("#DiscountDisplay").val("₹" + formatMoney(discount));
                $("#GrandTotalDisplay").val("₹" + formatMoney(grandTotal));
            }

            function clearPurchaseItems() {
                $("#purchaseItemTableBody").empty();

                $("#noPurchaseItems")
                    .show()
                    .html(
                        '<i class="bi bi-info-circle me-1"></i>' +
                        'Select a Purchase Order to load items.'
                    );

                updateItemCount();
                calculateTotals();
            }

            function updateItemCount() {
                var count = $("#purchaseItemTableBody tr").length;

                $("#itemCount").text(
                    count + (count === 1 ? " Item" : " Items")
                );
            }

            $("#purchaseReceiptForm").on("submit", function (event) {
                var hasError = false;
                var hasReceiveQuantity = false;

                var purchaseOrder = $("#PurchaseOrderId");

                if (!purchaseOrder.val()) {
                    hasError = true;
                    purchaseOrder.addClass("is-invalid");
                } else {
                    purchaseOrder.removeClass("is-invalid");
                }

                $("#purchaseItemTableBody tr").each(function () {
                    var row = $(this);
                    var quantityInput = row.find(".receiveQuantity");
                    var warehouse = row.find(".warehouseSelect");

                    var quantity = parseFloat(quantityInput.val()) || 0;
                    var remaining =
                        parseFloat(row.find(".remainingQty").text()) || 0;

                    if (quantity > 0) {
                        hasReceiveQuantity = true;
                    }

                    if (quantity < 0 || quantity > remaining) {
                        hasError = true;
                        quantityInput.addClass("is-invalid");
                        row.find(".quantityError").text(
                            quantity > remaining
                                ? "Receive quantity cannot exceed remaining quantity."
                                : "Quantity cannot be negative."
                        );
                    } else {
                        quantityInput.removeClass("is-invalid");
                        row.find(".quantityError").text("");
                    }

                    if (quantity > 0 && !warehouse.val()) {
                        hasError = true;
                        warehouse.addClass("is-invalid");
                        row.find(".warehouseError")
                            .text("Please select a warehouse.");
                    } else {
                        warehouse.removeClass("is-invalid");
                        row.find(".warehouseError").text("");
                    }
                });

                if (!hasReceiveQuantity) {
                    hasError = true;
                    alert("Please enter at least one Receive Quantity.");
                }

                if (hasError) {
                    event.preventDefault();
                    return false;
                }

                return true;
            });

            function formatNumber(value) {
                return (parseFloat(value) || 0).toFixed(2);
            }

            function formatMoney(value) {
                return (parseFloat(value) || 0).toLocaleString("en-IN", {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            }

            function escapeHtml(value) {
                if (value === null || value === undefined) {
                    return "";
                }

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            clearPurchaseItems();
        });
    </script>
}
