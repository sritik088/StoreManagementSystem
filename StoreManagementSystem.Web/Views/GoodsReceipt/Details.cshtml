@model StoreManagementSystem.Web.ViewModels.GoodsReceipt.GoodsReceiptViewModel

@using StoreManagementSystem.Domain.Enums

@{
    ViewData["Title"] = "Goods Receipt Details";
    Layout = "_AdminLayout";

    var isGift = Model.ReceiptType == GoodsReceiptType.Gift;

    var receiptTypeText = isGift ? "Gift Receipt" : "Purchase Receipt";

    var receiptTypeClass = isGift
        ? "bg-success-subtle text-success"
        : "bg-primary-subtle text-primary";

    var statusText = "Received";
    var items = Model.Items ?? new List<
        StoreManagementSystem.Web.ViewModels.GoodsReceipt.GoodsReceiptItemViewModel>();

    // #, Product Title, SKU, Ordered, Received, Total = 7 columns for gifts.
    // Purchase receipts have 3 additional price columns = 10 columns.
    var columnCount = isGift ? 7 : 10;
}

<link rel="stylesheet"
      href="~/css/goods-receipt-details.css"
      asp-append-version="true" />

<div class="container-fluid grn-details-page">
    <div class="card shadow-sm grn-card">

        <!-- HEADER -->
        <div class="grn-header">
            <div class="d-flex flex-column flex-md-row
                        justify-content-between align-items-md-center gap-3">

                <div>
                    <h1 class="grn-title">Goods Receipt Details</h1>

                    <div class="grn-subtitle">
                        GRN Number:
                        <span class="grn-number">
                            @(string.IsNullOrWhiteSpace(Model.GRNNumber)
                                                        ? "—"
                                                        : Model.GRNNumber)
                        </span>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="grn-badge @receiptTypeClass">
                        @if (isGift)
                        {
                            <i class="bi bi-gift"></i>
                        }
                        else
                        {
                            <i class="bi bi-box-seam"></i>
                        }

                        @receiptTypeText
                    </span>

                    <span class="grn-badge badge-received">
                        <i class="bi bi-check-circle"></i>
                        @statusText
                    </span>
                </div>
            </div>
        </div>

        <!-- RECEIPT INFORMATION -->
        <div class="info-section">
            <div class="section-title">Receipt Information</div>

            <div class="row g-3">
                <div class="col-6 col-md-4 col-xl-3">
                    <div class="info-box">
                        <span class="info-label">GRN Number</span>
                        <div class="info-value">
                            @(string.IsNullOrWhiteSpace(Model.GRNNumber)
                                                        ? "—"
                                                        : Model.GRNNumber)
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="info-box">
                        <span class="info-label">Receipt Date</span>
                        <div class="info-value">
                            @Model.ReceiptDate.ToString("dd MMM yyyy")
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="info-box">
                        <span class="info-label">Receipt Type</span>
                        <div class="info-value">@receiptTypeText</div>
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-3">
                    <div class="info-box">
                        <span class="info-label">Status</span>
                        <div class="info-value">@statusText</div>
                    </div>
                </div>

                @if (isGift)
                {
                    <div class="col-12 col-md-6">
                        <div class="info-box">
                            <span class="info-label">Donor Name</span>
                            <div class="info-value @(string.IsNullOrWhiteSpace(Model.DonorName) ? "muted" : "")">
                                @(string.IsNullOrWhiteSpace(Model.DonorName)
                                                            ? "—"
                                                            : Model.DonorName)
                                                                          </div>
                                                                      </div>
                                                                  </div>

                    <div class="col-12 col-md-6">
                        <div class="info-box">
                            <span class="info-label">Gift Reason</span>
                            <div class="info-value @(string.IsNullOrWhiteSpace(Model.GiftReason) ? "muted" : "")">
                                @(string.IsNullOrWhiteSpace(Model.GiftReason)
                                                            ? "—"
                                                            : Model.GiftReason)
                        </div>
                    </div>
                </div>
                                }
                else
                {
                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="info-box">
                            <span class="info-label">Supplier</span>
                            <div class="info-value @(string.IsNullOrWhiteSpace(Model.SupplierName) ? "muted" : "")">
                                @(string.IsNullOrWhiteSpace(Model.SupplierName)
                                                            ? "—"
                                                            : Model.SupplierName)
                                                                             </div>
                                                                         </div>
                                                                     </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="info-box">
                            <span class="info-label">Purchase Order</span>
                            <div class="info-value">
                                @(Model.PurchaseOrderId > 0
                                                            ? $"PO #{Model.PurchaseOrderId}"
                                                            : "—")
                                                              </div>
                                                          </div>
                                                      </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="info-box">
                            <span class="info-label">Invoice Number</span>
                            <div class="info-value muted">—</div>
                        </div>
                    </div>

                    <div class="col-12 col-md-6 col-xl-3">
                        <div class="info-box">
                            <span class="info-label">Supplier ID</span>
                            <div class="info-value">
                                @(Model.SupplierId > 0
                                                            ? Model.SupplierId.ToString()
                                                            : "—")
                        </div>
                    </div>
                </div>
                                }
            </div>
        </div>

        <!-- RECEIVED ITEMS -->
        <div class="items-section">
            <div class="section-title">Received Items</div>

            <div class="items-table-wrapper">
                <table class="items-table">
                    <thead>
                        <tr>
                            <th class="item-number">#</th>
                            <th>Product Title</th>
                            <th>SKU</th>
                            <th class="text-end">Ordered</th>
                            <th class="text-end">Received</th>

                            @if (!isGift)
                            {
                                <th class="text-end">Unit Price</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Tax</th>
                            }

                            <th class="text-end">Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (items.Any())
                        {
                            var rowNumber = 1;

                            foreach (var item in items)
                            {
                                <tr>
                                    <td class="item-number">
                                        @rowNumber
                                    </td>

                                    <td>
                                        <div class="product-name">
                                            @(string.IsNullOrWhiteSpace(item.ProductName)
                                                                                ? "Unknown Product"
                                                                                : item.ProductName)
                                                                                               </div>
                                                                                           </td>

                                    <td>
                                        <span class="product-sku">
                                            @(string.IsNullOrWhiteSpace(item.SKU)
                                                                                ? "—"
                                                                                : item.SKU)
                                </span>
                            </td>

                                    <td class="money">
                                        <span class="quantity">
                                            @item.OrderedQuantity.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="money">
                                        <span class="quantity">
                                            @item.ReceivedQuantity.ToString("N2")
                                        </span>
                                    </td>

                            @if (!isGift)
                                    {
                                        <td class="money">
                                            ₹@item.UnitPrice.ToString("N2")
                                        </td>

                                        <td class="money">
                                            ₹@item.Discount.ToString("N2")
                                        </td>

                                        <td class="money">
                                            ₹@item.TaxAmount.ToString("N2")
                                        </td>

                                        <td class="money total-cell">
                                            ₹@item.Total.ToString("N2")
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="money total-cell">
                                            ₹0.00
                                        </td>
                                    }
                                </tr>

                                rowNumber++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@columnCount"
                                    class="text-center text-muted py-4">
                                    No items found in this goods receipt.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- TOTAL SUMMARY -->
        <div class="summary-wrapper">
            <div class="summary-box">
                <div class="summary-row">
                    <span class="summary-label">Subtotal</span>
                    <span class="summary-value">
                        ₹@Model.SubTotal.ToString("N2")
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Discount</span>
                    <span class="summary-value">
                        ₹@Model.Discount.ToString("N2")
                    </span>
                </div>

                <div class="summary-row">
                    <span class="summary-label">Tax</span>
                    <span class="summary-value">
                        ₹@Model.TaxAmount.ToString("N2")
                    </span>
                </div>

                <div class="summary-row summary-grand">
                    <span class="summary-label">Grand Total</span>
                    <span class="summary-value">
                        ₹@Model.GrandTotal.ToString("N2")
                    </span>
                </div>
            </div>
        </div>

        <!-- REMARKS -->
        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div class="remarks-section">
                <div class="section-title">Remarks</div>

                <div class="remarks-box">
                    <p class="remarks-text">@Model.Remarks</p>
                </div>
            </div>
        }

        <!-- FOOTER ACTIONS -->
        <div class="grn-footer no-print">
            <div class="d-flex flex-column flex-sm-row
                        justify-content-between gap-2">

                <a asp-controller="GoodsReceipt"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to GRNs
                </a>

                <button type="button"
                        id="printGrnButton"
                        class="btn btn-primary">
                    <i class="bi bi-printer me-1"></i>
                    Print GRN
                </button>
            </div>
        </div>

    </div>
</div>

<script src="~/js/goods-receipt-details.js"
        asp-append-version="true"></script>
