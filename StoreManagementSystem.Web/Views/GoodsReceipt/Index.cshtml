@model IEnumerable<StoreManagementSystem.Domain.Entities.GoodsReceipt>

@using StoreManagementSystem.Domain.Enums

@{
    ViewData["Title"] = "Goods Receipts";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-3">

    <!-- HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-box-seam me-2 text-success"></i>
                Goods Receipt Notes
            </h2>
            <p class="text-muted mb-0">
                Manage purchase receipts, gift receipts, and stock reversals.
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="GoodsReceipt"
               asp-action="Create"
               class="btn btn-success">
                <i class="bi bi-cart-plus me-1"></i>
                Purchase GRN
            </a>

            <a asp-controller="GoodsReceipt"
               asp-action="Gift"
               class="btn btn-warning">
                <i class="bi bi-gift me-1"></i>
                Gift GRN
            </a>
        </div>
    </div>

    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- ERROR MESSAGE -->
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <!-- RECEIPT TABLE -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-success text-white py-3">
            <h5 class="mb-0">
                <i class="bi bi-list-ul me-2"></i>
                Goods Receipt List
            </h5>
        </div>

        <div class="card-body">

            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-box-seam display-4 text-muted"></i>
                    <h5 class="mt-3">No Goods Receipts Found</h5>
                    <p class="text-muted">
                        No purchase or gift GRN has been created yet.
                    </p>

                    <div class="d-flex justify-content-center flex-wrap gap-2">
                        <a asp-controller="GoodsReceipt"
                           asp-action="Create"
                           class="btn btn-success">
                            <i class="bi bi-cart-plus me-1"></i>
                            Purchase GRN
                        </a>

                        <a asp-controller="GoodsReceipt"
                           asp-action="Gift"
                           class="btn btn-warning">
                            <i class="bi bi-gift me-1"></i>
                            Gift GRN
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle w-100"
                           id="goodsReceiptTable">

                        <thead class="table-dark">
                            <tr>
                                <th>#</th>
                                <th>Receipt Type</th>
                                <th>GRN Number</th>
                                <th>Purchase Order</th>
                                <th>Supplier / Donor</th>
                                <th>Receipt Date</th>
                                <th class="text-end">Subtotal</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Discount</th>
                                <th class="text-end">Grand Total</th>
                                <th>Status</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                var counter = 1;
                            }

                            @foreach (var receipt in Model)
                            {
                                var grnNumber = string.IsNullOrWhiteSpace(receipt.GRNNumber)
                                ? $"GRN-{receipt.Id}"
                                : receipt.GRNNumber;

                                var isDeleted = receipt.IsDeleted;

                                <tr class="@(isDeleted ? "table-danger" : "")">
                                    <td>@counter</td>

                                    <td data-order="@((int)receipt.ReceiptType)">
                                        @if (receipt.ReceiptType == GoodsReceiptType.Gift)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-gift me-1"></i> Gift
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-cart-check me-1"></i> Purchase
                                            </span>
                                        }
                                    </td>

                                    <td data-order="@grnNumber">
                                        <strong class="@(isDeleted ? "text-danger text-decoration-line-through" : "")">
                                            @grnNumber
                                        </strong>

                                        @if (isDeleted)
                                        {
                                            <div>
                                                <small class="text-danger">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                    Reversed
                                                </small>
                                            </div>
                                        }
                                    </td>

                                    <td>
                                        @if (receipt.ReceiptType == GoodsReceiptType.Gift)
                                        {
                                            <span class="text-muted">N/A</span>
                                        }
                                        else if (receipt.PurchaseOrder != null)
                                        {
                                            @receipt.PurchaseOrder.PONumber
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>

                                    <td>
                                        @if (receipt.ReceiptType == GoodsReceiptType.Gift)
                                        {
                                            @if (!string.IsNullOrWhiteSpace(receipt.DonorName))
                                            {
                                                <span>
                                                    <i class="bi bi-person-heart me-1 text-warning"></i>
                                                    @receipt.DonorName
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        }
                                        else if (receipt.Supplier != null)
                                        {
                                            @receipt.Supplier.Name
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                </td>

                                <td data-order="@receipt.ReceiptDate.ToString("yyyy-MM-dd")">
                                    @receipt.ReceiptDate.ToString("dd-MM-yyyy")
                                </td>

                                <td class="text-end text-nowrap">
                                    @(receipt.ReceiptType == GoodsReceiptType.Gift
                                                                    ? "₹0.00"
                                                                    : $"₹{receipt.SubTotal:N2}")
                                                                                            </td>

                                <td class="text-end text-nowrap">
                                    @(receipt.ReceiptType == GoodsReceiptType.Gift
                                                                    ? "₹0.00"
                                                                    : $"₹{receipt.TaxAmount:N2}")
                                                                                             </td>

                                <td class="text-end text-nowrap">
                                    @(receipt.ReceiptType == GoodsReceiptType.Gift
                                                                    ? "₹0.00"
                                                                    : $"₹{receipt.Discount:N2}")
                                                                                            </td>

                                <td class="text-end text-nowrap fw-bold">
                                    @(receipt.ReceiptType == GoodsReceiptType.Gift
                                                                    ? "₹0.00"
                                                                    : $"₹{receipt.GrandTotal:N2}")
                            </td>

                                    <td data-order="@(isDeleted ? 0 : 1)">
                                @if (isDeleted)
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i>
                                                Deleted / Reversed
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle me-1"></i>
                                                Active
                                            </span>
                                        }
                                    </td>

                                    <td class="text-center text-nowrap">
                                        <div class="d-inline-flex gap-1">

                                            <a asp-controller="GoodsReceipt"
                                               asp-action="Details"
                                               asp-route-id="@receipt.Id"
                                               class="btn btn-sm btn-info text-white"
                                               title="View Details"
                                               aria-label="View details for @grnNumber">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            @if (!isDeleted)
                                            {
                                                <form asp-controller="GoodsReceipt"
                                                      asp-action="Delete"
                                                      asp-route-id="@receipt.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      data-grn="@grnNumber"
                                                      data-type="@(receipt.ReceiptType == GoodsReceiptType.Gift ? "Gift" : "Purchase")"
                                                      onsubmit="return confirmGoodsReceiptDelete(this);">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-danger"
                                                            title="Reverse and Delete"
                                                            aria-label="Reverse and delete @grnNumber">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form asp-controller="GoodsReceipt"
                                                      asp-action="Restore"
                                                      asp-route-id="@receipt.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      data-grn="@grnNumber"
                                                      onsubmit="return confirmGoodsReceiptRestore(this);">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-sm btn-success"
                                                            title="Restore GRN"
                                                            aria-label="Restore @grnNumber">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>

                                counter++;
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            if ($.fn.DataTable && $("#goodsReceiptTable").length) {
                $("#goodsReceiptTable").DataTable({
                    responsive: true,
                    pageLength: 10,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    order: [[0, "asc"]],
                    columnDefs: [
                        { orderable: false, targets: [11] }
                    ],
                    language: {
                        search: "Search receipts:",
                        lengthMenu: "Show _MENU_ receipts",
                        emptyTable: "No Goods Receipts available.",
                        info: "Showing _START_ to _END_ of _TOTAL_ receipts",
                        infoEmpty: "No receipts available",
                        zeroRecords: "No matching receipts found."
                    }
                });
            }
        });

        function confirmGoodsReceiptDelete(form) {
            var grnNumber = form.dataset.grn || "this GRN";
            var receiptType = form.dataset.type || "Purchase";
            var typeText = receiptType === "Gift" ? "Gift GRN" : "Purchase GRN";

            return confirm(
                "Reverse and delete " + typeText + " " + grnNumber + "?\n\n" +
                "The system will attempt to reverse the received stock, record the " +
                "reversal, and recalculate the related Purchase Order status.\n\n" +
                "The operation may be blocked if the stock has already been consumed.\n\n" +
                "Continue?"
            );
        }

        function confirmGoodsReceiptRestore(form) {
            var grnNumber = form.dataset.grn || "this GRN";

            return confirm(
                "Restore GRN " + grnNumber + "?\n\n" +
                "The system will attempt to restore the receipt and stock records " +
                "and recalculate the related Purchase Order status.\n\n" +
                "Continue?"
            );
        }
    </script>
}
