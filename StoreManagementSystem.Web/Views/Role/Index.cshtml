@model IEnumerable<StoreManagementSystem.Web.ViewModels.Role.RoleListViewModel>

@{
    ViewData["Title"] = "Roles & Permissions";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="mb-1">
                <i class="bi bi-shield-lock me-2"></i>
                Roles & Permissions
            </h3>

            <p class="text-muted mb-0">
                Manage roles and control access to ERP tasks.
            </p>
        </div>

        <a asp-controller="Role"
           asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>

            Create Role

        </a>

    </div>


    <!-- ========================================================= -->
    <!-- ALERTS -->
    <!-- ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle me-2"></i>

            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }


    <!-- ========================================================= -->
    <!-- ROLE TABLE -->
    <!-- ========================================================= -->

    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Role
                            </th>

                            <th>
                                Users
                            </th>

                            <th>
                                Permissions
                            </th>

                            <th class="text-end">
                                Action
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var role in Model)
                        {
                            <tr>

                                <td>

                                    <div class="d-flex align-items-center">

                                        <div class="bg-light rounded-circle
                                                        d-flex align-items-center
                                                        justify-content-center me-3"
                                             style="width:40px;height:40px;">

                                            <i class="bi bi-shield-check"></i>

                                        </div>

                                        <strong>
                                            @role.Name
                                        </strong>

                                    </div>

                                </td>


                                <td>

                                    <span class="badge bg-secondary">

                                        @role.UserCount

                                    </span>

                                </td>


                                <td>

                                    @if (role.Name ==
                                                                    StoreManagementSystem.Infrastructure.Identity.RoleConstants.SuperAdmin)
                                    {
                                        <span class="badge bg-success">
                                            All Permissions
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            @role.PermissionCount
                                        </span>
                                    }

                                </td>


                                <td class="text-end">

                                    <a asp-controller="Role"
                                       asp-action="Permissions"
                                       asp-route-id="@role.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-key me-1"></i>

                                        Permissions

                                    </a>


                                    @if (role.Name !=
                                                                    StoreManagementSystem.Infrastructure.Identity.RoleConstants.SuperAdmin)
                                    {
                                        <form asp-controller="Role"
                                              asp-action="Delete"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@role.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Are you sure you want to delete this role?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>