
@model IEnumerable<StoreManagementSystem.Domain.Entities.Product>

@{
    ViewData["Title"] = "Product List";
    Layout = "_AdminLayout";

    var products = Model?.ToList()
                   ?? new List<StoreManagementSystem.Domain.Entities.Product>();
}

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-box-seam-fill text-primary me-2"></i>
                Product List
            </h2>
            <p class="text-muted mb-0">
                View and manage product titles, codes, classification, suppliers and warehouses.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Add Product
        </a>
    </div>

    <!-- SUMMARY -->
    <div class="row g-3 mb-4">

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Total Products</div>
                        <h3 class="fw-bold mb-0">@products.Count</h3>
                    </div>
                    <i class="bi bi-box-seam fs-1 text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Products with Barcode</div>
                        <h3 class="fw-bold text-success mb-0">
                            @products.Count(x => !string.IsNullOrWhiteSpace(x.Barcode))
                        </h3>
                    </div>
                    <i class="bi bi-upc-scan fs-1 text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small">Products without Barcode</div>
                        <h3 class="fw-bold text-warning mb-0">
                            @products.Count(x => string.IsNullOrWhiteSpace(x.Barcode))
                        </h3>
                    </div>
                    <i class="bi bi-upc fs-1 text-warning"></i>
                </div>
            </div>
        </div>

    </div>

    <!-- PRODUCT TABLE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-table text-primary me-2"></i>
                Product Records
            </h5>
            <small class="text-muted">
                Search, sort, export and manage your products.
            </small>
        </div>

        <div class="card-body">
            <div class="table-responsive">

                <table id="productTable"
                       class="table table-hover table-bordered align-middle w-100">

                    <thead class="table-dark">
                        <tr>
                            <th>Product Title</th>
                            <th>SKU</th>
                            <th>Barcode</th>
                            <th>Main Category</th>
                            <th>Category</th>
                            <th>Subcategory</th>
                            <th>Supplier</th>
                            <th>Warehouse</th>
                            <th class="text-center" style="min-width: 110px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in products)
                        {
                            <tr>
                                <!-- PRODUCT TITLE: FIRST COLUMN -->
                                <td class="fw-semibold">
                                    @(string.IsNullOrWhiteSpace(item.Title)
                                                                    ? "-"
                                                                    : item.Title)
                            </td>

                                <!-- SKU -->
                                <td>
                                @if (!string.IsNullOrWhiteSpace(item.SKU))
                                    {
                                        <span class="badge bg-dark">@item.SKU</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <!-- BARCODE -->
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(item.Barcode))
                                    {
                                        <span class="font-monospace">@item.Barcode</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not assigned</span>
                                    }
                                </td>

                                <!-- MAIN CATEGORY -->
                                <td>
                                    @(item.MainCategory?.Name ?? "-")
                                </td>

                                <!-- CATEGORY -->
                                <td>
                                    @(item.Category?.Name ?? "-")
                                </td>

                                <!-- SUBCATEGORY -->
                                <td>
                                    @(item.SubCategory?.Name ?? "-")
                                </td>

                                <!-- SUPPLIER -->
                                <td>
                                    @(item.Supplier?.Name ?? "-")
                                </td>

                                <!-- WAREHOUSE -->
                                <td>
                                    @(item.Warehouse?.Name ?? "-")
                                </td>

                                <!-- ACTIONS -->
                                <td class="text-center text-nowrap">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Edit product"
                                       aria-label="Edit product">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline deleteForm">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                title="Delete product"
                                                aria-label="Delete product">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        $(document).ready(function () {

            $("#productTable").DataTable({
                responsive: true,
                processing: true,
                autoWidth: false,
                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "All"]
                ],

                // Sort by Product Title by default.
                order: [[0, "asc"]],

                dom:
                    "<'row g-2 mb-3'<'col-lg-7 col-12'B><'col-lg-5 col-12'f>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-3 g-2'<'col-md-5'i><'col-md-7'p>>",

                buttons: [
                    {
                        extend: "copy",
                        className: "btn btn-secondary btn-sm",
                        text: '<i class="bi bi-copy"></i> Copy',
                        exportOptions: { columns: ":not(:last-child)" }
                    },
                    {
                        extend: "csv",
                        className: "btn btn-success btn-sm",
                        text: '<i class="bi bi-filetype-csv"></i> CSV',
                        exportOptions: { columns: ":not(:last-child)" }
                    },
                    {
                        extend: "excel",
                        className: "btn btn-success btn-sm",
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel',
                        exportOptions: { columns: ":not(:last-child)" }
                    },
                    {
                        extend: "pdf",
                        className: "btn btn-danger btn-sm",
                        text: '<i class="bi bi-file-earmark-pdf"></i> PDF',
                        exportOptions: { columns: ":not(:last-child)" }
                    },
                    {
                        extend: "print",
                        className: "btn btn-info btn-sm",
                        text: '<i class="bi bi-printer"></i> Print',
                        exportOptions: { columns: ":not(:last-child)" }
                    }
                ],

                language: {
                    search: "Search products:",
                    lengthMenu: "Show _MENU_ products",
                    info: "Showing _START_ to _END_ of _TOTAL_ products",
                    zeroRecords: "No matching products found",
                    emptyTable: "No products available",
                    infoEmpty: "No products available"
                }
            });

            $(".deleteForm").on("submit", function (e) {
                if (!confirm("Are you sure you want to delete this product?")) {
                    e.preventDefault();
                }
            });

        });
    </script>
}
