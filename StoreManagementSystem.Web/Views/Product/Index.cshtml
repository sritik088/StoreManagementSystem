@model IEnumerable<StoreManagementSystem.Domain.Entities.Product>

@{
    ViewData["Title"] = "Product Management";
    Layout = "_AdminLayout";

    var products = Model.ToList();
}

<div class="container-fluid">

    <!-- PAGE HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-box-seam-fill text-primary"></i>
                Product Management
            </h2>

            <p class="text-muted mb-0">
                Manage products and their classification.
            </p>
        </div>

        <div>
            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Add Product

            </a>
        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="row mb-4">

        <!-- Total Products -->
        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                Total Products
                            </small>

                            <h2 class="fw-bold mb-0">
                                @products.Count
                            </h2>

                        </div>

                        <div class="text-primary fs-2">
                            <i class="bi bi-box-seam"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Products with Barcode -->
        <div class="col-lg-3 col-md-6 mb-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">
                                With Barcode
                            </small>

                            <h2 class="fw-bold text-success mb-0">

                                @products.Count(x =>
                                !string.IsNullOrWhiteSpace(x.Barcode))

                            </h2>

                        </div>

                        <div class="text-success fs-2">
                            <i class="bi bi-upc-scan"></i>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- PRODUCT TABLE -->
    <div class="card shadow border-0">

        <div class="card-header bg-light">

            <h5 class="mb-0">

                <i class="bi bi-table"></i>
                Product List

            </h5>

        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table id="productTable"
                       class="table table-hover table-bordered align-middle">

                    <thead class="table-dark">

                        <tr>

                            <th>#</th>

                            <th>Main Category</th>

                            <th>SKU</th>

                            <th width="150">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- Serial Number -->
                                <td>
                                    @sr
                                </td>


                                <!-- Main Category -->
                                <td>

                                    @if (item.MainCategory != null)
                                    {
                                        <span class="badge bg-primary">
                                            @item.MainCategory.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <!-- SKU -->
                                <td>

                                    <span class="badge bg-dark">
                                        @item.SKU
                                    </span>

                                </td>


                                <!-- Actions -->
                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="btn btn-info btn-sm"
                                           title="Details">

                                            <i class="bi bi-eye"></i>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-warning btn-sm"
                                           title="Edit">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>


                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline deleteForm">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn btn-danger btn-sm"
                                                    title="Delete">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </div>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        $(document).ready(function () {

            $("#productTable").DataTable({

                responsive: true,

                processing: true,

                autoWidth: false,

                pageLength: 10,

                lengthMenu: [
                    [10, 25, 50, 100, -1],
                    [10, 25, 50, 100, "All"]
                ],

                order: [[1, "asc"]],

                dom:
                    "<'row mb-3'<'col-md-6'B><'col-md-6'f>>" +
                    "<'row'<'col-12'tr>>" +
                    "<'row mt-3'<'col-md-5'i><'col-md-7'p>>",

                buttons: [

                    {
                        extend: 'copy',
                        className: 'btn btn-secondary btn-sm',
                        text: '<i class="bi bi-copy"></i> Copy'
                    },

                    {
                        extend: 'csv',
                        className: 'btn btn-success btn-sm',
                        text: '<i class="bi bi-filetype-csv"></i> CSV'
                    },

                    {
                        extend: 'excel',
                        className: 'btn btn-success btn-sm',
                        text: '<i class="bi bi-file-earmark-excel"></i> Excel'
                    },

                    {
                        extend: 'pdf',
                        className: 'btn btn-danger btn-sm',
                        text: '<i class="bi bi-file-earmark-pdf"></i> PDF'
                    },

                    {
                        extend: 'print',
                        className: 'btn btn-info btn-sm',
                        text: '<i class="bi bi-printer"></i> Print'
                    },

                    {
                        extend: 'colvis',
                        className: 'btn btn-dark btn-sm',
                        text: '<i class="bi bi-layout-three-columns"></i> Columns'
                    }

                ],

                language: {

                    search: "Search Product:",

                    lengthMenu:
                        "Show _MENU_ Products",

                    info:
                        "Showing _START_ to _END_ of _TOTAL_ Products",

                    zeroRecords:
                        "No Products Found",

                    infoEmpty:
                        "No Records Available"

                }

            });

        });

    </script>
}