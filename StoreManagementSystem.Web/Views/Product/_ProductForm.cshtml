@model StoreManagementSystem.Web.ViewModels.Product.ProductViewModel

<div class="row">

    <!-- ===================================================== -->
    <!-- PRODUCT IDENTIFICATION -->
    <!-- ===================================================== -->

    <div class="col-lg-12">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-primary text-white">

                <h5 class="mb-0">
                    <i class="bi bi-box-seam"></i>
                    Product Identification
                </h5>

            </div>

            <div class="card-body">

                <div class="row">

                    <!-- SKU -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="SKU"
                               class="form-label">
                        </label>

                        <input asp-for="SKU"
                               class="form-control"
                               placeholder="Enter SKU" />

                        <span asp-validation-for="SKU"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Barcode -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="Barcode"
                               class="form-label">
                        </label>

                        <input asp-for="Barcode"
                               class="form-control"
                               placeholder="Enter barcode" />

                        <span asp-validation-for="Barcode"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- CLASSIFICATION -->
    <!-- ===================================================== -->

    <div class="col-lg-12">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-success text-white">

                <h5 class="mb-0">

                    <i class="bi bi-diagram-3"></i>

                    Classification

                </h5>

            </div>


            <div class="card-body">

                <div class="row">


                    <!-- ================================================= -->
                    <!-- MAIN CATEGORY -->
                    <!-- ================================================= -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="MainCategoryId"
                               class="form-label">

                            Main Category

                        </label>


                        <select asp-for="MainCategoryId"
                                asp-items="Model.MainCategories"
                                class="form-select"
                                id="MainCategoryId">

                            <option value="">
                                -- Select Main Category --
                            </option>

                        </select>


                        <span asp-validation-for="MainCategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- CATEGORY -->
                    <!-- ================================================= -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="CategoryId"
                               class="form-label">

                            Category

                        </label>


                        <select asp-for="CategoryId"
                                asp-items="Model.Categories"
                                class="form-select"
                                id="CategoryId">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>


                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ================================================= -->
                    <!-- SUB CATEGORY -->
                    <!-- ================================================= -->

                    <div class="col-md-4 mb-3">

                        <label asp-for="SubCategoryId"
                               class="form-label">

                            Sub Category

                        </label>


                        <select asp-for="SubCategoryId"
                                asp-items="Model.SubCategories"
                                class="form-select"
                                id="SubCategoryId">

                            <option value="">
                                -- Select Sub Category --
                            </option>

                        </select>


                        <span asp-validation-for="SubCategoryId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ===================================================== -->
    <!-- SUPPLIER + WAREHOUSE -->
    <!-- ===================================================== -->

    <div class="col-lg-12">

        <div class="card shadow-sm mb-4">

            <div class="card-header bg-info text-white">

                <h5 class="mb-0">

                    <i class="bi bi-building"></i>

                    Supplier & Warehouse

                </h5>

            </div>


            <div class="card-body">

                <div class="row">


                    <!-- Supplier -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="SupplierId"
                               class="form-label">
                        </label>


                        <select asp-for="SupplierId"
                                asp-items="Model.Suppliers"
                                class="form-select">

                            <option value="">
                                -- Select Supplier --
                            </option>

                        </select>


                        <span asp-validation-for="SupplierId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Warehouse -->

                    <div class="col-md-6 mb-3">

                        <label asp-for="WarehouseId"
                               class="form-label">
                        </label>


                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select">

                            <option value="">
                                -- Select Warehouse --
                            </option>

                        </select>


                        <span asp-validation-for="WarehouseId"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>