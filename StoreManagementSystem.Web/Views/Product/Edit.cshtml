@model StoreManagementSystem.Web.ViewModels.Product.ProductViewModel

@{
    ViewData["Title"] = "Edit Product";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-3">

    <!-- PAGE HEADER -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square text-warning me-2"></i>
                Edit Product
            </h2>

            <p class="text-muted mb-0">
                Update product title, identification, classification, supplier and warehouse.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Products
        </a>
    </div>

    <!-- EDIT FORM -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <h5 class="fw-bold mb-1">
                <i class="bi bi-box-seam text-primary me-2"></i>
                Product Information
            </h5>

            <small class="text-muted">
                Update the fields below and save your changes.
            </small>
        </div>

        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Id" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"
                     role="alert">
                </div>

                <partial name="_ProductForm" model="Model" />

                <hr class="my-4" />

                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="bi bi-check-circle me-1"></i>
                        Update Product
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product-category-dropdowns.js"
            asp-append-version="true"></script>
}

