@model StoreManagementSystem.Web.ViewModels.Product.ProductViewModel

@{
    ViewData["Title"] = "Create Product";
    Layout = "_AdminLayout";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-box-seam text-primary"></i>
                Create Product
            </h2>

            <small class="text-muted">
                Add a new product into inventory
            </small>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

    <div class="card shadow border-0">

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger"></div>

                <partial name="_ProductForm" model="Model" />

                <hr />

                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save"></i>

                    Save Product

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        // Image Preview

        $("#imageInput").change(function(){

            const file=this.files[0];

            if(file){

                let reader=new FileReader();

                reader.onload=function(e){

                    $("#previewImage").attr("src",e.target.result);

                }

                reader.readAsDataURL(file);

            }

        });

        // Category -> SubCategory

        $("#CategoryId").change(function(){

            let categoryId=$(this).val();

            $("#SubCategoryId").empty();

            $.get("/Product/GetSubCategories",
            {
                categoryId:categoryId
            },
            function(data){

                $("#SubCategoryId")
                    .append('<option value="">Select SubCategory</option>');

                $.each(data,function(i,item){

                    $("#SubCategoryId")
                    .append('<option value="'+item.id+'">'+item.name+'</option>');

                });

            });

        });

                <partial name="_ValidationScriptsPartial"/>

        <script>

        $("#imageInput").change(function(){

        const file=this.files[0];

        if(file){

        let reader=new FileReader();

        reader.onload=function(e){

        $("#previewImage").attr("src",e.target.result);

        }

        reader.readAsDataURL(file);

        }

        });

    </script>
    
}