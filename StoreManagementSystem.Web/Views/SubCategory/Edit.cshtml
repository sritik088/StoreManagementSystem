@model StoreManagementSystem.Web.ViewModels.SubCategory.SubCategoryViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Edit Sub Category";
}

<div class="container-fluid">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                <i class="bi bi-pencil-square text-warning"></i>
                Edit Sub Category
            </h2>

            <small class="text-muted">
                Update sub category information.
            </small>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to List

        </a>

    </div>

    <!-- Edit Card -->
    <div class="card shadow border-0">

        <div class="card-header bg-warning text-dark">

            <h5 class="mb-0">
                <i class="bi bi-pencil"></i>
                Edit Sub Category
            </h5>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <!-- Hidden ID -->
                <input asp-for="Id"
                       type="hidden" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <div class="row">

                    <!-- Category -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="CategoryId"
                               class="form-label fw-semibold">
                            Category
                        </label>

                        <select asp-for="CategoryId"
                                asp-items="ViewBag.CategoryList"
                                class="form-select">

                            <option value="">
                                -- Select Category --
                            </option>

                        </select>

                        <span asp-validation-for="CategoryId"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Sub Category Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label fw-semibold">
                            Sub Category Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter Sub Category Name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <!-- Buttons -->
                <div class="text-end">

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        <i class="bi bi-x-circle"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-warning">

                        <i class="bi bi-check-circle"></i>
                        Update Sub Category

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}