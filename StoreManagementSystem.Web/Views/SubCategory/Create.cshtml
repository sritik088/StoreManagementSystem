@model StoreManagementSystem.Web.ViewModels.SubCategory.SubCategoryViewModel

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Create Sub Category";
}

<div class="card shadow">

    <div class="card-header bg-primary text-white">
        <h4 class="mb-0">Create Sub Category</h4>
    </div>

    <div class="card-body">

        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <!-- Category -->
            <div class="mb-3">

                <label asp-for="CategoryId"
                       class="form-label">
                    Category
                </label>

                <select asp-for="CategoryId"
                        asp-items="ViewBag.CategoryList"
                        class="form-select">

                    <option value="">-- Select Category --</option>

                </select>

                <span asp-validation-for="CategoryId"
                      class="text-danger">
                </span>

            </div>

            <!-- Sub Category Name -->
            <div class="mb-3">

                <label asp-for="Name"
                       class="form-label">
                    Sub Category Name
                </label>

                <input asp-for="Name"
                       class="form-control"
                       placeholder="Enter sub category name" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>

            <hr />

            <button type="submit"
                    class="btn btn-primary">
                <i class="bi bi-save"></i>
                Save
            </button>

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}