@model IEnumerable<StoreManagementSystem.Domain.Entities.Delivery>

@{
    ViewData["Title"] = "Deliveries";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between">

        <h4 class="mb-0">
            Deliveries
        </h4>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>
            New Delivery

        </a>

    </div>

    <div class="card-body">

        <table id="deliveryTable"
               class="table table-bordered table-hover">

            <thead>

                <tr>

                    <th>Delivery No</th>

                    <th>Date</th>

                    <th>Sales Order</th>

                    <th>Warehouse</th>

                    <th>Status</th>

                    <th>Items</th>

                    <th>Action</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            @item.DeliveryNumber
                        </td>

                        <td>
                            @item.DeliveryDate.ToString("dd-MMM-yyyy")
                        </td>

                        <td>
                            @item.SalesOrder?.OrderNumber
                        </td>

                        <td>
                            @item.Warehouse?.Name
                        </td>

                        <td>

                            <span class="badge bg-success">
                                @item.Status
                            </span>

                        </td>

                        <td>
                            @item.Items.Count
                        </td>

                        <td>

                            <a asp-action="Details"
                               asp-route-id="@item.Id"
                               class="btn btn-info btn-sm">

                                View

                            </a>

                            <a asp-action="Print"
                               asp-route-id="@item.Id"
                               class="btn btn-secondary btn-sm">

                                Print

                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function () {

            $("#deliveryTable").DataTable({
                responsive: true,
                pageLength: 10,
                order: [[1, "desc"]]
            });

        });

    </script>

}