@model StoreManagementSystem.Domain.Entities.Delivery

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Delivery Details";
}

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between">

        <h4>
            Delivery Details
        </h4>

        <a asp-action="Print"
           asp-route-id="@Model.Id"
           class="btn btn-secondary">

            Print

        </a>

    </div>

    <div class="card-body">

        <div class="row mb-4">

            <div class="col-md-3">

                <strong>Delivery No</strong>

                <div>
                    @Model.DeliveryNumber
                </div>

            </div>

            <div class="col-md-3">

                <strong>Sales Order</strong>

                <div>
                    @Model.SalesOrder?.OrderNumber
                </div>

            </div>

            <div class="col-md-3">

                <strong>Warehouse</strong>

                <div>
                    @Model.Warehouse?.Name
                </div>

            </div>

            <div class="col-md-3">

                <strong>Date</strong>

                <div>
                    @Model.DeliveryDate.ToString("dd-MMM-yyyy")
                </div>

            </div>

        </div>

        <table class="table table-bordered">

            <thead>

                <tr>

                    <th>Product</th>

                    <th>SKU</th>

                    <th>Quantity</th>

                    <th>Unit Price</th>

                    <th>Total</th>

                </tr>

            </thead>

            <tbody>

                @foreach (var item in Model.Items)
                {
                    <tr>

                      

                        <td>
                            @item.Product?.SKU
                        </td>

                        <td>
                            @item.Quantity
                        </td>

                        <td>
                            @item.UnitPrice.ToString("N2")
                        </td>

                        <td>
                            @item.Total.ToString("N2")
                        </td>

                    </tr>
                }

            </tbody>

        </table>

        <div class="text-end">

            <h5>
                Total:
                @Model.Items.Sum(x => x.Total).ToString("N2")
            </h5>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div class="mt-3">

                <strong>Remarks:</strong>

                <p>
                    @Model.Remarks
                </p>

            </div>
        }

    </div>

</div>