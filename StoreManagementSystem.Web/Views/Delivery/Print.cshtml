
@model StoreManagementSystem.Domain.Entities.Delivery

@{
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>
        @Model.DeliveryNumber
    </title>

    <style>

        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }

        h2 {
            text-align: center;
            margin-bottom: 30px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 30px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            border: 1px solid #000;
            padding: 8px;
        }

        th {
            background: #eee;
            text-align: left;
        }

        .total {
            text-align: right;
            margin-top: 20px;
            font-size: 18px;
        }

        .no-print {
            margin-top: 30px;
        }

        @@media print {

            .no-print {
                display: none !important;
            }

            body {
                margin: 0;
            }
        }

    </style>

</head>

<body>

    <h2>
        DELIVERY NOTE
    </h2>

    <!-- ============================= -->
    <!-- DELIVERY HEADER -->
    <!-- ============================= -->

    <div class="header">

        <div>

            <strong>Delivery No:</strong>
            @Model.DeliveryNumber

            <br />

            <strong>Sales Order:</strong>
            @Model.SalesOrder?.OrderNumber

        </div>

        <div>

            <strong>Date:</strong>
            @Model.DeliveryDate.ToString("dd-MMM-yyyy")

            <br />

            <strong>Warehouse:</strong>
            @Model.Warehouse?.Name

        </div>

    </div>


    <!-- ============================= -->
    <!-- DELIVERY ITEMS -->
    <!-- ============================= -->

    <table>

        <thead>

            <tr>

                <th>Product</th>

                <th>SKU</th>

                <th>Quantity</th>

                <th>Unit Price</th>

                <th>Total</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model.Items)
            {
                <tr>

                   
                    <td>
                        @item.Product?.SKU
                    </td>

                    <td>
                        @item.Quantity.ToString("N2")
                    </td>

                    <td>
                        @item.UnitPrice.ToString("N2")
                    </td>

                    <td>
                        @item.Total.ToString("N2")
                    </td>

                </tr>
            }

        </tbody>

    </table>


    <!-- ============================= -->
    <!-- TOTAL -->
    <!-- ============================= -->

    <div class="total">

        <strong>
            Total:
            @Model.Items.Sum(x => x.Total).ToString("N2")
        </strong>

    </div>


    <!-- ============================= -->
    <!-- REMARKS -->
    <!-- ============================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <p>

            <strong>Remarks:</strong>

            @Model.Remarks

        </p>
    }


    <!-- ============================= -->
    <!-- PRINT BUTTON -->
    <!-- ============================= -->

    <div class="no-print">

        <button onclick="window.print()">
            Print
        </button>

    </div>

</body>

</html>

