@model StoreManagementSystem.Web.ViewModels.AccountsPayable.SupplierOutstandingViewModel

@{
    ViewData["Title"] = "Supplier Outstanding";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-exclamation-circle me-2"></i>
                Supplier Outstanding
            </h3>
            <div class="text-muted">
                Supplier-wise payable balance
            </div>
        </div>

        <a href="/AccountsPayable"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            AP Dashboard
        </a>

    </div>

    <div class="row mb-4">

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">
                        Total Outstanding
                    </div>

                    <div class="fs-3 fw-bold text-danger">
                        ₹@Model.TotalOutstanding.ToString("N2")
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-body border-bottom">

            <form method="get"
                  action="/SupplierOutstanding">

                <div class="row g-2">

                    <div class="col-md-8">
                        <input type="text"
                               name="search"
                               value="@Model.Search"
                               class="form-control"
                               placeholder="Search supplier, code or phone..." />
                    </div>

                    <div class="col-md-2">
                        <button class="btn btn-primary w-100"
                                type="submit">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>
                    </div>

                    <div class="col-md-2">
                        <a href="/SupplierOutstanding"
                           class="btn btn-outline-secondary w-100">
                            Reset
                        </a>
                    </div>

                </div>

            </form>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>#</th>
                        <th>Supplier</th>
                        <th>Supplier Code</th>
                        <th>Phone</th>
                        <th class="text-end">Purchases</th>
                        <th class="text-end">Payments</th>
                        <th class="text-end">Outstanding</th>
                        <th></th>
                    </tr>

                </thead>

                <tbody>

                    @if (!Model.Items.Any())
                    {
                        <tr>
                            <td colspan="8"
                                class="text-center py-5 text-muted">
                                No outstanding supplier balance found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        var index = 1;

                        foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>@index</td>

                                <td class="fw-semibold">
                                    @item.SupplierName
                                </td>

                                <td>
                                    @(item.SupplierCode ?? "-")
                                </td>

                                <td>
                                    @(item.Phone ?? "-")
                                </td>

                                <td class="text-end">
                                    ₹@item.GoodsReceivedValue.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@item.PaymentsMade.ToString("N2")
                                </td>

                                <td class="text-end">
                                    <span class="fw-bold
                @(item.OutstandingPayable > 0
                                                      ? "text-danger"
                                                      : "text-success")">

                                ₹@item.OutstandingPayable.ToString("N2")

                                    </span>
                                </td>

                            </tr>

                            index++;
                        }
                    }

                </tbody>

            </table>

        </div>

    </div>
    

</div>
