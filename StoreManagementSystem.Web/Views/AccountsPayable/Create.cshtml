@model StoreManagementSystem.Web.ViewModels.AccountsPayable.SupplierPaymentCreateViewModel

@{
    ViewData["Title"] = "Supplier Payment";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-cash-stack me-2"></i>
                Supplier Payment
            </h3>

            <div class="text-muted">
                Record payment against supplier outstanding
            </div>
        </div>

        <a href="/SupplierPayments"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Payment Register
        </a>

    </div>


    <!-- =========================================================
         PAYMENT CARD
         ========================================================= -->

    <div class="row justify-content-center">

        <div class="col-xl-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body p-4">

                    <form method="post"
                          action="/SupplierPayments/Create">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="row g-4">

                            <!-- =================================================
                                 SUPPLIER
                                 ================================================= -->

                            <div class="col-md-8">

                                <label asp-for="SupplierId"
                                       class="form-label fw-semibold">
                                    Supplier
                                </label>

                                <select asp-for="SupplierId"
                                        class="form-select"
                                        id="supplierSelect">

                                    <option value="">
                                        -- Select Supplier --
                                    </option>

                                    @foreach (var supplier in Model.Suppliers)
                                    {
                                        <option value="@supplier.Id">
                                            @supplier.Name
                                        </option>
                                    }

                                </select>

                                <span asp-validation-for="SupplierId"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 CURRENT OUTSTANDING
                                 ================================================= -->

                            <div class="col-md-4">

                                <label class="form-label fw-semibold">
                                    Current Outstanding
                                </label>

                                <div class="form-control bg-light fw-bold text-danger"
                                     id="outstandingDisplay">
                                    ₹0.00
                                </div>

                            </div>


                            <!-- =================================================
                                 SUPPLIER TAKE / GIVEN INFORMATION
                                 ================================================= -->

                            <div class="col-12">

                                <div class="row g-3">

                                    <div class="col-md-4">

                                        <div class="border rounded p-3 bg-light">

                                            <div class="small text-muted">
                                                Supplier Take
                                            </div>

                                            <div class="fw-bold text-success"
                                                 id="supplierTakeDisplay">
                                                ₹0.00
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="border rounded p-3 bg-light">

                                            <div class="small text-muted">
                                                Supplier Given
                                            </div>

                                            <div class="fw-bold text-primary"
                                                 id="supplierGivenDisplay">
                                                ₹0.00
                                            </div>

                                        </div>

                                    </div>

                                    <div class="col-md-4">

                                        <div class="border rounded p-3 bg-light">

                                            <div class="small text-muted">
                                                Payable
                                            </div>

                                            <div class="fw-bold text-danger"
                                                 id="payableDisplay">
                                                ₹0.00
                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================================
                                 PAYMENT DATE
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="PaymentDate"
                                       class="form-label fw-semibold">
                                    Payment Date
                                </label>

                                <input asp-for="PaymentDate"
                                       type="date"
                                       class="form-control" />

                                <span asp-validation-for="PaymentDate"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 PAYMENT AMOUNT
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="Amount"
                                       class="form-label fw-semibold">
                                    Payment Amount
                                </label>

                                <div class="input-group">

                                    <span class="input-group-text">
                                        ₹
                                    </span>

                                    <input asp-for="Amount"
                                           class="form-control"
                                           id="amountInput"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           placeholder="Enter payment amount" />

                                </div>

                                <span asp-validation-for="Amount"
                                      class="text-danger small">
                                </span>

                                <div id="amountWarning"
                                     class="text-danger small mt-1">
                                </div>

                            </div>


                            <!-- =================================================
                                 PAYMENT MODE
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="PaymentMode"
                                       class="form-label fw-semibold">
                                    Payment Mode
                                </label>

                                <select asp-for="PaymentMode"
                                        class="form-select">

                                    <option value="Bank">
                                        Bank
                                    </option>

                                    <option value="Cash">
                                        Cash
                                    </option>

                                    <option value="UPI">
                                        UPI
                                    </option>

                                    <option value="Cheque">
                                        Cheque
                                    </option>

                                    <option value="NEFT">
                                        NEFT
                                    </option>

                                    <option value="RTGS">
                                        RTGS
                                    </option>

                                </select>

                                <span asp-validation-for="PaymentMode"
                                      class="text-danger small">
                                </span>

                            </div>


                            <!-- =================================================
                                 REFERENCE NUMBER
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="ReferenceNumber"
                                       class="form-label fw-semibold">
                                    Reference Number
                                </label>

                                <input asp-for="ReferenceNumber"
                                       class="form-control"
                                       placeholder="UTR / Cheque / Transaction No." />

                            </div>


                            <!-- =================================================
                                 BANK NAME
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="BankName"
                                       class="form-label fw-semibold">
                                    Bank Name
                                </label>

                                <input asp-for="BankName"
                                       class="form-control"
                                       placeholder="Optional" />

                            </div>


                            <!-- =================================================
                                 REMARKS
                                 ================================================= -->

                            <div class="col-md-6">

                                <label asp-for="Remarks"
                                       class="form-label fw-semibold">
                                    Remarks
                                </label>

                                <textarea asp-for="Remarks"
                                          class="form-control"
                                          rows="3"
                                          placeholder="Optional remarks"></textarea>

                            </div>

                        </div>


                        <hr class="my-4" />


                        <!-- =================================================
                             BUTTONS
                             ================================================= -->

                        <div class="d-flex justify-content-end gap-2">

                            <a href="/SupplierPayments"
                               class="btn btn-light">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary"
                                    id="savePaymentBtn"
                                    disabled>

                                <i class="bi bi-check-circle me-1"></i>
                                Save Payment

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const supplierSelect =
            document.getElementById("supplierSelect");

        const outstandingDisplay =
            document.getElementById("outstandingDisplay");

        const supplierTakeDisplay =
            document.getElementById("supplierTakeDisplay");

        const supplierGivenDisplay =
            document.getElementById("supplierGivenDisplay");

        const payableDisplay =
            document.getElementById("payableDisplay");

        const amountInput =
            document.getElementById("amountInput");

        const amountWarning =
            document.getElementById("amountWarning");

        const savePaymentBtn =
            document.getElementById("savePaymentBtn");


        let currentOutstanding = 0;


        // =========================================================
        // FORMAT CURRENCY
        // =========================================================

        function formatCurrency(value) {

            const amount =
                Number(value) || 0;

            return "₹" +
                amount.toLocaleString(
                    "en-IN",
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );
        }


        // =========================================================
        // RESET OUTSTANDING
        // =========================================================

        function resetOutstanding() {

            currentOutstanding = 0;

            outstandingDisplay.innerText =
                "₹0.00";

            supplierTakeDisplay.innerText =
                "₹0.00";

            supplierGivenDisplay.innerText =
                "₹0.00";

            payableDisplay.innerText =
                "₹0.00";

            amountWarning.innerText = "";

            savePaymentBtn.disabled = true;

        }


        // =========================================================
        // LOAD SUPPLIER OUTSTANDING
        // =========================================================

        async function loadOutstanding() {

            const supplierId =
                supplierSelect.value;

            resetOutstanding();

            if (!supplierId) {
                return;
            }

            outstandingDisplay.innerText =
                "Loading...";

            try {

                const response =
                    await fetch(
                        "/SupplierPayments/GetOutstanding/" +
                        supplierId,
                        {
                            method: "GET",
                            headers: {
                                "Accept": "application/json"
                            }
                        }
                    );


                if (!response.ok) {

                    throw new Error(
                        "Unable to load supplier outstanding."
                    );

                }


                const data =
                    await response.json();


                if (!data.success) {

                    outstandingDisplay.innerText =
                        "₹0.00";

                    amountWarning.innerText =
                        data.message ||
                        "Unable to calculate supplier outstanding.";

                    return;
                }


                const supplierTake =
                    Number(data.supplierTake) || 0;

                const supplierGiven =
                    Number(data.supplierGiven) || 0;

                const outstanding =
                    Number(data.outstanding) || 0;


                currentOutstanding =
                    outstanding;


                supplierTakeDisplay.innerText =
                    formatCurrency(
                        supplierTake
                    );


                supplierGivenDisplay.innerText =
                    formatCurrency(
                        supplierGiven
                    );


                payableDisplay.innerText =
                    formatCurrency(
                        outstanding
                    );


                outstandingDisplay.innerText =
                    formatCurrency(
                        outstanding
                    );


                validateAmount();

            }
            catch (error) {

                console.error(error);

                resetOutstanding();

                amountWarning.innerText =
                    "Unable to load supplier outstanding. Please refresh the page.";

            }

        }


        // =========================================================
        // VALIDATE PAYMENT AMOUNT
        // =========================================================

        function validateAmount() {

            const amount =
                Number(
                    amountInput.value
                ) || 0;


            amountWarning.innerText = "";


            if (!supplierSelect.value) {

                savePaymentBtn.disabled =
                    true;

                return;

            }


            if (currentOutstanding <= 0) {

                amountWarning.innerText =
                    "This supplier has no outstanding payable amount.";

                savePaymentBtn.disabled =
                    true;

                return;

            }


            if (amount <= 0) {

                savePaymentBtn.disabled =
                    true;

                return;

            }


            if (amount > currentOutstanding) {

                amountWarning.innerText =
                    "Payment cannot exceed the current outstanding amount of " +
                    formatCurrency(
                        currentOutstanding
                    ) +
                    ".";

                savePaymentBtn.disabled =
                    true;

                return;

            }


            savePaymentBtn.disabled =
                false;

        }


        // =========================================================
        // SUPPLIER CHANGE
        // =========================================================

        supplierSelect.addEventListener(
            "change",
            function () {

                amountInput.value = "";

                loadOutstanding();

            }
        );


        // =========================================================
        // AMOUNT CHANGE
        // =========================================================

        amountInput.addEventListener(
            "input",
            validateAmount
        );


        // =========================================================
        // INITIAL LOAD
        // =========================================================

        if (supplierSelect.value) {

            loadOutstanding();

        }
        else {

            resetOutstanding();

        }

    </script>
}