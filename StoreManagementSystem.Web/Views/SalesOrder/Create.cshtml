@model StoreManagementSystem.Web.ViewModels.SalesOrder.SalesOrderViewModel

@{
    ViewData["Title"] = "Create Sales Order";
    Layout = "_AdminLayout";

    var productList = Model.Items.FirstOrDefault()?.Products
                      ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cart-plus text-primary me-2"></i>
                Create Sales Order
            </h2>
            <small class="text-muted">Create a new sales transaction</small>
        </div>

        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <form asp-action="Create"
          method="post"
          id="salesOrderForm"
          data-price-url="@Url.Action("GetProductPrice", "SalesOrder")">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"
             role="alert"></div>

        <!-- ORDER INFORMATION -->
        <div class="card shadow-sm mb-4">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text me-2"></i>
                    Sales Order Information
                </h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-4">
                        <label asp-for="OrderNumber" class="form-label">
                            Order Number
                        </label>
                        <input asp-for="OrderNumber"
                               class="form-control"
                               readonly />
                    </div>

                    <div class="col-md-4">
                        <label asp-for="OrderDate" class="form-label">
                            Order Date
                        </label>
                        <input asp-for="OrderDate"
                               type="date"
                               class="form-control"
                               required />
                        <span asp-validation-for="OrderDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="WarehouseId" class="form-label">
                            Warehouse
                        </label>
                        <select asp-for="WarehouseId"
                                asp-items="Model.Warehouses"
                                class="form-select"
                                required>
                            <option value="">Select Warehouse</option>
                        </select>
                        <span asp-validation-for="WarehouseId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerName" class="form-label">
                            Customer Name
                        </label>
                        <input asp-for="CustomerName"
                               class="form-control"
                               maxlength="150"
                               placeholder="Enter customer name" />
                        <span asp-validation-for="CustomerName"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="CustomerPhone" class="form-label">
                            Customer Phone
                        </label>
                        <input asp-for="CustomerPhone"
                               class="form-control"
                               maxlength="20"
                               placeholder="Enter customer phone" />
                        <span asp-validation-for="CustomerPhone"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Remarks" class="form-label">
                            Remarks
                        </label>
                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Enter remarks"></textarea>
                        <span asp-validation-for="Remarks"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <!-- PRODUCTS -->
        <div class="card shadow-sm mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="bi bi-box-seam me-2"></i> Products
                </h5>

                <button type="button"
                        class="btn btn-primary btn-sm"
                        id="addProductBtn">
                    <i class="bi bi-plus-circle me-1"></i>
                    Add Product
                </button>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover align-middle mb-0"
                           id="itemTable">

                        <thead class="table-light">
                            <tr>
                                <th style="min-width:240px;">Product Title</th>
                                <th style="min-width:100px;">Qty</th>
                                <th style="min-width:130px;">Cost Price</th>
                                <th style="min-width:130px;">Sale Price</th>
                                <th style="min-width:100px;">Tax %</th>
                                <th style="min-width:110px;">Discount %</th>
                                <th style="min-width:140px;">Total</th>
                                <th style="min-width:140px;">Gross Profit</th>
                                <th style="min-width:75px;">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            @for (var i = 0; i < Model.Items.Count; i++)
                            {
                                <tr class="item-row">
                                    <td>
                                        <select name="Items[@i].ProductId"
                                                class="form-select product-select"
                                                required>
                                            <option value="">Select Product</option>

                                            @foreach (var product in Model.Items[i].Products)
                                            {
                                                if (product.Value == Model.Items[i].ProductId.ToString())
                                                {
                                                    <option value="@product.Value" selected>
                                                        @product.Text
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@product.Value">
                                                        @product.Text
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].Quantity"
                                               class="form-control qty"
                                               value="@Model.Items[i].Quantity"
                                               min="0.01"
                                               step="0.01"
                                               required />
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].UnitPrice"
                                               class="form-control cost-price"
                                               value="@Model.Items[i].UnitPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                               readonly />
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].SalePrice"
                                               class="form-control sale-price"
                                               value="@Model.Items[i].SalePrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
                                               min="0"
                                               step="0.01"
                                               required />
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].TaxPercent"
                                               class="form-control tax-percent"
                                               value="@Model.Items[i].TaxPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               required />
                                    </td>

                                    <td>
                                        <input type="number"
                                               name="Items[@i].DiscountPercent"
                                               class="form-control discount-percent"
                                               value="@Model.Items[i].DiscountPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                                               min="0"
                                               max="100"
                                               step="0.01"
                                               required />
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control line-total"
                                               value="0.00"
                                               readonly />
                                    </td>

                                    <td>
                                        <input type="text"
                                               class="form-control line-profit"
                                               value="0.00"
                                               readonly />
                                    </td>

                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-outline-danger btn-sm delete-row"
                                                aria-label="Remove product"
                                                title="Remove product">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PRODUCT OPTION TEMPLATE FOR NEW ROWS -->
        <template id="productOptionsTemplate">
            <option value="">Select Product</option>
            @foreach (var product in productList)
            {
                <option value="@product.Value">@product.Text</option>
            }
        </template>

        <!-- ORDER SUMMARY -->
        <div class="row justify-content-end">
            <div class="col-md-5 col-lg-4">
                <div class="card shadow-sm">
                    <div class="card-header">
                        <h5 class="mb-0">
                            <i class="bi bi-calculator me-2"></i> Order Summary
                        </h5>
                    </div>

                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-3">
                            <span>Sub Total</span>
                            <strong id="subTotalDisplay">₹0.00</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Discount</span>
                            <strong id="discountDisplay">₹0.00</strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span>Tax</span>
                            <strong id="taxDisplay">₹0.00</strong>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between mb-3">
                            <strong>Grand Total</strong>
                            <strong id="grandTotalDisplay" class="fs-5">
                                ₹0.00
                            </strong>
                        </div>

                        <div class="d-flex justify-content-between">
                            <strong class="text-success">Gross Profit</strong>
                            <strong id="grossProfitDisplay" class="fs-5 text-success">
                                ₹0.00
                            </strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SUMMARY VALUES -->
        <input asp-for="SubTotal" type="hidden" id="SubTotal" />
        <input asp-for="DiscountAmount" type="hidden" id="DiscountAmount" />
        <input asp-for="TaxAmount" type="hidden" id="TaxAmount" />
        <input asp-for="GrandTotal" type="hidden" id="GrandTotal" />
        <input asp-for="GrossProfit" type="hidden" id="GrossProfit" />

        <!-- ACTIONS -->
        <div class="mt-4 mb-4 d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

            <button type="submit" class="btn btn-success">
                <i class="bi bi-check-circle me-1"></i>
                Save Sales Order
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/sales-order-create.js"
            asp-append-version="true"
            defer></script>
}