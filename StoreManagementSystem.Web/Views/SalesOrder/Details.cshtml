@model StoreManagementSystem.Domain.Entities.SalesOrder

@using StoreManagementSystem.Domain.Enums

@{
    ViewData["Title"] = "Sales Order Details";
    Layout = "_AdminLayout";

    var isDraft =
        Model.Status == SalesOrderStatus.Draft;

    var isConfirmed =
        Model.Status == SalesOrderStatus.Confirmed;

    var isCancelled =
        Model.Status == SalesOrderStatus.Cancelled;

    var statusClass =
        Model.Status switch
        {
            SalesOrderStatus.Draft => "bg-warning text-dark",
            SalesOrderStatus.Confirmed => "bg-success",
            SalesOrderStatus.Cancelled => "bg-danger",
            _ => "bg-secondary"
        };
}

<div class="container-fluid">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1">
                <i class="bi bi-receipt text-primary me-2"></i>
                Sales Order Details
            </h2>

            <small class="text-muted">
                @Model.OrderNumber
            </small>

        </div>

        <div class="d-flex gap-2">

            @if (isDraft)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-outline-primary">

                    <i class="bi bi-pencil me-1"></i>
                    Edit

                </a>
            }

            <a asp-action="Index"
               class="btn btn-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back

            </a>

        </div>

    </div>


    <!-- =========================================================
         DRAFT ACTIONS
         ========================================================= -->
    @if (isDraft)
    {
        <div class="alert alert-warning d-flex align-items-center justify-content-between shadow-sm mb-4">

            <div>

                <div class="fw-semibold">

                    <i class="bi bi-exclamation-circle me-2"></i>

                    This Sales Order is still in Draft status.

                </div>

                <div class="small mt-1">

                    Confirm the sale to include it in Net Sales
                    and Gross Profit Analytics.

                </div>

            </div>

            <div class="d-flex gap-2">

                <!-- CONFIRM SALE -->

                <form asp-action="Confirm"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to confirm this sale? Once confirmed, it cannot be edited or deleted.');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-success">

                        <i class="bi bi-check-circle me-1"></i>
                        Confirm Sale

                    </button>

                </form>


                <!-- CANCEL SALE -->

                <form asp-action="Cancel"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="d-inline"
                      onsubmit="return confirm('Are you sure you want to cancel this Sales Order?');">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-outline-danger">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel Sale

                    </button>

                </form>

            </div>

        </div>
    }


    <!-- =========================================================
         CONFIRMED MESSAGE
         ========================================================= -->
    @if (isConfirmed)
    {
        <div class="alert alert-success shadow-sm mb-4">

            <i class="bi bi-check-circle-fill me-2"></i>

            <strong>Sale Confirmed.</strong>

            This sale is included in Net Sales, COGS and Gross Profit
            Analytics.

        </div>
    }


    <!-- =========================================================
         CANCELLED MESSAGE
         ========================================================= -->
    @if (isCancelled)
    {
        <div class="alert alert-danger shadow-sm mb-4">

            <i class="bi bi-x-circle-fill me-2"></i>

            <strong>Sale Cancelled.</strong>

            This sale is not included in Net Sales or Gross Profit
            Analytics.

        </div>
    }


    <!-- =========================================================
         ORDER INFORMATION
         ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-info-circle me-2"></i>

                Order Information

            </h5>

        </div>

        <div class="card-body">

            <div class="row g-4">

                <!-- ORDER NUMBER -->

                <div class="col-md-3">

                    <div class="text-muted small">
                        Order Number
                    </div>

                    <div class="fw-semibold">
                        @Model.OrderNumber
                    </div>

                </div>


                <!-- ORDER DATE -->

                <div class="col-md-3">

                    <div class="text-muted small">
                        Order Date
                    </div>

                    <div class="fw-semibold">
                        @Model.OrderDate.ToString("dd-MM-yyyy")
                    </div>

                </div>


                <!-- WAREHOUSE -->

                <div class="col-md-3">

                    <div class="text-muted small">
                        Warehouse
                    </div>

                    <div class="fw-semibold">

                        @(Model.Warehouse?.Name ?? "N/A")

                    </div>

                </div>


                <!-- STATUS -->

                <div class="col-md-3">

                    <div class="text-muted small">
                        Status
                    </div>

                    <span class="badge @statusClass">

                        @Model.Status

                    </span>

                </div>


                <!-- CUSTOMER -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Customer
                    </div>

                    <div class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.CustomerName)
                                                ? "Walk-in Customer"
                                                : Model.CustomerName)

                    </div>

                </div>


                <!-- PHONE -->

                <div class="col-md-6">

                    <div class="text-muted small">
                        Phone
                    </div>

                    <div class="fw-semibold">

                        @(string.IsNullOrWhiteSpace(Model.CustomerPhone)
                                                ? "-"
                                                : Model.CustomerPhone)

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PRODUCTS
         ========================================================= -->

    <div class="card shadow-sm mb-4">

        <div class="card-header">

            <h5 class="mb-0">

                <i class="bi bi-box-seam me-2"></i>

                Products

            </h5>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <!-- PRODUCT = SKU -->

                            <th>
                                Product
                            </th>

                            <th class="text-end">
                                Qty
                            </th>

                            <th class="text-end">
                                Cost Price
                            </th>

                            <th class="text-end">
                                Sale Price
                            </th>

                            <th class="text-end">
                                Discount
                            </th>

                            <th class="text-end">
                                Tax
                            </th>

                            <th class="text-end">
                                Total
                            </th>

                            <th class="text-end">
                                Gross Profit
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.SalesOrderItems != null &&
                                                Model.SalesOrderItems.Any())
                        {
                            foreach (var item in Model.SalesOrderItems)
                            {
                                var productSku =
                                item.Product?.SKU ?? "N/A";

                                <tr>

                                    <!-- PRODUCT / SKU -->

                                    <td class="fw-semibold">

                                        @productSku

                                    </td>


                                    <!-- QUANTITY -->

                                    <td class="text-end">

                                        @item.Quantity.ToString("0.##")

                                    </td>


                                    <!-- COST PRICE -->

                                    <td class="text-end">

                                        ₹@item.UnitPrice.ToString("N2")

                                    </td>


                                    <!-- SALE PRICE -->

                                    <td class="text-end">

                                        ₹@item.SalePrice.ToString("N2")

                                    </td>


                                    <!-- DISCOUNT -->

                                    <td class="text-end">

                                        @item.DiscountPercent.ToString("0.##")%

                                    </td>


                                    <!-- TAX -->

                                    <td class="text-end">

                                        @item.TaxPercent.ToString("0.##")%

                                    </td>


                                    <!-- TOTAL -->

                                    <td class="text-end fw-semibold">

                                        ₹@item.LineTotal.ToString("N2")

                                    </td>


                                    <!-- GROSS PROFIT -->

                                    <td class="text-end">

                                        @if (item.GrossProfit >= 0)
                                        {
                                            <span class="text-success fw-semibold">

                                                ₹@item.GrossProfit.ToString("N2")

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold">

                                                -₹@Math.Abs(item.GrossProfit).ToString("N2")

                                            </span>
                                        }

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center text-muted py-4">

                                    No products found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- =========================================================
         SUMMARY
         ========================================================= -->

    <div class="row justify-content-end">

        <div class="col-md-5">

            <div class="card shadow-sm">

                <div class="card-header">

                    <h5 class="mb-0">

                        <i class="bi bi-calculator me-2"></i>

                        Sales Summary

                    </h5>

                </div>

                <div class="card-body">

                    <!-- SUB TOTAL -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Sub Total
                        </span>

                        <strong>
                            ₹@Model.SubTotal.ToString("N2")
                        </strong>

                    </div>


                    <!-- DISCOUNT -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Discount
                        </span>

                        <strong class="text-danger">

                            -₹@Model.DiscountAmount.ToString("N2")

                        </strong>

                    </div>


                    <!-- TAX -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Tax
                        </span>

                        <strong>
                            ₹@Model.TaxAmount.ToString("N2")
                        </strong>

                    </div>


                    <hr />


                    <!-- GRAND TOTAL -->

                    <div class="d-flex justify-content-between mb-3">

                        <strong>
                            Grand Total
                        </strong>

                        <strong class="fs-5">

                            ₹@Model.GrandTotal.ToString("N2")

                        </strong>

                    </div>


                    <!-- GROSS PROFIT -->

                    <div class="d-flex justify-content-between p-3 bg-success-subtle rounded">

                        <div>

                            <strong class="text-success d-block">

                                Gross Profit

                            </strong>

                            <small class="text-muted">

                                Net Sales − Purchase Cost

                            </small>

                        </div>

                        @if (Model.GrossProfit >= 0)
                        {
                            <strong class="text-success fs-5">

                                ₹@Model.GrossProfit.ToString("N2")

                            </strong>
                        }
                        else
                        {
                            <strong class="text-danger fs-5">

                                -₹@Math.Abs(Model.GrossProfit).ToString("N2")

                            </strong>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         REMARKS
         ========================================================= -->
    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <div class="card shadow-sm mt-4">

            <div class="card-header">

                <i class="bi bi-chat-left-text me-2"></i>

                Remarks

            </div>

            <div class="card-body">

                @Model.Remarks

            </div>

        </div>
    }

</div>