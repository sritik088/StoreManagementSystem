@model IEnumerable<StoreManagementSystem.Domain.Entities.SalesOrder>

@using StoreManagementSystem.Domain.Enums

@{
    ViewData["Title"] = "Sales Orders";
    Layout = "_AdminLayout";
}

<div class="card shadow-sm">

    <div class="card-header d-flex justify-content-between align-items-center">

        <h4 class="mb-0">
            Sales Orders
        </h4>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-circle"></i>

            New Sales Order

        </a>

    </div>


    <div class="card-body">

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">

                <i class="bi bi-cart-x display-4 text-muted"></i>

                <h5 class="mt-3">
                    No Sales Orders Found
                </h5>

                <p class="text-muted">
                    Create your first Sales Order.
                </p>

                <a asp-action="Create"
                   class="btn btn-primary">

                    <i class="bi bi-plus-circle me-1"></i>

                    New Sales Order

                </a>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle"
                       id="salesOrderTable">

                    <thead>

                        <tr>

                            <th>Order No</th>

                            <th>Date</th>

                            <th>Customer</th>

                            <th>Status</th>

                            <th class="text-end">
                                Grand Total
                            </th>

                            <th width="220" class="text-center">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr class="@(item.IsDeleted ? "table-danger" : "")">

                                <!-- =====================================================
                                     ORDER NUMBER
                                     ===================================================== -->

                                <td>

                                    <strong class="@(item.IsDeleted ? "text-danger" : "")">

                                        @item.OrderNumber

                                    </strong>

                                </td>


                                <!-- =====================================================
                                     DATE
                                     ===================================================== -->

                                <td>

                                    @item.OrderDate.ToString("dd-MMM-yyyy")

                                </td>


                                <!-- =====================================================
                                     CUSTOMER
                                     ===================================================== -->

                                <td>

                                    @if (!string.IsNullOrWhiteSpace(item.CustomerName))
                                    {
                                        @item.CustomerName
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            Walk-in Customer
                                        </span>
                                    }

                                </td>


                                <!-- =====================================================
                                     STATUS
                                     ===================================================== -->

                                <td>

                                    @if (item.IsDeleted)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-trash me-1"></i>

                                            Deleted

                                        </span>
                                    }
                                    else if (item.Status == SalesOrderStatus.Draft)
                                    {
                                        <span class="badge bg-secondary">

                                            <i class="bi bi-pencil-square me-1"></i>

                                            Draft

                                        </span>
                                    }
                                    else if (item.Status == SalesOrderStatus.Confirmed)
                                    {
                                        <span class="badge bg-success">

                                            <i class="bi bi-check-circle me-1"></i>

                                            Confirmed

                                        </span>
                                    }
                                    else if (item.Status == SalesOrderStatus.Cancelled)
                                    {
                                        <span class="badge bg-danger">

                                            <i class="bi bi-x-circle me-1"></i>

                                            Cancelled

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">

                                            @item.Status

                                        </span>
                                    }

                                </td>


                                <!-- =====================================================
                                     GRAND TOTAL
                                     ===================================================== -->

                                <td class="text-end">

                                    ₹ @item.GrandTotal.ToString("N2")

                                </td>


                                <!-- =====================================================
                                     ACTION
                                     ===================================================== -->

                                <td class="text-center">

                                    <div class="btn-group"
                                         role="group">

                                        @if (item.IsDeleted)
                                        {
                                            <!-- =================================================
                                                 VIEW DELETED ORDER
                                                 ================================================= -->

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="View Deleted Sales Order">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- =================================================
                                                 RESTORE
                                                 ================================================= -->

                                            <form asp-action="Restore"
                                                  asp-route-id="@item.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirmSalesOrderRestore('@item.OrderNumber');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-success btn-sm"
                                                        title="Restore Sales Order">

                                                    <i class="bi bi-arrow-counterclockwise"></i>

                                                </button>

                                            </form>
                                        }
                                        else
                                        {
                                            <!-- =================================================
                                                 VIEW
                                                 ================================================= -->

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-info btn-sm"
                                               title="View">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- =================================================
                                                 EDIT
                                                 ONLY DRAFT ORDERS
                                                 ================================================= -->
                                            @if (item.Status == SalesOrderStatus.Draft)
                                            {
                                                <a asp-action="Edit"
                                                   asp-route-id="@item.Id"
                                                   class="btn btn-warning btn-sm"
                                                   title="Edit">

                                                    <i class="bi bi-pencil"></i>

                                                </a>
                                            }


                                            <!-- =================================================
                                                 DELETE
                                                 ONLY DRAFT ORDERS
                                                 ================================================= -->
                                            @if (item.Status == SalesOrderStatus.Draft)
                                            {
                                                <form asp-action="Delete"
                                                      asp-route-id="@item.Id"
                                                      method="post"
                                                      class="d-inline"
                                                      onsubmit="return confirmSalesOrderDelete('@item.OrderNumber');">

                                                    @Html.AntiForgeryToken()

                                                    <button type="submit"
                                                            class="btn btn-danger btn-sm"
                                                            title="Delete Sales Order">

                                                        <i class="bi bi-trash"></i>

                                                    </button>

                                                </form>
                                            }

                                        }

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>


@section Scripts {

    <script>

        $(function () {

            $("#salesOrderTable").DataTable({

                responsive: true,

                pageLength: 10,

                order: [[1, "desc"]]

            });

        });


        // =========================================================
        // DELETE CONFIRMATION
        // =========================================================

        function confirmSalesOrderDelete(orderNumber)
        {
            return confirm(
                "Delete Sales Order " +
                orderNumber +
                "?\n\n" +

                "The Sales Order will not be permanently removed.\n" +

                "It will be marked as Deleted and can be restored later.\n\n" +

                "Do you want to continue?"
            );
        }


        // =========================================================
        // RESTORE CONFIRMATION
        // =========================================================

        function confirmSalesOrderRestore(orderNumber)
        {
            return confirm(
                "Restore Sales Order " +
                orderNumber +
                "?\n\n" +

                "The Sales Order will become active again.\n\n" +

                "Do you want to continue?"
            );
        }

    </script>

}