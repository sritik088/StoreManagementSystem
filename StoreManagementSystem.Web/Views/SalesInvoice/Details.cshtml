
@model StoreManagementSystem.Web.ViewModels.Sales.SalesInvoiceDetailsViewModel

@{
    ViewData["Title"] = "Sales Invoice Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <h3 class="fw-bold mb-1">Sales Invoice</h3>
            <div class="text-muted">@Model.InvoiceNumber</div>
        </div>

        <div class="d-flex gap-2">
            <a asp-action="Print"
               asp-route-id="@Model.Id"
               target="_blank"
               rel="noopener noreferrer"
               class="btn btn-dark">
                <i class="bi bi-printer me-1"></i> Print
            </a>

            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <!-- Notifications -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Invoice Information -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-semibold mb-0">
                <i class="bi bi-receipt me-2 text-primary"></i>
                Invoice Information
            </h5>
        </div>

        <div class="card-body">
            <div class="row g-4">

                <div class="col-6 col-md-3">
                    <div class="text-muted small">Invoice Number</div>
                    <div class="fw-bold">@Model.InvoiceNumber</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="text-muted small">Invoice Date</div>
                    <div class="fw-semibold">@Model.InvoiceDate.ToString("dd-MM-yyyy")</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="text-muted small">Sales Order</div>
                    <div class="fw-semibold">@Model.SalesOrderNumber</div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="text-muted small">Warehouse</div>
                    <div class="fw-semibold">@Model.WarehouseName</div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="text-muted small">Customer</div>
                    <div class="fw-semibold">@Model.CustomerName</div>
                    @if (!string.IsNullOrWhiteSpace(Model.CustomerPhone))
                    {
                        <div class="text-muted">@Model.CustomerPhone</div>
                    }
                </div>

                <div class="col-6 col-md-3">
                    <div class="text-muted small">Payment Mode</div>
                    <div class="fw-semibold">
                        @(string.IsNullOrWhiteSpace(Model.PaymentMode) ? "N/A" : Model.PaymentMode)
                    </div>
                </div>

                <div class="col-6 col-md-3">
                    <div class="text-muted small mb-1">Invoice Status</div>

                    @if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success">Paid</span>
                    }
                    else if (Model.Status == "PartiallyPaid")
                    {
                        <span class="badge bg-warning text-dark">Partially Paid</span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger">Cancelled</span>
                    }
                    else
                    {
                        <span class="badge bg-primary">Issued</span>
                    }
                </div>

            </div>
        </div>
    </div>

    <!-- Invoice Items -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white py-3">
            <h5 class="fw-semibold mb-0">
                <i class="bi bi-box-seam me-2 text-primary"></i>
                Invoice Items
            </h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">#</th>
                            <th>Product Title</th>
                            <th>SKU</th>
                            <th class="text-end">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount %</th>
                            <th class="text-end">Tax %</th>
                            <th class="text-end">Line Total</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Items != null && Model.Items.Any())
                        {
                            var counter = 1;

                            foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="text-center">@counter</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td>@(string.IsNullOrWhiteSpace(item.SKU) ? "—" : item.SKU)</td>
                                    <td class="text-end">@item.Quantity.ToString("N2")</td>
                                    <td class="text-end">₹@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-end">@item.DiscountPercent.ToString("N2")%</td>
                                    <td class="text-end">@item.TaxPercent.ToString("N2")%</td>
                                    <td class="text-end fw-semibold">₹@item.LineTotal.ToString("N2")</td>
                                </tr>

                                counter++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">
                                    No invoice items found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Invoice Totals -->
    <div class="row justify-content-end">
        <div class="col-md-6 col-lg-5 col-xl-4">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h5 class="fw-semibold mb-0">Invoice Summary</h5>
                </div>

                <div class="card-body">
                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Subtotal</span>
                        <strong>₹@Model.SubTotal.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Discount</span>
                        <strong>₹@Model.DiscountAmount.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Tax</span>
                        <strong>₹@Model.TaxAmount.ToString("N2")</strong>
                    </div>

                    <hr />

                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="fw-bold">Grand Total</span>
                        <strong class="fs-5 text-success">
                            ₹@Model.GrandTotal.ToString("N2")
                        </strong>
                    </div>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Paid</span>
                        <strong class="text-success">₹@Model.PaidAmount.ToString("N2")</strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Balance Due</span>
                        <strong class="text-danger">₹@Model.BalanceDue.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cancel Invoice -->
    @if (Model.Status != "Cancelled")
    {
        <div class="mt-4">
            <form asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  data-confirm-message="Are you sure you want to cancel this invoice? Stock will be restored.">

                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-x-circle me-1"></i>
                    Cancel Invoice
                </button>
            </form>
        </div>
    }

</div>

@section Scripts {
    <script src="~/js/sales-invoice-details.js" asp-append-version="true" defer></script>
}
