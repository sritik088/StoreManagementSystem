@model StoreManagementSystem.Web.ViewModels.Sales.SalesInvoiceDetailsViewModel

@{
    ViewData["Title"] = "Sales Invoice Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="fw-bold mb-1">
                Sales Invoice
            </h3>

            <div class="text-muted">
                @Model.InvoiceNumber
            </div>

        </div>


        <div class="d-flex gap-2">

            <a asp-action="Print"
               asp-route-id="@Model.Id"
               target="_blank"
               class="btn btn-dark">

                <i class="bi bi-printer me-1"></i>
                Print

            </a>


            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-body">

            <div class="row g-4">

                <div class="col-md-3">

                    <div class="text-muted small">
                        Invoice Number
                    </div>

                    <div class="fw-bold">
                        @Model.InvoiceNumber
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Invoice Date
                    </div>

                    <div class="fw-semibold">
                        @Model.InvoiceDate.ToString("dd-MM-yyyy")
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Sales Order
                    </div>

                    <div class="fw-semibold">
                        @Model.SalesOrderNumber
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Warehouse
                    </div>

                    <div class="fw-semibold">
                        @Model.WarehouseName
                    </div>

                </div>


                <div class="col-md-6">

                    <div class="text-muted small">
                        Customer
                    </div>

                    <div class="fw-semibold">
                        @Model.CustomerName
                    </div>

                    <div class="text-muted">
                        @Model.CustomerPhone
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Payment Mode
                    </div>

                    <div class="fw-semibold">
                        @Model.PaymentMode
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="text-muted small">
                        Status
                    </div>

                    @if (Model.Status == "Paid")
                    {
                        <span class="badge bg-success">
                            Paid
                        </span>
                    }
                    else if (Model.Status == "PartiallyPaid")
                    {
                        <span class="badge bg-warning text-dark">
                            Partially Paid
                        </span>
                    }
                    else if (Model.Status == "Cancelled")
                    {
                        <span class="badge bg-danger">
                            Cancelled
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-primary">
                            Issued
                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-white">

            <h5 class="mb-0 fw-semibold">
                Invoice Items
            </h5>

        </div>


        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-bordered mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Product</th>
                            <th>SKU</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Discount %</th>
                            <th class="text-end">Tax %</th>
                            <th class="text-end">Total</th>
                        </tr>

                    </thead>


                    <tbody>

                        @{
                            var counter = 1;
                        }

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    @counter
                                </td>

                                <td class="fw-semibold">
                                    @item.ProductName
                                </td>

                                <td>
                                    @item.SKU
                                </td>

                                <td class="text-end">
                                    @item.Quantity.ToString("N2")
                                </td>

                                <td class="text-end">
                                    ₹@item.UnitPrice.ToString("N2")
                                </td>

                                <td class="text-end">
                                    @item.DiscountPercent.ToString("N2")%
                                </td>

                                <td class="text-end">
                                    @item.TaxPercent.ToString("N2")%
                                </td>

                                <td class="text-end fw-semibold">
                                    ₹@item.LineTotal.ToString("N2")
                                </td>

                            </tr>

                            counter++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <div class="row justify-content-end">

        <div class="col-md-5">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Sub Total
                        </span>

                        <strong>
                            ₹@Model.SubTotal.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Discount
                        </span>

                        <strong>
                            ₹@Model.DiscountAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Tax
                        </span>

                        <strong>
                            ₹@Model.TaxAmount.ToString("N2")
                        </strong>

                    </div>


                    <hr />


                    <div class="d-flex justify-content-between fs-5 mb-2">

                        <span class="fw-bold">
                            Grand Total
                        </span>

                        <strong>
                            ₹@Model.GrandTotal.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between text-success">

                        <span>
                            Paid
                        </span>

                        <strong>
                            ₹@Model.PaidAmount.ToString("N2")
                        </strong>

                    </div>


                    <div class="d-flex justify-content-between text-danger">

                        <span>
                            Balance Due
                        </span>

                        <strong>
                            ₹@Model.BalanceDue.ToString("N2")
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    @if (Model.Status != "Cancelled")
    {
        <div class="mt-4">

            <form asp-action="Cancel"
                  asp-route-id="@Model.Id"
                  method="post"
                  onsubmit="return confirm('Are you sure you want to cancel this invoice? Stock will be restored.');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-outline-danger">

                    <i class="bi bi-x-circle me-1"></i>
                    Cancel Invoice

                </button>

            </form>

        </div>
    }

</div>