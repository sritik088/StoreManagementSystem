@model IEnumerable<StoreManagementSystem.Web.ViewModels.Sales.SalesInvoiceIndexViewModel>

@{
    ViewData["Title"] = "Sales Invoices";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">
                <i class="bi bi-receipt-cutoff me-2"></i>
                Sales Invoices
            </h3>

            <div class="text-muted">
                Manage sales invoices generated from Sales Orders.
            </div>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-plus-lg me-1"></i>
            Create Invoice

        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["Error"]
        </div>
    }


    <div class="card border-0 shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle"
                       id="invoiceTable">

                    <thead class="table-dark">

                        <tr>
                            <th>Invoice No.</th>
                            <th>Date</th>
                            <th>Sales Order</th>
                            <th>Customer</th>
                            <th>Warehouse</th>
                            <th class="text-end">Grand Total</th>
                            <th class="text-end">Paid</th>
                            <th class="text-end">Balance</th>
                            <th>Payment</th>
                            <th>Status</th>
                            <th class="text-end">Action</th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td class="fw-semibold">
                                    @item.InvoiceNumber
                                </td>

                                <td>
                                    @item.InvoiceDate.ToString("dd-MM-yyyy")
                                </td>

                                <td>
                                    @item.SalesOrderNumber
                                </td>

                                <td>
                                    @item.CustomerName
                                </td>

                                <td>
                                    @item.WarehouseName
                                </td>

                                <td class="text-end fw-semibold">
                                    ₹@item.GrandTotal.ToString("N2")
                                </td>

                                <td class="text-end text-success">
                                    ₹@item.PaidAmount.ToString("N2")
                                </td>

                                <td class="text-end text-danger">
                                    ₹@item.BalanceDue.ToString("N2")
                                </td>

                                <td>
                                    @item.PaymentMode
                                </td>

                                <td>

                                    @if (item.Status == "Paid")
                                    {
                                        <span class="badge bg-success">
                                            Paid
                                        </span>
                                    }
                                    else if (item.Status == "PartiallyPaid")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Partially Paid
                                        </span>
                                    }
                                    else if (item.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">
                                            Cancelled
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">
                                            Issued
                                        </span>
                                    }

                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-primary">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Print"
                                       asp-route-id="@item.Id"
                                       target="_blank"
                                       class="btn btn-sm btn-outline-dark">

                                        <i class="bi bi-printer"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        $(document).ready(function () {

            $('#invoiceTable').DataTable({
                pageLength: 25,
                order: [[1, 'desc']]
            });

        });
    </script>
}