@model StoreManagementSystem.Web.ViewModels.Sales.SalesInvoiceDetailsViewModel

@{
    ViewData["Title"] = "Print Sales Invoice";
    Layout = null;
}

<!DOCTYPE html>

<html>

<head>

    <meta charset="utf-8" />

    <title>
        @Model.InvoiceNumber
    </title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>

        body {
            background: #fff;
            font-family: Arial, sans-serif;
            color: #222;
        }

        .invoice-container {
            max-width: 950px;
            margin: 30px auto;
        }

        .invoice-header {
            border-bottom: 2px solid #222;
            padding-bottom: 15px;
            margin-bottom: 20px;
        }

        .invoice-title {
            font-size: 30px;
            font-weight: 700;
        }

        .table th {
            background: #f3f4f6 !important;
        }

        .total-box {
            width: 350px;
            margin-left: auto;
        }

        .grand-total {
            font-size: 20px;
            font-weight: 700;
        }

        @@media print {

            .no-print {
                display: none !important;
            }

            .invoice-container {
                margin: 0;
                max-width: 100%;
            }

            body {
                font-size: 12px;
            }
        }
    </style>

</head>


<body>

    <div class="invoice-container">

        <div class="d-flex justify-content-end no-print mb-3">

            <button onclick="window.print()"
                    class="btn btn-dark">

                Print Invoice

            </button>

        </div>


        <div class="invoice-header">

            <div class="row">

                <div class="col-7">

                    <h1 class="fw-bold mb-1">
                        SALES INVOICE
                    </h1>

                    <div>
                        Invoice:
                        <strong>
                            @Model.InvoiceNumber
                        </strong>
                    </div>

                    <div>
                        Sales Order:
                        <strong>
                            @Model.SalesOrderNumber
                        </strong>
                    </div>

                </div>


                <div class="col-5 text-end">

                    <div>
                        <strong>
                            Invoice Date
                        </strong>
                    </div>

                    <div>
                        @Model.InvoiceDate.ToString("dd-MM-yyyy")
                    </div>

                    <div class="mt-2">

                        <strong>
                            Warehouse
                        </strong>

                    </div>

                    <div>
                        @Model.WarehouseName
                    </div>

                </div>

            </div>

        </div>


        <div class="row mb-4">

            <div class="col-6">

                <h6 class="fw-bold">
                    BILL TO
                </h6>

                <div class="fw-semibold">
                    @Model.CustomerName
                </div>

                <div>
                    @Model.CustomerPhone
                </div>

            </div>


            <div class="col-6 text-end">

                <h6 class="fw-bold">
                    PAYMENT
                </h6>

                <div>
                    Mode:
                    @Model.PaymentMode
                </div>

                <div>
                    Status:
                    @Model.Status
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.PaymentReference) &&
                                Model.PaymentReference != "-")
                {
                    <div>
                        Reference:
                        @Model.PaymentReference
                    </div>
                }

            </div>

        </div>


        <table class="table table-bordered align-middle">

            <thead>

                <tr>

                    <th style="width:50px;">
                        #
                    </th>

                    <th>
                        Product
                    </th>

                    <th>
                        SKU
                    </th>

                    <th class="text-end">
                        Qty
                    </th>

                    <th class="text-end">
                        Rate
                    </th>

                    <th class="text-end">
                        Discount
                    </th>

                    <th class="text-end">
                        Tax
                    </th>

                    <th class="text-end">
                        Amount
                    </th>

                </tr>

            </thead>


            <tbody>

                @{
                    var counter = 1;
                }

                @foreach (var item in Model.Items)
                {
                    <tr>

                        <td>
                            @counter
                        </td>

                        <td>
                            @item.ProductName
                        </td>

                        <td>
                            @item.SKU
                        </td>

                        <td class="text-end">
                            @item.Quantity.ToString("N2")
                        </td>

                        <td class="text-end">
                            ₹@item.UnitPrice.ToString("N2")
                        </td>

                        <td class="text-end">
                            @item.DiscountPercent.ToString("N2")%
                        </td>

                        <td class="text-end">
                            @item.TaxPercent.ToString("N2")%
                        </td>

                        <td class="text-end">
                            ₹@item.LineTotal.ToString("N2")
                        </td>

                    </tr>

                    counter++;
                }

            </tbody>

        </table>


        <div class="total-box">

            <table class="table table-sm">

                <tr>

                    <td>
                        Sub Total
                    </td>

                    <td class="text-end">
                        ₹@Model.SubTotal.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <td>
                        Discount
                    </td>

                    <td class="text-end">
                        ₹@Model.DiscountAmount.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <td>
                        Tax
                    </td>

                    <td class="text-end">
                        ₹@Model.TaxAmount.ToString("N2")
                    </td>

                </tr>


                <tr class="border-top">

                    <td class="grand-total">
                        Grand Total
                    </td>

                    <td class="text-end grand-total">
                        ₹@Model.GrandTotal.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <td>
                        Paid
                    </td>

                    <td class="text-end">
                        ₹@Model.PaidAmount.ToString("N2")
                    </td>

                </tr>


                <tr>

                    <td>
                        Balance Due
                    </td>

                    <td class="text-end">
                        ₹@Model.BalanceDue.ToString("N2")
                    </td>

                </tr>

            </table>

        </div>


        @if (!string.IsNullOrWhiteSpace(Model.Remarks))
        {
            <div class="mt-4">

                <strong>
                    Remarks:
                </strong>

                <div>
                    @Model.Remarks
                </div>

            </div>
        }


        <div class="row mt-5">

            <div class="col-6">

                <div>
                    Customer Signature
                </div>

                <div class="mt-5 border-top"
                     style="width:200px;">
                </div>

            </div>


            <div class="col-6 text-end">

                <div>
                    Authorized Signature
                </div>

                <div class="mt-5 border-top ms-auto"
                     style="width:200px;">
                </div>

            </div>

        </div>


        <div class="text-center text-muted mt-5">

            Thank you for your business.

        </div>

    </div>

</body>

</html>